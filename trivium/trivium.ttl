trv:www-semantico a trv:Programma ; skos:inScheme trv:programmi ; skos:notation "www-semantico" ; trv:identificativoCategoria 25 ;
    skos:prefLabel "Grande Rete Semantica Mondiale"@it, "World-wide semantic web"@en, "Rete semantica universalis"@la ;
    rdfs:label "Grande Rete Semantica Mondiale"@it, "World-wide semantic web"@en, "Rete semantica universalis"@la ;
    dcterms:source <https://criptasemantica.it/www-semantico/> ;
    skos:topConceptOf trv:programmi ;
    skos:scopeNote "Il World Wide Web, la Grande Rete Mondiale, come iperbiblioteca volta all'immagazzinamento e alla socializzazione del capitale semantico umano e meccanico."@it, "The World Wide Web, the great world-wide network, as a hyper-library devoted to storing and socialising human and machine semantic capital."@en, "Rete universalis, Magna Rete Mundana, ut hyperbibliotheca ad capitale semanticum humanum et machinale condendum et communicandum."@la ;
    skos:broadMatch mtr:ford-1-2 ;
    skos:related dub:web, dub:capitaleSemantico .
