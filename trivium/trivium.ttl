trv:metafisica-gioco a trv:Programma ; skos:inScheme trv:programmi ; skos:notation "metafisica-gioco" ; trv:identificativoCategoria 27 ;
    skos:prefLabel "Metafisica del Gioco"@it, "Metaphysics of play"@en, "Metaphysica ludi"@la ;
    rdfs:label "Metafisica del Gioco"@it, "Metaphysics of play"@en, "Metaphysica ludi"@la ;
    dcterms:source <https://criptasemantica.it/metafisica-gioco/> ;
    skos:topConceptOf trv:programmi ;
    skos:scopeNote "\"Gioco si dà anche, anzi si dà proprio, là dove non c'è un orizzonte tematicamente definito dal per sé di una soggettività, e dove non ci sono soggetti che si atteggiano ludicamente.\""@it, "\"Play is given also, indeed precisely, where there is no horizon thematically defined by the for-itself of a subjectivity, and where there are no subjects behaving playfully.\""@en, "\"Ludus datur etiam, immo praecipue, ubi nullus horizon a 'pro se' subiectivitatis thematice definitur, et ubi nulla subiecta ludice se gerunt.\""@la ;
    skos:broadMatch mtr:ford-6-3 .
