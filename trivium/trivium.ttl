trv:ontologia-fondamentale a trv:Disciplina ; skos:inScheme trv:discipline ; skos:notation "ontologia-fondamentale" ; trv:identificativoCategoria 22 ;
    skos:prefLabel "Ontologia Fondamentale"@it, "Fundamental ontology"@en, "Ontologia fundamentalis"@la ;
    rdfs:label "Ontologia Fondamentale"@it, "Fundamental ontology"@en, "Ontologia fundamentalis"@la ;
    dcterms:source <https://criptasemantica.it/ontologia-fondamentale/> ;
    skos:topConceptOf trv:discipline ;
    skos:scopeNote "\"Abbiamo noi oggi una risposta alla domanda intorno a ciò che propriamente intendiamo con la parola 'essente'? Per nulla. Dunque è necessario riproporre il problema del senso dell'essere.\""@it, "\"Do we today have an answer to the question of what we properly mean by the word 'being'? Not at all. It is therefore necessary to raise anew the question of the meaning of being.\""@en, "\"Habemusne hodie responsum ad quaestionem quid proprie voce 'ens' intellegamus? Minime. Necesse est igitur quaestionem de sensu essendi iterum ponere.\""@la ;
    skos:broadMatch mtr:ford-6-3 ;
    skos:related dub:ontologiaFondamentale, dub:problemaSensoEssere .
