    {
      "@id": "trv:teatro",
      "@type": "trv:Disciplina",
      "dcterms:source": {
        "@id": "https://criptasemantica.it/teatro/"
      },
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "Teatro"
        },
        {
          "@language": "en",
          "@value": "Theatre"
        },
        {
          "@language": "la",
          "@value": "Theatrum"
        }
      ],
      "skos:broadMatch": {
        "@id": "mtr:ford-6-4"
      },
      "skos:closeMatch": {
        "@id": "wd:Q11635"
      },
      "skos:inScheme": {
        "@id": "trv:discipline"
      },
      "skos:notation": "teatro",
      "skos:prefLabel": [
        {
          "@language": "it",
          "@value": "Teatro"
        },
        {
          "@language": "en",
          "@value": "Theatre"
        },
        {
          "@language": "la",
          "@value": "Theatrum"
        }
      ],
      "skos:scopeNote": [
        {
          "@language": "it",
          "@value": "Il teatro è il luogo della visione, della visione del divino, e l'attore non è che una maschera nuda al cospetto della propria nullità. Con ciò si assegna al teatro, dall'evo classico a quello post-drammatico, lo spazio entro cui si svolgono la formazione e il godimento dei cammini iniziatici."
        },
        {
          "@language": "en",
          "@value": "Theatre is the place of vision, of the vision of the divine, and the actor is nothing but a naked mask before their own nothingness. Theatre, from the classical to the post-dramatic age, is thereby assigned the space in which the formation and enjoyment of initiatory paths unfold."
        },
        {
          "@language": "la",
          "@value": "Theatrum est locus visionis, visionis divini, et histrio nihil est nisi persona nuda coram sua nullitate. Ita theatro, ab aevo classico ad postdramaticum, spatium tribuitur in quo formatio et fruitio itinerum initiationis explicantur."
        }
      ],
      "skos:topConceptOf": {
        "@id": "trv:discipline"
      },
      "trv:identificativoCategoria": 30
    },
