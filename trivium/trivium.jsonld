    {
      "@id": "trv:metafisica-gioco",
      "@type": "trv:Programma",
      "dcterms:source": {
        "@id": "https://criptasemantica.it/metafisica-gioco/"
      },
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "Metafisica del Gioco"
        },
        {
          "@language": "en",
          "@value": "Metaphysics of play"
        },
        {
          "@language": "la",
          "@value": "Metaphysica ludi"
        }
      ],
      "skos:broadMatch": {
        "@id": "mtr:ford-6-3"
      },
      "skos:inScheme": {
        "@id": "trv:programmi"
      },
      "skos:notation": "metafisica-gioco",
      "skos:prefLabel": [
        {
          "@language": "it",
          "@value": "Metafisica del Gioco"
        },
        {
          "@language": "en",
          "@value": "Metaphysics of play"
        },
        {
          "@language": "la",
          "@value": "Metaphysica ludi"
        }
      ],
      "skos:scopeNote": [
        {
          "@language": "it",
          "@value": "\"Gioco si dà anche, anzi si dà proprio, là dove non c'è un orizzonte tematicamente definito dal per sé di una soggettività, e dove non ci sono soggetti che si atteggiano ludicamente.\""
        },
        {
          "@language": "en",
          "@value": "\"Play is given also, indeed precisely, where there is no horizon thematically defined by the for-itself of a subjectivity, and where there are no subjects behaving playfully.\""
        },
        {
          "@language": "la",
          "@value": "\"Ludus datur etiam, immo praecipue, ubi nullus horizon a 'pro se' subiectivitatis thematice definitur, et ubi nulla subiecta ludice se gerunt.\""
        }
      ],
      "skos:topConceptOf": {
        "@id": "trv:programmi"
      },
      "trv:identificativoCategoria": 27
    },
