      ],
      "skos:related": [
        {
          "@id": "dub:ontologiaFondamentale"
        },
        {
          "@id": "dub:problemaSensoEssere"
        }
      ],
      "skos:scopeNote": [
        {
          "@language": "it",
          "@value": "\"Abbiamo noi oggi una risposta alla domanda intorno a ciò che propriamente intendiamo con la parola 'essente'? Per nulla. Dunque è necessario riproporre il problema del senso dell'essere.\""
        },
        {
          "@language": "en",
          "@value": "\"Do we today have an answer to the question of what we properly mean by the word 'being'? Not at all. It is therefore necessary to raise anew the question of the meaning of being.\""
        },
        {
          "@language": "la",
          "@value": "\"Habemusne hodie responsum ad quaestionem quid proprie voce 'ens' intellegamus? Minime. Necesse est igitur quaestionem de sensu essendi iterum ponere.\""
        }
      ],
      "skos:topConceptOf": {
        "@id": "trv:discipline"
      },
      "trv:identificativoCategoria": 22
    },
