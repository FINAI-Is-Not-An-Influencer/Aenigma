      ],
      "skos:related": [
        {
          "@id": "dub:codiceSviluppo"
        },
        {
          "@id": "dub:iperscritturaConsapevole"
        }
      ],
      "skos:scopeNote": [
        {
          "@language": "it",
          "@value": "La programmazione letteraria permette di accordare il flusso di codifica con quello di coscienza, e offre opportunità inedite nell'epoca degli ipertesti: è possibile spingere per l'evoluzione di desso paradigma verso una programmazione filosofica?"
        },
        {
          "@language": "en",
          "@value": "Literate programming lets the flow of coding be tuned to the flow of consciousness and offers unprecedented opportunities in the age of hypertexts: can that paradigm be pushed to evolve towards a philosophical programming?"
        },
        {
          "@language": "la",
          "@value": "Programmatio litterata fluxum codificandi cum fluxu conscientiae concordare sinit et in aetate hypertextuum occasiones novas praebet: potestne illud paradigma ad programmationem philosophicam evolvi?"
        }
      ],
      "skos:topConceptOf": {
        "@id": "trv:programmi"
      },
      "trv:identificativoCategoria": 24
    },
