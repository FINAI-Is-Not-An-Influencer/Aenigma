      "skos:related": {
        "@id": "trv:canali"
      },
      "skos:scopeNote": [
        {
          "@language": "it",
          "@value": "Portuno e le Naiadi governano un labirinto ricorsivo che allude alla teoria dell'informazione: i canali fisici che trasportano i dati dell'iperscrittura."
        },
        {
          "@language": "en",
          "@value": "Portunus and the Naiads rule a recursive labyrinth that alludes to information theory: the physical channels that carry the data of hyperwriting."
        },
        {
          "@language": "la",
          "@value": "Portunus et Naiades labyrinthum recursivum regunt qui theoriam informationis significat: canales physici qui data hyperscripturae vehunt."
        }
      ],
      "skos:topConceptOf": {
        "@id": "trv:stanze"
      }
    },
