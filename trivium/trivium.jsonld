    {
      "@id": "trv:",
      "@type": "owl:Ontology",
      "dcterms:creator": [
        {
          "@id": "https://criptasemantica.it/chi-siamo/finai/"
        },
        {
          "@id": "https://criptasemantica.it/chi-siamo/alessandro-sevardi/"
        }
      ],
      "dcterms:description": [
        {
          "@language": "it",
          "@value": "Il nome riprende il trivio delle arti liberali: grammatica, dialettica e retorica sono le tre categorie fondanti del sito, affiancate da un quadrivio in cui la geografia prende il posto della geometria. Le altre categorie sono rami di questi tronchi o sezioni del lavoro editoriale."
        },
        {
          "@language": "en",
          "@value": "The name recalls the trivium of the liberal arts: grammar, dialectic and rhetoric are the three founding categories of the site, flanked by a quadrivium in which geography takes the place of geometry. The other categories are branches of these trunks or sections of the editorial work."
        },
        {
          "@language": "la",
          "@value": "Nomen trivium artium liberalium resumit: grammatica, dialectica et rhetorica tres categoriae situs fundamentales sunt, quibus quadrivium adiungitur in quo geographia locum geometriae tenet. Ceterae categoriae rami horum truncorum vel partes operis editorii sunt."
        }
      ],
      "dcterms:isPartOf": {
        "@id": "https://aenigma.criptasemantica.it/aenigma#"
      },
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-11-11"
      },
      "dcterms:language": [
        "it",
        "en",
        "la"
      ],
      "dcterms:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-11-11"
      },
      "dcterms:publisher": {
        "@id": "https://criptasemantica.it/"
      },
      "dcterms:source": {
        "@id": "https://criptasemantica.it/wp-json/wp/v2/categories"
      },
      "dcterms:title": [
        {
          "@language": "it",
          "@value": "Trivium. Le arti e le discipline della Cripta Semantica"
        },
        {
          "@language": "en",
          "@value": "Trivium. The arts and disciplines of the Cripta Semantica"
        },
        {
          "@language": "la",
          "@value": "Trivium. Artes et disciplinae Cryptae Semanticae"
        }
      ],
      "owl:versionIRI": {
        "@id": "trv:v0.1.0"
      },
      "owl:versionInfo": "0.1.0",
      "rdfs:comment": [
        {
          "@language": "it",
          "@value": "Secondo modulo di Aenigma. Schemi SKOS delle discipline, dei generi editoriali, delle linee di programma e delle stanze del sito, con etichette in tre lingue, descrizioni d'autore, corrispondenze Wikidata verificate e ponti verso le discipline FORD e verso Dubium."
        },
        {
          "@language": "en",
          "@value": "Second module of Aenigma. SKOS schemes of the disciplines, editorial genres, programme lines and rooms of the site, with labels in three languages, the author's descriptions, verified Wikidata correspondences and bridges to the FORD fields and to Dubium."
        },
        {
          "@language": "la",
          "@value": "Secunda pars Aenigmatis. Schemata SKOS disciplinarum, generum editoriorum, linearum consilii et cellarum situs, cum titulis trium linguarum, descriptionibus auctoris, consensionibus Wikidata probatis et pontibus ad disciplinas FORD et ad Dubium."
        }
      ],
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "Trivium. Le arti e le discipline della Cripta Semantica"
        },
        {
          "@language": "en",
