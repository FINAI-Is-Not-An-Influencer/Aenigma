      "@id": "trv:matematica",
      "@type": "trv:Disciplina",
      "dcterms:source": {
        "@id": "https://criptasemantica.it/matematica/"
      },
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "Matematica"
        },
        {
          "@language": "en",
          "@value": "Mathematics"
        },
        {
          "@language": "la",
          "@value": "Mathematica"
        }
      ],
      "skos:broadMatch": {
        "@id": "mtr:ford-1-1"
      },
      "skos:closeMatch": {
        "@id": "wd:Q395"
      },
      "skos:inScheme": {
        "@id": "trv:discipline"
      },
      "skos:notation": "matematica",
      "skos:prefLabel": [
        {
          "@language": "it",
          "@value": "Matematica"
        },
        {
          "@language": "en",
          "@value": "Mathematics"
        },
        {
          "@language": "la",
          "@value": "Mathematica"
        }
      ],
      "skos:related": {
        "@id": "dub:reminiscenza"
      },
      "skos:scopeNote": [
        {
          "@language": "it",
          "@value": "Arte della reminiscenza attraverso enti che mediano fra il sensibile e l'intelligibile, linguaggio della natura che non crea ed è creata, studio a priori dello spazio e del tempo, o scienza dell'immaginazione e della costruzione dei significati, polo opposto e complementare della metafisica, la matematica è da sempre e ancor oggi la lente che espande e dettaglia il godimento contemplativo."
        },
        {
          "@language": "en",
          "@value": "Art of recollection through beings that mediate between the sensible and the intelligible, language of a nature that does not create and is created, a priori study of space and time, or science of imagination and of the construction of meanings, opposite and complementary pole of metaphysics: mathematics has always been, and still is, the lens that expands and details contemplative enjoyment."
        },
        {
          "@language": "la",
          "@value": "Ars reminiscentiae per entia quae inter sensibile et intellegibile mediant, lingua naturae quae non creat et creatur, studium a priori spatii et temporis, vel scientia imaginationis et constructionis significationum, polus oppositus et complementarius metaphysicae: mathematica semper fuit et adhuc est lens quae fruitionem contemplativam amplificat et distinguit."
        }
      ],
      "skos:topConceptOf": {
        "@id": "trv:discipline"
      },
      "trv:identificativoCategoria": 12
    },
