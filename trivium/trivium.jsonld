    {
      "@id": "trv:grammatica",
      "@type": "trv:Disciplina",
      "dcterms:source": {
        "@id": "https://criptasemantica.it/grammatica/"
      },
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "Grammatica"
        },
        {
          "@language": "en",
          "@value": "Grammar"
        },
        {
          "@language": "la",
          "@value": "Grammatica"
        }
      ],
      "skos:broadMatch": {
        "@id": "mtr:ford-6-2"
      },
      "skos:closeMatch": {
        "@id": "wd:Q8091"
      },
      "skos:inScheme": {
        "@id": "trv:discipline"
      },
      "skos:notation": "grammatica",
      "skos:prefLabel": [
        {
          "@language": "it",
          "@value": "Grammatica"
        },
        {
          "@language": "en",
          "@value": "Grammar"
        },
        {
          "@language": "la",
          "@value": "Grammatica"
        }
      ],
      "skos:related": [
        {
          "@id": "dub:scrittura"
        },
        {
          "@id": "dub:testo"
        }
      ],
      "skos:scopeNote": [
        {
          "@language": "it",
          "@value": "A partire dal vastissimo rizoma ellenistico della grammatikē technē — l'arte totale della lettura, dell'esegesi, della cura dei testi e della comprensione del linguaggio — la categoria \"grammatica\" funziona da attualizzazione del campo della \"lettera\", proiettato nell'orizzonte cognitivo e tecnologico del nostro tempo. Grammatica è dunque il grembo sintetico di tutte le branche fiorite da quell'antico slancio verso la decodifica del mondo, la disciplina che eleva a scienza scritture e archiscritture, testi e ipertesti, lingue e linguaggi, tipi e caratteri, segni e comunicazioni."
        },
        {
          "@language": "en",
          "@value": "Starting from the vast Hellenistic rhizome of the grammatikē technē, the total art of reading, exegesis, care of texts and understanding of language, the category 'grammar' actualises the field of the 'letter', projected onto the cognitive and technological horizon of our time. Grammar is thus the synthetic womb of all the branches that flowered from that ancient drive to decode the world: the discipline that raises to science writings and arche-writings, texts and hypertexts, tongues and languages, types and characters, signs and communications."
        },
        {
          "@language": "la",
          "@value": "A vastissimo rhizomate Hellenistico artis grammaticae, artis totius legendi, interpretandi, textus curandi et sermonem intellegendi, categoria 'grammatica' campum 'litterae' in horizonte cognitivo et technologico aetatis nostrae renovat. Grammatica igitur est sinus syntheticus omnium ramorum ex illo antiquo impetu mundum decodificandi natorum: disciplina quae scripturas et archiscripturas, textus et hypertextus, linguas et sermones, typos et characteres, signa et communicationes ad scientiam evehit."
        }
      ],
      "skos:topConceptOf": {
        "@id": "trv:discipline"
      },
      "trv:identificativoCategoria": 10
    },
