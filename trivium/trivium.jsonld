      "skos:scopeNote": [
        {
          "@language": "it",
          "@value": "Vulcano forgia artefatti nell'officina-cripta: la stanza da cui si raggiunge la rete degli articoli, intesi come articolazioni di un'apertura di senso."
        },
        {
          "@language": "en",
          "@value": "Vulcan forges artefacts in the crypt-workshop: the room from which the network of articles is reached, understood as articulations of an opening of sense."
        },
        {
          "@language": "la",
          "@value": "Vulcanus artefacta in officina-crypta cudit: cella unde rete articulorum attingitur, qui ut articulationes aperturae sensus intelleguntur."
        }
      ],
      "skos:topConceptOf": {
        "@id": "trv:stanze"
      }
