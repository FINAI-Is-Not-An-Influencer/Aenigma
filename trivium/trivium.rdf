  <skos:Collection rdf:about="https://aenigma.criptasemantica.it/trivium#quadrivio">
    <skos:prefLabel xml:lang="it">Quadrivio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Quadrivium</skos:prefLabel>
    <skos:prefLabel xml:lang="la">Quadrivium</skos:prefLabel>
