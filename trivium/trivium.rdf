        <rdfs:label xml:lang="en">Metaphysics of play</rdfs:label>
        <rdfs:label xml:lang="la">Metaphysica ludi</rdfs:label>
        <dcterms:source rdf:resource="https://criptasemantica.it/metafisica-gioco/"/>
        <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/trivium#programmi"/>
        <skos:scopeNote xml:lang="it">"Gioco si dà anche, anzi si dà proprio, là dove non c'è un orizzonte tematicamente definito dal per sé di una soggettività, e dove non ci sono soggetti che si atteggiano ludicamente."</skos:scopeNote>
        <skos:scopeNote xml:lang="en">"Play is given also, indeed precisely, where there is no horizon thematically defined by the for-itself of a subjectivity, and where there are no subjects behaving playfully."</skos:scopeNote>
        <skos:scopeNote xml:lang="la">"Ludus datur etiam, immo praecipue, ubi nullus horizon a 'pro se' subiectivitatis thematice definitur, et ubi nulla subiecta ludice se gerunt."</skos:scopeNote>
        <skos:broadMatch rdf:resource="https://aenigma.criptasemantica.it/metrum#ford-6-3"/>
      </trv:Programma>
    </skos:broader>
  </trv:Programma>
