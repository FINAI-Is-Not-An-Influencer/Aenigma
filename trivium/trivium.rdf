  <trv:Disciplina rdf:about="https://aenigma.criptasemantica.it/trivium#ontologia-fondamentale">
    <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/trivium#discipline"/>
    <skos:notation>ontologia-fondamentale</skos:notation>
    <trv:identificativoCategoria rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</trv:identificativoCategoria>
    <skos:prefLabel xml:lang="it">Ontologia Fondamentale</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Fundamental ontology</skos:prefLabel>
    <skos:prefLabel xml:lang="la">Ontologia fundamentalis</skos:prefLabel>
    <rdfs:label xml:lang="it">Ontologia Fondamentale</rdfs:label>
    <rdfs:label xml:lang="en">Fundamental ontology</rdfs:label>
    <rdfs:label xml:lang="la">Ontologia fundamentalis</rdfs:label>
    <dcterms:source rdf:resource="https://criptasemantica.it/ontologia-fondamentale/"/>
    <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/trivium#discipline"/>
    <skos:scopeNote xml:lang="it">"Abbiamo noi oggi una risposta alla domanda intorno a ciò che propriamente intendiamo con la parola 'essente'? Per nulla. Dunque è necessario riproporre il problema del senso dell'essere."</skos:scopeNote>
    <skos:scopeNote xml:lang="en">"Do we today have an answer to the question of what we properly mean by the word 'being'? Not at all. It is therefore necessary to raise anew the question of the meaning of being."</skos:scopeNote>
    <skos:scopeNote xml:lang="la">"Habemusne hodie responsum ad quaestionem quid proprie voce 'ens' intellegamus? Minime. Necesse est igitur quaestionem de sensu essendi iterum ponere."</skos:scopeNote>
    <skos:broadMatch rdf:resource="https://aenigma.criptasemantica.it/metrum#ford-6-3"/>
    <skos:related rdf:resource="https://aenigma.criptasemantica.it/dubium#ontologiaFondamentale"/>
    <skos:related rdf:resource="https://aenigma.criptasemantica.it/dubium#problemaSensoEssere"/>
  </trv:Disciplina>
