  <trv:Stanza rdf:about="https://aenigma.criptasemantica.it/trivium#stanza-dei-canali">
    <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/trivium#stanze"/>
    <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/trivium#stanze"/>
    <skos:notation>stanza-dei-canali</skos:notation>
    <skos:prefLabel xml:lang="it">Stanza dei Canali</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Room of Channels</skos:prefLabel>
    <skos:prefLabel xml:lang="la">Cella Canalium</skos:prefLabel>
    <rdfs:label xml:lang="it">Stanza dei Canali</rdfs:label>
    <rdfs:label xml:lang="en">Room of Channels</rdfs:label>
    <rdfs:label xml:lang="la">Cella Canalium</rdfs:label>
    <dcterms:source rdf:resource="https://criptasemantica.it/progetto/canali/"/>
    <skos:scopeNote xml:lang="it">Portuno e le Naiadi governano un labirinto ricorsivo che allude alla teoria dell'informazione: i canali fisici che trasportano i dati dell'iperscrittura.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Portunus and the Naiads rule a recursive labyrinth that alludes to information theory: the physical channels that carry the data of hyperwriting.</skos:scopeNote>
    <skos:scopeNote xml:lang="la">Portunus et Naiades labyrinthum recursivum regunt qui theoriam informationis significat: canales physici qui data hyperscripturae vehunt.</skos:scopeNote>
    <skos:related rdf:resource="https://aenigma.criptasemantica.it/trivium#canali"/>
  </trv:Stanza>
