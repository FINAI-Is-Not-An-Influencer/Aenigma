    {
      "@id": "dub:",
      "@type": "owl:Ontology",
      "dcterms:creator": [
        {
          "@id": "https://criptasemantica.it/chi-siamo/finai/"
        },
        {
          "@id": "https://criptasemantica.it/chi-siamo/alessandro-sevardi/"
        }
      ],
      "dcterms:description": [
        {
          "@language": "it",
          "@value": "Primo modulo di Aenigma. Concetti, posizioni, domande e passi del manifesto della Cripta Semantica, con provenienza esplicita, formule leggibili e allineamenti a SKOS, PROV-O e schema.org."
        },
        {
          "@language": "en",
          "@value": "First module of Aenigma. Concepts, positions, questions and passages of the Cripta Semantica manifesto, with explicit provenance, readable formulas and alignments to SKOS, PROV-O and schema.org."
        },
        {
          "@language": "la",
          "@value": "Prima pars Aenigmatis. Notiones, sententiae, quaestiones et loci prooemii Cryptae Semanticae, cum origine expressa, formulis legibilibus et consensione cum SKOS, PROV-O et schema.org."
        }
      ],
      "dcterms:isPartOf": {
        "@id": "https://aenigma.criptasemantica.it/aenigma#"
      },
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-11-10"
      },
      "dcterms:language": [
        "it",
        "en",
        "la"
      ],
      "dcterms:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-11-11"
      },
      "dcterms:publisher": {
        "@id": "https://criptasemantica.it/"
      },
      "dcterms:source": {
        "@id": "https://criptasemantica.it/"
      },
      "dcterms:title": [
        {
          "@language": "it",
          "@value": "Dubium. Il manifesto della Cripta Semantica"
        },
        {
          "@language": "en",
          "@value": "Dubium. The Cripta Semantica manifesto"
        },
        {
          "@language": "la",
          "@value": "Dubium. Prooemium Cryptae Semanticae"
        }
      ],
      "owl:priorVersion": {
        "@id": "dub:v0.1.0-draft"
      },
      "owl:versionIRI": {
        "@id": "dub:v0.2.0"
      },
      "owl:versionInfo": "0.2.0",
      "rdfs:comment": [
        {
          "@language": "it",
          "@value": "Formalizzazione del manifesto pubblico. Ogni posizione rimanda al passo che la sostiene."
        },
        {
          "@language": "en",
          "@value": "Formalisation of the public manifesto. Every position points to the passage that supports it."
        },
        {
          "@language": "la",
          "@value": "Formalizatio prooemii publici. Quaeque sententia ad locum quo fulcitur remittit."
        }
      ],
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "Dubium. Il manifesto della Cripta Semantica"
        },
        {
          "@language": "en",
          "@value": "Dubium. The Cripta Semantica manifesto"
        },
        {
          "@language": "la",
          "@value": "Dubium. Prooemium Cryptae Semanticae"
        }
      ],
