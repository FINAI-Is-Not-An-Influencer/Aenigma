      "dub:force": {
        "@id": "dub:Limite"
      },
      "dub:formula": "RiferimentoNelPasso(⟦essere in quanto tale⟧,⟦ente onticamente inteso⟧) ∧ FiguraLimite(⟦ente onticamente inteso⟧,⟦nulla⟧) ∧ ¬Presupposto(∃x [Cosa(x) ∧ ReferentePrescelto(x)])",
      "dub:readingMode": {
        "@id": "dub:Fondamentale"
      },
      "dub:status": {
        "@id": "dub:Lettura"
      },
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "Ente ontico e nulla come riferimento-limite"
        },
        {
          "@language": "en",
          "@value": "Ontically understood entity and nothing as a limiting reference"
        },
        {
          "@language": "la",
          "@value": "Ens ontice intellectum et nihil ut relatio ad limen"
        }
      ]
    },
