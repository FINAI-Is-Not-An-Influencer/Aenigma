# EN: Questions record topics of inquiry and their sources.
# LA: Quaestiones argumenta inquirenda et fontes eorum inscribunt.

dub:Q01 a dub:Question ;
    rdfs:label "Che cosa intendiamo quando diciamo «essente»?"@it, "What do we mean when we say “being”?"@en, "Quid intellegimus cum dicimus «ens»?"@la ;
    dub:derivedFrom dub:P0 ;
    dub:readingMode dub:Epigrafe ;
    dub:concerns dub:essenteEspressione, dub:perplessita .

dub:Q02 a dub:Question ;
    rdfs:label "Come va posto il problema dell'essere?"@it, "How should the question of being be posed?"@en, "Quomodo quaestio de esse ponenda est?"@la ;
    dub:derivedFrom dub:P1 ;
    dub:readingMode dub:Fondamentale ;
    dub:concerns dub:problemaEssere, dub:porreProblema .

dub:Q03 a dub:Question ;
    rdfs:label "Come si apre il dominio nel quale una teoria può quantificare?"@it, "How does the domain of a theory's quantification open up?"@en, "Quomodo ambitus quantificationis theoriae aperitur?"@la ;
    dub:derivedFrom dub:P6 ;
    dub:readingMode dub:Regionale ;
    dub:concerns dub:ambitoOggettuale, dub:usiologia, dub:quantificazioneOntologica .

dub:Q04 a dub:Question ;
    rdfs:label "Come si può tematizzare l'essere senza assumere come oggetto una cosa?"@it, "How can we inquire into being without taking a thing as our object?"@en, "Quomodo esse investigari potest sine re pro obiecto sumpta?"@la ;
    dub:derivedFrom dub:P7 ;
    dub:readingMode dub:Fondamentale ;
    dub:concerns dub:essereInQuantoTale, dub:assenzaCosa, dub:nulla .

dub:Q05 a dub:Question ;
    rdfs:label "Qual è l'essenza dell'essere?"@it, "What is the essence of being?"@en, "Quae est essentia essendi?"@la ;
    dub:derivedFrom dub:P8 ;
    dub:readingMode dub:Fondamentale ;
    dub:concerns dub:problemaEssenzaEssere, dub:essenzaEssere .

dub:Q06 a dub:Question ;
    rdfs:label "Qual è il senso dell'essere?"@it, "What is the sense of being?"@en, "Quis est sensus essendi?"@la ;
    dub:derivedFrom dub:P8 ;
    dub:readingMode dub:Fondamentale ;
    dub:concerns dub:problemaSensoEssere, dub:sensoEssere .
