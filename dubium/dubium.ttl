    dub:partOfSource <https://criptasemantica.it/> ;
    dub:locator "Iperscrittura della ricerca ontologica, quarto capoverso."@it, "Hyperwriting of ontological inquiry, fourth paragraph."@en, "Hyperscriptura inquisitionis ontologicae, locus quartus."@la .

dub:P5 a dub:Passage ;
    rdfs:label "Analitica e quantificazione ontologica"@it, "Analytic ontology and ontological quantification"@en, "Ontologia analytica et quantificatio ontologica"@la ;
    dub:partOfSource <https://criptasemantica.it/> ;
    dub:locator "Iperscrittura della ricerca ontologica, quinto capoverso."@it, "Hyperwriting of ontological inquiry, fifth paragraph."@en, "Hyperscriptura inquisitionis ontologicae, locus quintus."@la .

dub:P6 a dub:Passage ;
    rdfs:label "Fenomenologia formale e regionale"@it, "Formal and regional phenomenology"@en, "Phaenomenologia formalis et regionalis"@la ;
    dub:partOfSource <https://criptasemantica.it/> ;
