@prefix dub: <https://aenigma.criptasemantica.it/dubium#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://aenigma.criptasemantica.it/dubium#> .

# EN: Preserve the ontology IRI used by existing editorial documents. The version IRI identifies this draft.
# LA: IRI ontologiae in documentis editorialibus iam adhibitum conserva. IRI versionis hoc exemplar praeparatorium designat.
<https://aenigma.criptasemantica.it/dubium#> rdf:type owl:Ontology ;
    owl:versionIRI <https://aenigma.criptasemantica.it/dubium#v0.1.0-draft> ;
    owl:versionInfo "0.1.0-draft" ;
    rdfs:label "Dubium. Il manifesto della Cripta Semantica"@it,
               "Dubium. The Cripta Semantica manifesto"@en,
               "Dubium. Prooemium Cryptae Semanticae"@la ;
    rdfs:comment "Formalizzazione del manifesto pubblico. Ogni posizione rimanda al passo che la sostiene."@it .

# EN: The following classes describe records in the graph. A Concept represents a meaning in a discourse.
# LA: Classes quae sequuntur schedulas graphi describunt. Concept sensum in sermone repraesentat.
dub:Source a owl:Class ; rdfs:label "fonte pubblica"@it, "public source"@en, "fons publicus"@la .
dub:Passage a owl:Class ; rdfs:label "passo localizzabile di una fonte"@it, "locatable source passage"@en, "locus fontis designatus"@la .
dub:Concept a owl:Class ; rdfs:label "riferimento concettuale"@it, "conceptual reference"@en, "relatio ad notionem"@la ;
    rdfs:comment "Identificatore di un senso nel discorso. La tipizzazione riguarda il riferimento concettuale."@it .
dub:ResearchItem a owl:Class ; rdfs:label "voce della ricerca"@it, "research entry"@en, "schedula inquisitionis"@la .
dub:Position a owl:Class ; rdfs:subClassOf dub:ResearchItem ; rdfs:label "posizione formalizzata"@it, "formalised position"@en, "sententia formalizata"@la ;
    rdfs:comment "Tesi, lettura esplicita o raccordo di contesto con formula e provenienza."@it .
dub:Question a owl:Class ; rdfs:subClassOf dub:ResearchItem ; rdfs:label "questione aperta"@it, "open question"@en, "quaestio aperta"@la ;
    owl:disjointWith dub:Position .
dub:RelationAssertion a owl:Class ; rdfs:label "asserzione relazionale qualificata"@it, "qualified relational assertion"@en, "assertio relationis qualificata"@la ;
    rdfs:comment "Proiezione leggibile di una formula entro la posizione indicata."@it .
dub:RelationKind a owl:Class ; rdfs:label "tipo di relazione nel discorso"@it, "kind of relation"@en, "genus relationis"@la ;
    rdfs:comment "Segno del vocabolario delle relazioni; può essere usato per interrogare le asserzioni."@it .
dub:ReadingMode a owl:Class ; rdfs:label "modo di lettura"@it, "mode of reading"@en, "ratio legendi"@la .
dub:Status a owl:Class ; rdfs:label "statuto della formalizzazione"@it, "status of formalisation"@en, "status formalizationis"@la .
dub:Force a owl:Class ; rdfs:label "forza dell'enunciato"@it, "force of the statement"@en, "vis enuntiati"@la .

# EN: Disjoint record roles expose modelling errors, such as classifying a passage as a conceptual reference.
# LA: Munera schedularum disiuncta errores exemplaris patefaciunt, velut si locus fontis pro notione habeatur.
[] a owl:AllDisjointClasses ;
    owl:members ( dub:Source dub:Passage dub:Concept dub:ResearchItem dub:RelationAssertion
                  dub:RelationKind dub:ReadingMode dub:Status dub:Force ) .

# EN: Provenance is a two-step path from a research entry to its passage and from that passage to its source.
# LA: Provenientia duobus gradibus constat, a schedula ad locum et a loco ad fontem.
dub:partOfSource a owl:ObjectProperty ;
    rdfs:domain dub:Passage ; rdfs:range dub:Source ;
    rdfs:label "appartiene alla fonte"@it, "belongs to a source"@en, "ad fontem pertinet"@la .
dub:locator a owl:DatatypeProperty ;
    rdfs:domain dub:Passage ; rdfs:range rdf:langString ;
    rdfs:label "localizzatore del passo"@it, "passage locator"@en, "loci indicium"@la .
dub:derivedFrom a owl:ObjectProperty ;
    rdfs:domain dub:ResearchItem ; rdfs:range dub:Passage ;
    rdfs:label "tratta dal passo"@it, "drawn from a passage"@en, "e loco sumitur"@la .
dub:readingMode a owl:ObjectProperty ;
    rdfs:domain dub:ResearchItem ; rdfs:range dub:ReadingMode ;
    rdfs:label "modo di lettura"@it, "mode of reading"@en, "ratio legendi"@la .
# EN: Status marks the editor’s relation to the source. Force marks what kind of claim the position expresses.
# LA: Status rationem editoris ad fontem significat. Vis indicat quale enuntiatum sententia exprimat.
dub:status a owl:ObjectProperty ;
    rdfs:domain dub:Position ; rdfs:range dub:Status ;
    rdfs:label "statuto"@it, "formalisation status"@en, "status formalizationis"@la .
dub:force a owl:ObjectProperty ;
    rdfs:domain dub:Position ; rdfs:range dub:Force ;
    rdfs:label "forza dell'enunciato"@it, "statement force"@en, "vis enuntiati"@la .
# EN: A formula is a string for readers. The OWL graph reasons over the record structure.
# LA: Formula est catena litterarum lectoribus destinata. Graphus OWL ex structura schedularum infert.
dub:formula a owl:DatatypeProperty ;
    rdfs:domain dub:Position ; rdfs:range xsd:string ;
    rdfs:label "formula simbolica"@it, "symbolic formula"@en, "formula symbolica"@la .
dub:concerns a owl:ObjectProperty ;
    rdfs:domain dub:Question ; rdfs:range dub:Concept ;
    rdfs:label "riguarda il concetto"@it, "concerns a concept"@en, "ad notionem spectat"@la .
# EN: The inverse property allows navigation from a position to its assertions under OWL entailment.
# LA: Proprietas inversa sinit a sententia ad eius assertiones per consequentiam OWL perveniri.
dub:belongsTo a owl:ObjectProperty ;
    rdfs:domain dub:RelationAssertion ; rdfs:range dub:Position ;
    rdfs:label "appartiene alla posizione"@it, "belongs to a position"@en, "ad sententiam pertinet"@la .
dub:hasAssertion a owl:ObjectProperty ;
    owl:inverseOf dub:belongsTo ;
    rdfs:domain dub:Position ; rdfs:range dub:RelationAssertion ;
    rdfs:label "ha asserzione"@it, "has a relational assertion"@en, "assertionem relationis habet"@la .
# EN: Each arc carries two concepts and a relation-kind node. That kind is a vocabulary entry.
# LA: Quisque arcus duas notiones et nodum generis relationis continet. Genus illud est vox lexici.
dub:subjectConcept a owl:ObjectProperty ;
    rdfs:domain dub:RelationAssertion ; rdfs:range dub:Concept ;
    rdfs:label "concetto di partenza"@it, "source concept"@en, "notio subiecta"@la .
dub:relationKind a owl:ObjectProperty ;
    rdfs:domain dub:RelationAssertion ; rdfs:range dub:RelationKind ;
    rdfs:label "tipo di relazione"@it, "kind of relation"@en, "genus relationis"@la .
dub:objectConcept a owl:ObjectProperty ;
    rdfs:domain dub:RelationAssertion ; rdfs:range dub:Concept ;
    rdfs:label "concetto di arrivo"@it, "target concept"@en, "notio obiecta"@la .

# EN: Public sources and locators. Keep the locators tied to the cited pages.
# LA: Fontes publici et indicia locorum. Indicia paginis citatis adhaereant.

<https://criptasemantica.it/> a dub:Source ;
    rdfs:label "Manifesto della Cripta Semantica"@it, "Cripta Semantica manifesto"@en, "Prooemium Cryptae Semanticae"@la .

dub:P0 a dub:Passage ;
    rdfs:label "Titolo, sottotitolo ed epigrafe"@it, "Title, subtitle and epigraph"@en, "Titulus, subtitulus et epigraphe"@la ;
    dub:partOfSource <https://criptasemantica.it/> ;
    dub:locator "Titolo della homepage ed epigrafe da Platone, Sofista 244a, traduzione attribuita a Pietro Chiodi."@it, "Homepage title and epigraph from Plato, Sophist 244a. The Italian rendering is attributed to Pietro Chiodi."@en, "Titulus paginae primae et epigraphe e Platone, Sophista 244a. Versio Italica Petro Chiodi tribuitur."@la .

dub:P1 a dub:Passage ;
    rdfs:label "Posizione del problema, Grecia, dialogo"@it, "Posing the question, Greece, dialogue"@en, "Quaestio posita, Graecia, dialogus"@la ;
    dub:partOfSource <https://criptasemantica.it/> ;
    dub:locator "Iperscrittura della ricerca ontologica, primo capoverso."@it, "Hyperwriting of ontological inquiry, first paragraph."@en, "Hyperscriptura inquisitionis ontologicae, locus primus."@la .

dub:P2 a dub:Passage ;
