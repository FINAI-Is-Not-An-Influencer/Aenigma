    dub:locator "Pagina Articoli, introduzione al rapporto fra senso, ricerca e articolo."@it, "Articles page, introduction to the relation between sense, inquiry and article."@en, "Pagina Articulorum, initium de nexu inter sensum, inquisitionem et articulum."@la .

# EN: Controlled vocabularies separate the status, force and mode of reading.
# LA: Lexica definita statum, vim et rationem legendi distinguunt.

dub:Parafrasi a dub:Status ;
    rdfs:label "parafrasi del testo"@it, "paraphrase of the text"@en, "paraphrasis textus"@la .

dub:Lettura a dub:Status ;
    rdfs:label "scelta interpretativa del modello"@it, "interpretive choice"@en, "electio interpretativa"@la .

dub:Estensione a dub:Status ;
    rdfs:label "raccordo da una pagina di contesto"@it, "contextual extension"@en, "extensio e contextu"@la .

dub:Testimoniale a dub:Force ;
    rdfs:label "attribuzione o testimonianza"@it, "testimony or attribution"@en, "testimonium vel attributio"@la .

dub:Storica a dub:Force ;
    rdfs:label "affermazione storica del testo"@it, "historical claim in the text"@en, "assertio historica textus"@la .

dub:Genealogia a dub:Force ;
    rdfs:label "ricostruzione genealogica"@it, "genealogical reconstruction"@en, "reconstructio genealogica"@la .

dub:Normativa a dub:Force ;
    rdfs:label "compito indicato dal testo"@it, "task prescribed by the text"@en, "munus a textu praescriptum"@la .

dub:Modale a dub:Force ;
    rdfs:label "possibilità o destinazione"@it, "possibility or orientation"@en, "possibilitas vel destinatio"@la .

dub:Definizione a dub:Force ;
    rdfs:label "definizione o caratterizzazione"@it, "definition or characterisation"@en, "definitio vel descriptio"@la .

dub:Funzionale a dub:Force ;
    rdfs:label "funzione o meccanismo"@it, "function or mechanism"@en, "functio vel processus"@la .

dub:Intenzionale a dub:Force ;
    rdfs:label "intenzione riflessiva"@it, "reflexive intent"@en, "intentio reflexiva"@la .

dub:Fondazione a dub:Force ;
    rdfs:label "dipendenza o fondazione"@it, "dependence or grounding"@en, "dependentia vel fundatio"@la .

dub:Logica a dub:Force ;
    rdfs:label "struttura logica"@it, "logical structure"@en, "structura logica"@la .

dub:Limite a dub:Force ;
    rdfs:label "limite della tematizzazione"@it, "limit of inquiry"@en, "terminus inquisitionis"@la .

dub:Epigrafe a dub:ReadingMode ;
    rdfs:label "uso di una parola e perplessità"@it, "use of a word and perplexity"@en, "usus vocis et perplexitas"@la .

dub:Genealogica a dub:ReadingMode ;
    rdfs:label "genealogia filosofica"@it, "philosophical genealogy"@en, "genealogia philosophica"@la .

dub:Mediale a dub:ReadingMode ;
    rdfs:label "storia e funzionamento dei mezzi"@it, "history and operation of media"@en, "historia et operatio mediorum"@la .

dub:Informatica a dub:ReadingMode ;
    rdfs:label "specificazione informatica"@it, "computational specification"@en, "specificatio informatica"@la .

dub:Analitica a dub:ReadingMode ;
    rdfs:label "indagine filosofico-analitica"@it, "analytic philosophical inquiry"@en, "inquisitio philosophica analytica"@la .

dub:Fenomenologica a dub:ReadingMode ;
    rdfs:label "articolazione fenomenologica"@it, "phenomenological articulation"@en, "articulatio phaenomenologica"@la .

dub:Formale a dub:ReadingMode ;
    rdfs:label "formale nel senso fenomenologico"@it, "formal in the phenomenological sense"@en, "formalis sensu phaenomenologico"@la .

dub:Regionale a dub:ReadingMode ;
    rdfs:label "regionale nel senso fenomenologico"@it, "regional in the phenomenological sense"@en, "regionalis sensu phaenomenologico"@la .

dub:Metafisica a dub:ReadingMode ;
    rdfs:label "ontologica riguardo all'ente come cosa"@it, "ontological with regard to an entity as a thing"@en, "ontologica quoad ens ut rem"@la .

dub:Ontica a dub:ReadingMode ;
    rdfs:label "ontica riguardo all'essere di un ente"@it, "ontic with regard to the being of an entity"@en, "ontica quoad esse entis"@la .

dub:Fondamentale a dub:ReadingMode ;
    rdfs:label "ontologica riguardo all'essere in quanto tale"@it, "ontological with regard to being as such"@en, "ontologica quoad esse ipsum"@la .

dub:Contestuale a dub:ReadingMode ;
    rdfs:label "estensione dal contesto pubblico"@it, "extension from public context"@en, "extensio e contextu publico"@la .

dub:rel-accessibileA a dub:RelationKind ;
    rdfs:label "è accessibile a"@it, "is accessible to"@en, "patet"@la .

dub:rel-accresce a dub:RelationKind ;
