dub:rel-implica a dub:RelationKind ;
    rdfs:label "implica nel discorso"@it, "implies in the discourse"@en, "secundum textum implicat"@la .

dub:rel-inaugura a dub:RelationKind ;
    rdfs:label "inaugura"@it, "inaugurates"@en, "inaugurat"@la .

dub:rel-indica a dub:RelationKind ;
    rdfs:label "indica"@it, "indicates"@en, "indicat"@la .

dub:rel-indipendenteDa a dub:RelationKind ;
    rdfs:label "è indipendente da"@it, "is independent of"@en, "non pendet ab"@la .

dub:rel-individua a dub:RelationKind ;
    rdfs:label "individua"@it, "identifies"@en, "determinat"@la .

dub:rel-iniziaCon a dub:RelationKind ;
    rdfs:label "inizia con"@it, "begins with"@en, "incipit cum"@la .

dub:rel-iniziaDa a dub:RelationKind ;
    rdfs:label "prende inizio da"@it, "starts from"@en, "incipit ab"@la .

dub:rel-inquadra a dub:RelationKind ;
    rdfs:label "inquadra"@it, "frames"@en, "in ambitu collocat"@la .

dub:rel-integra a dub:RelationKind ;
    rdfs:label "integra"@it, "incorporates"@en, "includit"@la .

dub:rel-lasciaPostoA a dub:RelationKind ;
    rdfs:label "lascia posto a"@it, "gives way to"@en, "locum cedit"@la .

dub:rel-livelloDi a dub:RelationKind ;
    rdfs:label "è un livello di"@it, "is a level of"@en, "gradus est"@la .

dub:rel-localizzatoIn a dub:RelationKind ;
    rdfs:label "è localizzato in"@it, "is located in"@en, "situs est in"@la .

dub:rel-mediataDa a dub:RelationKind ;
    rdfs:label "è mediata da"@it, "is mediated by"@en, "ope perficitur"@la .

dub:rel-metteInCircuito a dub:RelationKind ;
    rdfs:label "mette in circuito"@it, "puts into circulation"@en, "in circuitum mittit"@la .

dub:rel-metteInFunzione a dub:RelationKind ;
    rdfs:label "mette in funzione"@it, "puts into operation"@en, "in usum adducit"@la .

dub:rel-modoDi a dub:RelationKind ;
    rdfs:label "è un modo di"@it, "is a mode of"@en, "modus est"@la .

dub:rel-motivataDa a dub:RelationKind ;
    rdfs:label "è motivata da"@it, "is motivated by"@en, "causam habet"@la .

dub:rel-operaCon a dub:RelationKind ;
    rdfs:label "opera con"@it, "works with"@en, "operatur cum"@la .

dub:rel-operaIn a dub:RelationKind ;
    rdfs:label "opera in"@it, "operates in"@en, "operatur in"@la .

dub:rel-organizza a dub:RelationKind ;
    rdfs:label "organizza"@it, "organises"@en, "ordinat"@la .

dub:rel-pone a dub:RelationKind ;
    rdfs:label "pone"@it, "poses"@en, "ponit"@la .

dub:rel-presuppone a dub:RelationKind ;
    rdfs:label "presuppone"@it, "presupposes"@en, "praesupponit"@la .

dub:rel-produce a dub:RelationKind ;
    rdfs:label "produce"@it, "produces"@en, "producit"@la .

dub:rel-qualifica a dub:RelationKind ;
    rdfs:label "qualifica"@it, "qualifies"@en, "determinat qualiter"@la .

dub:rel-raccoglie a dub:RelationKind ;
    rdfs:label "raccoglie"@it, "collects"@en, "colligit"@la .

dub:rel-raccorda a dub:RelationKind ;
    rdfs:label "raccorda"@it, "connects"@en, "conectit"@la .

dub:rel-realizza a dub:RelationKind ;
    rdfs:label "realizza"@it, "realises"@en, "ad effectum ducit"@la .

dub:rel-registra a dub:RelationKind ;
    rdfs:label "registra"@it, "records"@en, "consignat"@la .

dub:rel-relativaA a dub:RelationKind ;
    rdfs:label "è relativa a"@it, "is relative to"@en, "refertur ad"@la .

dub:rel-rendePossibile a dub:RelationKind ;
    rdfs:label "rende possibile"@it, "makes possible"@en, "possibile facit"@la .

dub:rel-riceveSensoDa a dub:RelationKind ;
    rdfs:label "riceve senso da"@it, "receives sense from"@en, "sensum accipit ab"@la .

dub:rel-richiede a dub:RelationKind ;
    rdfs:label "richiede"@it, "requires"@en, "requirit"@la .

dub:rel-ricorreIn a dub:RelationKind ;
    rdfs:label "ricorre in"@it, "recurs in"@en, "recurrit in"@la .

dub:rel-rifletteSu a dub:RelationKind ;
    rdfs:label "riflette su"@it, "reflects on"@en, "reflectit de"@la .

dub:rel-riguarda a dub:RelationKind ;
    rdfs:label "riguarda"@it, "concerns"@en, "spectat ad"@la .

dub:rel-rinviaComeFigura a dub:RelationKind ;
    rdfs:label "rinvia a una figura"@it, "refers to as a figure"@en, "ad figuram remittit"@la .

dub:rel-segue a dub:RelationKind ;
    rdfs:label "segue"@it, "follows"@en, "sequitur"@la .

dub:rel-sensoDi a dub:RelationKind ;
    rdfs:label "è un senso di"@it, "is a sense of"@en, "sensus est"@la .

dub:rel-siArticolaIn a dub:RelationKind ;
    rdfs:label "si articola in"@it, "is articulated into"@en, "articulatur in"@la .

dub:rel-siAvvaleDi a dub:RelationKind ;
    rdfs:label "si avvale di"@it, "makes use of"@en, "utitur"@la .

dub:rel-sostieneOnticamente a dub:RelationKind ;
    rdfs:label "sostiene onticamente"@it, "supports ontically"@en, "ontice sustinet"@la .

dub:rel-sovrasta a dub:RelationKind ;
    rdfs:label "sovrasta"@it, "overlies"@en, "superstat"@la .

dub:rel-studia a dub:RelationKind ;
    rdfs:label "studia"@it, "investigates"@en, "investigat"@la .

dub:rel-sviluppa a dub:RelationKind ;
    rdfs:label "sviluppa"@it, "develops"@en, "explicat ulterius"@la .

dub:rel-traduzioneAttribuitaA a dub:RelationKind ;
    rdfs:label "ha traduzione attribuita a"@it, "has a translation attributed to"@en, "versionem habet attributam"@la .

dub:rel-tramanda a dub:RelationKind ;
    rdfs:label "tramanda"@it, "hands down"@en, "tradit"@la .

dub:rel-trasforma a dub:RelationKind ;
    rdfs:label "trasforma"@it, "transforms"@en, "transformat"@la .

dub:rel-usataCon a dub:RelationKind ;
    rdfs:label "è usata con"@it, "is used with"@en, "in usu coniungitur cum"@la .

dub:rel-valePer a dub:RelationKind ;
    rdfs:label "vale per"@it, "holds for"@en, "valet pro"@la .

dub:rel-varianteDi a dub:RelationKind ;
    rdfs:label "è una variante di"@it, "is a variant of"@en, "species varians est"@la .

dub:rel-vincola a dub:RelationKind ;
    rdfs:label "vincola"@it, "binds"@en, "ligat"@la .

# EN: Concepts are identified meanings. Their glosses explain how a word is used here.
# LA: Notiones sunt sensus designati. Glossae explicant quomodo vox hic adhibeatur.

dub:criptaIpertesto a dub:Concept ;
    rdfs:label "Cripta Semantica come ipertesto"@it, "Cripta Semantica as hypertext"@en, "Crypta Semantica ut hypertextus"@la ;
    rdfs:comment "Risultato aperto dell'iperscrittura della ricerca ontologica fondamentale."@it, "The open result of hyperwriting in fundamental ontological inquiry."@en, "Exitus apertus hyperscripturae inquisitionis ontologicae fundamentalis."@la .

dub:criptaSito a dub:Concept ;
    rdfs:label "Cripta Semantica come sito"@it, "Cripta Semantica as website"@en, "Crypta Semantica ut situs retialis"@la ;
    rdfs:comment "Sito digitale che raccoglie, rende accessibili e collega note."@it, "The digital site that collects, connects and makes notes available."@en, "Situs digitalis qui notas colligit, conectit et lectoribus praebet."@la .

dub:notaIpertestuale a dub:Concept ;
    rdfs:label "nota ipertestuale"@it, "hypertextual note"@en, "nota hypertextualis"@la ;
    rdfs:comment "Unità comunicante che può riprendere il progetto al proprio interno."@it, "A unit that communicates with other notes and can take up the project within itself."@en, "Unitas quae cum aliis notis communicat et propositum intra se resumere potest."@la .

dub:filoConduttore a dub:Concept ;
    rdfs:label "filo conduttore"@it, "guiding thread"@en, "filum dux"@la ;
    rdfs:comment "Funzione del problema del senso dell'essere nel raccordare la ricerca."@it, "The role played by the question of the sense of being in connecting inquiries."@en, "Munus quaestionis de sensu essendi in inquisitionibus conectendis."@la .

dub:epigrafe a dub:Concept ;
    rdfs:label "epigrafe del manifesto"@it, "manifesto epigraph"@en, "epigraphe prooemii"@la ;
    rdfs:comment "Passo collocato all'ingresso dell'ipertesto."@it, "A passage placed at the entrance to the hypertext."@en, "Locus in ipso hypertextus aditu positus."@la .

dub:sofista244a a dub:Concept ;
    rdfs:label "Sofista 244a"@it, "Sophist 244a"@en, "Sophista 244a"@la ;
    rdfs:comment "Riferimento all'opera platonica e al passo citato in epigrafe."@it, "Reference to Plato's work and the passage quoted in the epigraph."@en, "Relatio ad opus Platonis et locum in epigraphe citatum."@la .

dub:platone a dub:Concept ;
    rdfs:label "Platone"@it, "Plato"@en, "Plato"@la ;
    rdfs:comment "Autore a cui l'epigrafe attribuisce il passo."@it, "Author to whom the epigraph attributes the passage."@en, "Auctor cui epigraphe locum attribuit."@la .

dub:pietroChiodi a dub:Concept ;
    rdfs:label "Pietro Chiodi"@it, "Pietro Chiodi"@en, "Petrus Chiodi"@la ;
    rdfs:comment "Traduttore a cui il manifesto attribuisce la resa italiana."@it, "Translator to whom the manifesto attributes the Italian rendering."@en, "Interpres cui prooemium versionem Italicam tribuit."@la .

dub:essenteEspressione a dub:Concept ;
    rdfs:label "«essente» come espressione"@it, "“being” as an expression"@en, "vox «ens»"@la ;
    rdfs:comment "Parola il cui uso familiare diviene problematico nell'epigrafe."@it, "A familiar word whose meaning becomes a problem in the epigraph."@en, "Vox familiaris cuius significatio in epigraphe in quaestionem vocatur."@la .

dub:familiarita a dub:Concept ;
    rdfs:label "familiarità d'uso"@it, "familiarity in use"@en, "familiaritas usus"@la ;
    rdfs:comment "Intesa pratica presupposta nell'uso di un'espressione."@it, "The practical understanding presupposed in using an expression."@en, "Intellegentia usu comparata quae in voce adhibenda praesupponitur."@la .

dub:comprensionePresunta a dub:Concept ;
    rdfs:label "comprensione presunta"@it, "presumed understanding"@en, "intellectus praesumptus"@la ;
    rdfs:comment "Credenza di avere già compreso il senso."@it, "The belief that one already understands the sense."@en, "Opinio qua quis sensum iam intellegere sibi videtur."@la .

dub:perplessita a dub:Concept ;
    rdfs:label "perplessità"@it, "perplexity"@en, "perplexitas"@la ;
    rdfs:comment "Esito interrogativo della perdita della comprensione presunta."@it, "The questioning that results when presumed understanding gives way."@en, "Dubitatio quae intellectu praesumpto sublato oritur."@la .

dub:problemaEssere a dub:Concept ;
    rdfs:label "problema dell'essere"@it, "question of being"@en, "quaestio de esse"@la ;
    rdfs:comment "Questione da porre che orienta l'impresa filosofica."@it, "The question to be posed in order to orient philosophical inquiry."@en, "Quaestio ponenda quae inquisitionem philosophicam dirigit."@la .

dub:problemaSensoEssere a dub:Concept ;
    rdfs:label "problema del senso dell'essere"@it, "question of the sense of being"@en, "quaestio de sensu essendi"@la ;
    rdfs:comment "Questione che raccorda i livelli e i piani della ricerca."@it, "The question that connects the levels and planes of inquiry."@en, "Quaestio quae gradus et plana inquisitionis conectit."@la .

dub:problemaEssenzaEssere a dub:Concept ;
    rdfs:label "problema dell'essenza dell'essere"@it, "question of the essence of being"@en, "quaestio de essentia essendi"@la ;
    rdfs:comment "Questione tematizzata nello sviluppo posizionale della ricerca."@it, "The question posed as the inquiry develops."@en, "Quaestio quae in inquisitione progrediente ponitur."@la .

dub:necessitaPorre a dub:Concept ;
    rdfs:label "necessità di porre il problema"@it, "need to pose the question"@en, "necessitas quaestionem ponendi"@la ;
    rdfs:comment "Carattere necessario attribuito alla posizione del problema dell'essere."@it, "The necessity the manifesto attributes to posing the question of being."@en, "Necessitas quam prooemium positioni quaestionis de esse tribuit."@la .

dub:porreProblema a dub:Concept ;
    rdfs:label "posizione del problema"@it, "posing the question"@en, "quaestionis positio"@la ;
    rdfs:comment "Atto di mettere a tema la questione e tenerla aperta."@it, "The act of making the question a theme and keeping it open."@en, "Actus quo quaestio tractanda proponitur et aperta servatur."@la .

dub:pensieroOccidentale a dub:Concept ;
    rdfs:label "pensiero occidentale"@it, "Western thought"@en, "cogitatio occidentalis"@la ;
    rdfs:comment "Tradizione il cui inizio è narrato nel manifesto."@it, "The tradition whose beginnings the manifesto narrates."@en, "Traditio cuius initia prooemium narrat."@la .

dub:esordioGreco a dub:Concept ;
    rdfs:label "esordio greco"@it, "Greek beginnings"@en, "exordium Graecum"@la ;
    rdfs:comment "Inizio del pensiero occidentale localizzato in Grecia nel racconto del manifesto."@it, "The beginning of Western thought, located in Greece in the manifesto's account."@en, "Initium cogitationis occidentalis quod prooemium in Graecia collocat."@la .

dub:grecia a dub:Concept ;
    rdfs:label "Grecia"@it, "Greece"@en, "Graecia"@la ;
    rdfs:comment "Localizzazione dell'esordio secondo il manifesto."@it, "The location of that beginning in the manifesto."@en, "Locus illius initii secundum prooemium."@la .

dub:filosofia a dub:Concept ;
    rdfs:label "filosofia"@it, "philosophy"@en, "philosophia"@la ;
    rdfs:comment "Corpo tradizionale del pensiero occidentale e disciplina originariamente orale."@it, "The traditional body of Western thought and a discipline originally practised orally."@en, "Corpus traditum cogitationis occidentalis atque disciplina primum ore exercita."@la .

dub:oralita a dub:Concept ;
    rdfs:label "oralità"@it, "orality"@en, "usus oralis"@la ;
    rdfs:comment "Forma di esercizio della filosofia che precede il trasferimento nei testi."@it, "The mode of practising philosophy that precedes its transfer to writing."@en, "Ratio philosophandi quae traditionem scriptam antecedit."@la .

dub:praticaDialogica a dub:Concept ;
    rdfs:label "pratica dialogica"@it, "dialogical practice"@en, "exercitatio dialogica"@la ;
    rdfs:comment "Esercizio condiviso volto alla reminiscenza dell'essere."@it, "A shared exercise aimed at recollecting being."@en, "Exercitatio communis ad reminiscendum esse directa."@la .

dub:partecipante a dub:Concept ;
    rdfs:label "partecipante"@it, "participant"@en, "particeps"@la ;
    rdfs:comment "Chi prende parte alla pratica dialogica."@it, "Someone who takes part in the dialogical practice."@en, "Is qui exercitationis dialogicae particeps est."@la .

dub:psiche a dub:Concept ;
    rdfs:label "psiche"@it, "psyche"@en, "animus"@la ;
    rdfs:comment "Ciò che la pratica trasforma nei partecipanti."@it, "What the practice transforms in the participants."@en, "Id quod exercitatio in participibus transformat."@la .

dub:reminiscenza a dub:Concept ;
    rdfs:label "reminiscenza"@it, "recollection"@en, "reminiscentia"@la ;
    rdfs:comment "Rimemorazione dell'essere come fine del dialogo."@it, "Recollecting being as the aim of dialogue."@en, "Reminiscentia essendi ut finis dialogi."@la .

dub:scienzaTrasformazione a dub:Concept ;
    rdfs:label "scienza come trasformazione"@it, "science as transformation"@en, "scientia ut transformatio"@la ;
    rdfs:comment "Nome della trasformazione psichica prodotta dalla pratica nel passo."@it, "The passage's name for the change in the psyche produced by the practice."@en, "Nomen quo locus mutationem animi ab exercitatione effectam appellat."@la .

dub:risultatoDialogico a dub:Concept ;
    rdfs:label "risultato del dialogo"@it, "outcome of dialogue"@en, "exitus dialogi"@la ;
    rdfs:comment "Esito della pratica che può essere trasferito nello scritto."@it, "An outcome of dialogue that can be written down."@en, "Exitus dialogi qui litteris mandari potest."@la .

dub:memoriaDialogica a dub:Concept ;
    rdfs:label "ricordo del dialogo"@it, "memory of dialogue"@en, "memoria dialogi"@la ;
    rdfs:comment "Memoria della pratica che può essere trasferita nello scritto."@it, "A memory of dialogue that can be written down."@en, "Memoria dialogi quae litteris mandari potest."@la .

dub:testo a dub:Concept ;
    rdfs:label "testo"@it, "text"@en, "textus"@la ;
    rdfs:comment "Supporto della trasmissione scritta e ingresso dell'iperscrittura elementare."@it, "A vehicle of written transmission and an input to elementary hyperwriting."@en, "Instrumentum traditionis scriptae et materia hyperscripturae elementaris."@la .

dub:tradizioneTestuale a dub:Concept ;
    rdfs:label "tradizione testuale"@it, "textual tradition"@en, "traditio textualis"@la ;
    rdfs:comment "Sequenza di scritti che tramandano e accrescono la filosofia."@it, "A sequence of writings that transmits and extends philosophy."@en, "Series scriptorum quae philosophiam tradit et auget."@la .

dub:scrittura a dub:Concept ;
    rdfs:label "scrittura"@it, "writing"@en, "scriptura"@la ;
    rdfs:comment "Pratica associata all'inizio della storia e sottoposta a quantificazione."@it, "The practice associated with the beginning of history and subject to quantification."@en, "Exercitatio quae cum initio historiae conectitur et quantificationi subicitur."@la .

dub:storia a dub:Concept ;
    rdfs:label "storia"@it, "history"@en, "historia"@la ;
    rdfs:comment "Periodo che nel parallelismo comincia con l'avvento della scrittura."@it, "The period which, in the analogy, begins with the appearance of writing."@en, "Aetas quae, secundum analogiam, scriptura apparente incipit."@la .

dub:svolta1936 a dub:Concept ;
    rdfs:label "svolta del 1936"@it, "the turning point of 1936"@en, "discrimen anni 1936"@la ;
    rdfs:comment "Soglia storica individuata nel manifesto con la pubblicazione di una macchina astratta."@it, "The threshold the manifesto identifies with publication of an abstract machine."@en, "Limen quod prooemium editione machinae abstractae designat."@la .

dub:pubblicazioneMacchina a dub:Concept ;
    rdfs:label "pubblicazione della macchina astratta"@it, "publication of the abstract machine"@en, "editio machinae abstractae"@la ;
    rdfs:comment "Evento con cui il manifesto individua la svolta."@it, "The event the manifesto uses to locate the turning point."@en, "Eventus quo prooemium discrimen designat."@la .

dub:macchinaAstratta a dub:Concept ;
    rdfs:label "macchina astratta"@it, "abstract machine"@en, "machina abstracta"@la ;
    rdfs:comment "Modello astratto al quale vengono messi in rapporto i testi."@it, "An abstract model to which texts are put in relation."@en, "Exemplar abstractum ad quod textus referuntur."@la .

dub:iperstoria a dub:Concept ;
    rdfs:label "iperstoria"@it, "hyperhistory"@en, "hyperhistoria"@la ;
    rdfs:comment "Periodo inaugurato dalla svolta e correlato all'iperscrittura."@it, "The period inaugurated by the turning point and associated with hyperwriting."@en, "Aetas a discrimine inaugurata et cum hyperscriptura coniuncta."@la .

dub:infosfera a dub:Concept ;
    rdfs:label "infosfera"@it, "infosphere"@en, "sphaera informationis"@la ;
    rdfs:comment "Ambiente informazionale la cui nascita è associata alla svolta."@it, "The informational environment whose emergence is associated with the turning point."@en, "Ambitus informationis cuius ortus cum discrimine conectitur."@la .

dub:quantificazioneScrittura a dub:Concept ;
    rdfs:label "quantificazione della scrittura"@it, "quantification of writing"@en, "quantificatio scripturae"@la ;
    rdfs:comment "Processo storico-tecnico che trova esposizione nell'ipertesto."@it, "A historical and technical process that is exhibited in hypertext."@en, "Processus historicus et technicus qui in hypertextu manifestatur."@la .

dub:quantificazioneOntologica a dub:Concept ;
    rdfs:label "quantificazione ontologica"@it, "ontological quantification"@en, "quantificatio ontologica"@la ;
    rdfs:comment "Lettura dell'impegno di una teoria attraverso i valori ammissibili delle variabili vincolate."@it, "Reading a theory's commitments through the admissible values of bound variables."@en, "Examinatio obligationum theoriae per valores admissibiles variabilium ligatorum."@la .

dub:destinazioneIpertestuale a dub:Concept ;
    rdfs:label "destinazione all'ipertesto"@it, "orientation towards hypertext"@en, "destinatio ad hypertextum"@la ;
    rdfs:comment "Trasposizione prospettata a prescindere dalla consapevolezza dell'ipertesto."@it, "The projected shift into hypertext, regardless of awareness of that form."@en, "Transitus ad hypertextum prospectus, sive quis illius formae conscius est sive non."@la .

dub:produzioneFilosofica a dub:Concept ;
    rdfs:label "produzione filosofica"@it, "philosophical production"@en, "productio philosophica"@la ;
    rdfs:comment "Produzione testuale che dopo la svolta può assumere forma ipertestuale."@it, "Textual production that can take hypertextual form after the turning point."@en, "Productio textualis quae post discrimen formam hypertextualem sumere potest."@la .

dub:iperscrittura a dub:Concept ;
    rdfs:label "iperscrittura"@it, "hyperwriting"@en, "hyperscriptura"@la ;
    rdfs:comment "Processo di produzione di ipertesti."@it, "The process of producing hypertexts."@en, "Processus hypertextus producendi."@la .

dub:iperscritturaElementare a dub:Concept ;
    rdfs:label "iperscrittura elementare"@it, "elementary hyperwriting"@en, "hyperscriptura elementaris"@la ;
    rdfs:comment "Messa in funzione di testi in rapporto a macchine astratte."@it, "Putting texts into operation in relation to abstract machines."@en, "Textus ad machinas abstractas relatos in usum adducere."@la .

dub:iperscritturaConsapevole a dub:Concept ;
    rdfs:label "iperscrittura consapevole"@it, "conscious hyperwriting"@en, "hyperscriptura conscia"@la ;
    rdfs:comment "Messa in circuito di contenuti e codici di sviluppo del Web."@it, "Putting content and development code into circulation on the Web."@en, "Materiam et codicem exstruendi per Rete in circuitum mittere."@la .

dub:iperscritturaRiflessiva a dub:Concept ;
    rdfs:label "iperscrittura riflessiva"@it, "reflexive hyperwriting"@en, "hyperscriptura reflexiva"@la ;
    rdfs:comment "Consapevolezza della propria capacità di veicolare contenuti."@it, "Awareness of one's own capacity to convey content."@en, "Conscientia propriae facultatis materiam tradendi."@la .

dub:consapevolezza a dub:Concept ;
    rdfs:label "consapevolezza dell'iperscrittura"@it, "awareness of hyperwriting"@en, "conscientia hyperscripturae"@la ;
    rdfs:comment "Riconoscimento riflessivo del processo o della sua forma."@it, "Reflexive recognition of the process or its form."@en, "Agnitio reflexiva processus vel formae eius."@la .

dub:ipertesto a dub:Concept ;
    rdfs:label "ipertesto"@it, "hypertext"@en, "hypertextus"@la ;
    rdfs:comment "Esito dell'iperscrittura e forma espositiva della quantificazione della scrittura."@it, "The result of hyperwriting and the form in which writing's quantification becomes manifest."@en, "Exitus hyperscripturae atque forma qua quantificatio scripturae apparet."@la .

dub:web a dub:Concept ;
    rdfs:label "Rete di Portata Mondiale"@it, "World Wide Web"@en, "Rete Totum Orbem Complectens"@la ;
    rdfs:comment "World Wide Web, ambiente di messa in circuito di contenuti e codici."@it, "The environment in which content and code are put into circulation."@en, "Ambitus in quo materia et codices in circuitum mittuntur."@la .

dub:sviluppoWeb a dub:Concept ;
    rdfs:label "sviluppo del Web"@it, "development of the Web"@en, "progressus Retis"@la ;
    rdfs:comment "Accrescimento e perfezionamento orientati al capitale semantico."@it, "Growth and improvement directed towards semantic capital."@en, "Incrementum et perfectio ad capitale semanticum directa."@la .

dub:codiceSviluppo a dub:Concept ;
    rdfs:label "codice di sviluppo"@it, "development code"@en, "praecepta ad Rete exstruendum"@la ;
    rdfs:comment "Codice messo in circuito nel Web dall'iperscrittura consapevole."@it, "Code put into circulation on the Web by conscious hyperwriting."@en, "Praecepta quae hyperscriptura conscia in circuitum Retis mittit."@la .

dub:contenuto a dub:Concept ;
    rdfs:label "contenuto"@it, "content"@en, "materia expressa"@la ;
    rdfs:comment "Ciò che l'iperscrittura può veicolare e l'esserci può comprendere."@it, "What hyperwriting can convey and Dasein can understand."@en, "Id quod hyperscriptura tradere et adesse intellegere potest."@la .

dub:significato a dub:Concept ;
    rdfs:label "significato computabile"@it, "computable meaning"@en, "significatio computabilis"@la ;
    rdfs:comment "Organizzazione del contenuto resa accessibile a macchine concrete."@it, "The organisation of content in a form that concrete machines can process."@en, "Ordinatio materiae in formam a machinis concretis tractabilem."@la .

dub:capitaleSemantico a dub:Concept ;
    rdfs:label "capitale semantico"@it, "semantic capital"@en, "capitale semanticum"@la ;
    rdfs:comment "Risorsa costituita dall'organizzazione dei contenuti in significati accessibili a macchine."@it, "A resource formed by organising content into meanings that machines can process."@en, "Opes ex materia in significationes a machinis tractabiles ordinata constitutae."@la .

dub:accumuloSemantico a dub:Concept ;
    rdfs:label "accumulo di capitale semantico"@it, "accumulation of semantic capital"@en, "accumulatio capitalis semantici"@la ;
    rdfs:comment "Primo orientamento attribuito allo sviluppo del Web."@it, "The first orientation ascribed to the development of the Web."@en, "Prima directio progressui Retis attributa."@la .

dub:distribuzioneSemantica a dub:Concept ;
    rdfs:label "distribuzione di capitale semantico"@it, "distribution of semantic capital"@en, "distributio capitalis semantici"@la ;
    rdfs:comment "Secondo orientamento attribuito allo sviluppo del Web."@it, "The second orientation ascribed to the development of the Web."@en, "Altera directio progressui Retis attributa."@la .

dub:organizzazioneSemantica a dub:Concept ;
    rdfs:label "organizzazione semantica"@it, "semantic organisation"@en, "ordinatio semantica"@la ;
    rdfs:comment "Trasformazione di contenuti accessibili all'esserci in significati trattabili da macchine."@it, "The transformation of humanly accessible content into meanings that machines can process."@en, "Transformatio materiae adesse patentis in significationes a machinis tractabiles."@la .

dub:esserci a dub:Concept ;
    rdfs:label "esserci"@it, "Dasein"@en, "adesse (Dasein)"@la ;
    rdfs:comment "Polo di accessibilità umana del contenuto nel passo sul capitale semantico."@it, "The human pole of accessibility in the passage on semantic capital."@en, "Pars humana accessus in loco de capitali semantico."@la .

dub:esserciDellEssere a dub:Concept ;
    rdfs:label "esserci dell'essere"@it, "the being-there of being"@en, "adesse ipsius esse"@la ;
    rdfs:comment "Dimensione che il passo chiede di indicare nel tematizzare l'essere; espressione lasciata aperta."@it, "A dimension to be indicated when being becomes the theme of inquiry. The expression remains open."@en, "Ratio indicanda cum esse ipsum fit argumentum inquisitionis. Locutio aperta manet."@la .

dub:macchinaConcreta a dub:Concept ;
    rdfs:label "macchina concreta"@it, "concrete machine"@en, "machina concreta"@la ;
    rdfs:comment "Sistema effettivo a cui sono resi accessibili i significati organizzati."@it, "An actual system to which organised meanings are made accessible."@en, "Systema re ipsa exsistens cui significationes ordinatae patefiunt."@la .

dub:strutturaConoscenzaOntica a dub:Concept ;
    rdfs:label "struttura di conoscenza ontica"@it, "structure of ontic knowledge"@en, "structura cognitionis onticae"@la ;
    rdfs:comment "Strumento esplicito con cui si organizza il capitale semantico."@it, "An explicit means of organising semantic capital."@en, "Instrumentum explicitum quo capitale semanticum ordinatur."@la .

dub:ontologiaInformatica a dub:Concept ;
    rdfs:label "ontologia informatica"@it, "computational ontology"@en, "ontologia informatica"@la ;
    rdfs:comment "Specificazione formale ed esplicita di una concettualizzazione condivisa."@it, "A formal and explicit specification of a shared conceptualisation."@en, "Specificatio formalis et explicita ordinationis conceptuum communis."@la .

dub:specificazione a dub:Concept ;
    rdfs:label "specificazione"@it, "specification"@en, "specificatio"@la ;
    rdfs:comment "Espressione formale ed esplicita della concettualizzazione."@it, "Formal and explicit expression of the conceptualisation."@en, "Expressio formalis et explicita ordinationis conceptuum."@la .

dub:formalita a dub:Concept ;
    rdfs:label "formalità"@it, "formality"@en, "ratio formalis"@la ;
    rdfs:comment "Carattere della specificazione relativo alla forma dichiarata."@it, "The character of the specification with respect to its stated form."@en, "Ratio specificationis quoad formam declaratam."@la .

dub:esplicitezza a dub:Concept ;
    rdfs:label "esplicitezza"@it, "explicitness"@en, "ratio explicita"@la ;
    rdfs:comment "Carattere della specificazione dichiarata."@it, "The character of a specification that is made explicit."@en, "Ratio specificationis quae explicite declaratur."@la .

dub:concettualizzazione a dub:Concept ;
    rdfs:label "concettualizzazione"@it, "conceptualisation"@en, "conceptuum ordinatio"@la ;
    rdfs:comment "Assetto concettuale reso condiviso e specificato dall'ontologia informatica."@it, "The conceptual arrangement made shared and specified by computational ontology."@en, "Ordinatio conceptuum communis reddita et ontologia informatica specificata."@la .

dub:condivisione a dub:Concept ;
    rdfs:label "condivisione"@it, "shared character"@en, "communicatio"@la ;
    rdfs:comment "Condizione intersoggettiva attribuita alla concettualizzazione."@it, "The intersubjective condition ascribed to the conceptualisation."@en, "Condicio inter subiecta ordinationi conceptuum attributa."@la .

dub:trasmissibilita a dub:Concept ;
    rdfs:label "possibilità di veicolare contenuti"@it, "capacity to convey content"@en, "facultas materiam tradendi"@la ;
    rdfs:comment "Oggetto riflessivo dell'ontologia informatica."@it, "What computational ontology reflects on in the act of conveying content."@en, "Id de quo ontologia informatica in materia tradenda reflectit."@la .

dub:trasmissibilitaGenerale a dub:Concept ;
    rdfs:label "trasmissibilità generale"@it, "general conveyability"@en, "facultas tradendi generalis"@la ;
    rdfs:comment "Possibilità riferita a qualsiasi contenuto entro un ambito."@it, "A possibility considered for any content within a domain."@en, "Possibilitas ad quamlibet materiam intra certum ambitum relata."@la .

dub:trasmissibilitaDeterminata a dub:Concept ;
    rdfs:label "trasmissibilità determinata"@it, "determinate conveyability"@en, "facultas tradendi determinata"@la ;
    rdfs:comment "Possibilità riferita a un contenuto esatto."@it, "A possibility considered for one exact piece of content."@en, "Possibilitas ad unam materiam definitam relata."@la .

dub:ontologiaAnalitica a dub:Concept ;
    rdfs:label "ontologia filosofico-analitica"@it, "analytic philosophical ontology"@en, "ontologia philosophica analytica"@la ;
    rdfs:comment "Indagine su che cosa c'è e sui tipi di entità, rilevante per contenuto e forma dell'implementazione."@it, "Inquiry into what there is and the kinds of entities, bearing on the content and form of implementation."@en, "Inquisitio de iis quae sunt deque generibus entium, quae ad materiam formamque exsecutionis pertinet."@la .

dub:orientamentoOggetti a dub:Concept ;
    rdfs:label "orientamento agli oggetti"@it, "object-oriented inquiry"@en, "inquisitio ad obiecta directa"@la ;
    rdfs:comment "Variante dell'indagine analitica menzionata dal manifesto."@it, "A variant of analytic inquiry mentioned by the manifesto."@en, "Species inquisitionis analyticae quam prooemium commemorat."@la .

dub:orientamentoIperoggetti a dub:Concept ;
    rdfs:label "orientamento agli iperoggetti"@it, "hyperobject-oriented inquiry"@en, "inquisitio ad hyperobiecta directa"@la ;
    rdfs:comment "Variante analitica menzionata senza una definizione degli iperoggetti."@it, "An analytic variant mentioned without a definition of hyperobjects."@en, "Species analytica commemorata sine definitione hyperobiectorum."@la .

dub:implementazione a dub:Concept ;
    rdfs:label "implementazione informatica"@it, "computational implementation"@en, "exsecutio informatica"@la ;
    rdfs:comment "Realizzazione in cui il contributo analitico può essere esplicito o implicito."@it, "A realisation in which the analytic contribution can be explicit or implicit."@en, "Exsecutio in qua adiumentum analyticum explicitum vel implicitum esse potest."@la .

dub:teoria a dub:Concept ;
    rdfs:label "teoria"@it, "theory"@en, "theoria"@la ;
    rdfs:comment "Contesto entro cui enunciati, variabili e valori diventano pertinenti alla quantificazione."@it, "A context in which statements, variables and values matter for quantification."@en, "Contextus in quo enuntiata, variabilia et valores ad quantificationem pertinent."@la .

dub:enunciato a dub:Concept ;
    rdfs:label "enunciato"@it, "statement"@en, "enuntiatum"@la ;
    rdfs:comment "Espressione di una teoria che contiene o usa variabili vincolate."@it, "An expression of a theory that contains or uses bound variables."@en, "Expressio theoriae quae variabilia ligata continet aut adhibet."@la .

dub:variabileVincolata a dub:Concept ;
    rdfs:label "variabile vincolata"@it, "bound variable"@en, "variabile ligatum"@la ;
    rdfs:comment "Variabile il cui legame con un quantificatore è circoscritto alla teoria e all'enunciato."@it, "A variable whose binding by a quantifier is scoped to the theory and statement."@en, "Variabile cuius ligatio per quantificatorem ambitu theoriae et enuntiati continetur."@la .

dub:valoreVariabile a dub:Concept ;
    rdfs:label "valore di una variabile"@it, "value of a variable"@en, "valor variabilis"@la ;
    rdfs:comment "Valore ammissibile rispetto a un'assegnazione e a un dominio."@it, "A value admissible with respect to an assignment and a domain."@en, "Valor ad attributionem et ambitum admissus."@la .

dub:tipoEntita a dub:Concept ;
    rdfs:label "tipo di entità"@it, "type of entity"@en, "genus entis"@la ;
    rdfs:comment "Tipo che l'indagine analitica distingue nel proprio dominio."@it, "A kind that analytic inquiry distinguishes in its domain."@en, "Genus quod inquisitio analytica in suo ambitu distinguit."@la .

dub:ontologiaFenomenologica a dub:Concept ;
    rdfs:label "ontologia fenomenologica"@it, "phenomenological ontology"@en, "ontologia phaenomenologica"@la ;
    rdfs:comment "Indagine articolata in dimensione formale e regionale."@it, "Inquiry articulated into formal and regional dimensions."@en, "Inquisitio in rationem formalem et regionalem articulata."@la .

dub:ontologiaFormale a dub:Concept ;
    rdfs:label "ontologia formale fenomenologica"@it, "formal phenomenological ontology"@en, "ontologia phaenomenologica formalis"@la ;
    rdfs:comment "Indagine sulle strutture logiche valide per l'oggetto in generale."@it, "Inquiry into logical structures that apply to an object in general."@en, "Inquisitio structurarum logicarum quae de obiecto in genere valent."@la .

dub:ontologiaRegionale a dub:Concept ;
    rdfs:label "ontologia regionale"@it, "regional ontology"@en, "ontologia regionalis"@la ;
    rdfs:comment "Indagine sulle essenze e sui modi di possibilità propri di una regione."@it, "Inquiry into essences and modes of possibility proper to a region."@en, "Inquisitio essentiarum et modorum possibilitatis propriorum regionis."@la .

dub:oggettoGenerale a dub:Concept ;
    rdfs:label "oggetto in generale"@it, "object in general"@en, "obiectum in genere"@la ;
    rdfs:comment "Polo delle strutture valide formalmente per qualsiasi oggetto."@it, "The pole of structures that hold formally for any object."@en, "Id cui structurae formaliter de quolibet obiecto valentes referuntur."@la .

dub:strutturaLogica a dub:Concept ;
    rdfs:label "struttura logica"@it, "logical structure"@en, "structura logica"@la ;
    rdfs:comment "Struttura valida per l'oggetto in generale secondo l'indagine formale."@it, "A structure that holds for objects in general according to formal inquiry."@en, "Structura quae secundum inquisitionem formalem de obiectis in genere valet."@la .

dub:strutturaEnunciativa a dub:Concept ;
    rdfs:label "struttura enunciativa"@it, "structure of statements"@en, "structura enuntiativa"@la ;
    rdfs:comment "Forma di enunciazione dell'ontologia analitica indagata formalmente."@it, "The form of statements in analytic ontology as investigated formally."@en, "Forma enuntiationis ontologiae analyticae ratione formali investigata."@la .

dub:giudizio a dub:Concept ;
    rdfs:label "giudizio"@it, "judgement"@en, "iudicium"@la ;
    rdfs:comment "Nozione richiesta dall'indagine formale delle strutture enunciative."@it, "A notion required in the formal investigation of statement structures."@en, "Notio ad inquisitionem formalem structurarum enuntiativarum requisita."@la .

dub:regioneRealta a dub:Concept ;
    rdfs:label "regione della realtà"@it, "region of reality"@en, "regio realitatis"@la ;
    rdfs:comment "Campo di realtà per cui l'usiologia fissa caratteri specifici."@it, "A field of reality whose specific features are established by inquiry into essences."@en, "Pars realitatis cuius proprietates usiologia constituit."@la .

dub:usiologia a dub:Concept ;
    rdfs:label "usiologia"@it, "study of regional essences"@en, "usiologia"@la ;
    rdfs:comment "Indagine delle essenze specifiche proprie delle regioni."@it, "Inquiry into the specific essences of regions."@en, "Inquisitio essentiarum propriarum regionum."@la .

dub:essenzaRegionale a dub:Concept ;
    rdfs:label "essenza regionale"@it, "regional essence"@en, "essentia regionalis"@la ;
    rdfs:comment "Essenza specifica che qualifica una regione."@it, "A specific essence that characterises a region."@en, "Essentia propria qua regio determinatur."@la .

dub:modoPossibilitaEntita a dub:Concept ;
    rdfs:label "modo di possibilità di un'entità"@it, "mode of possibility of an entity"@en, "modus quo ens possibile est"@la ;
    rdfs:comment "Come è possibile essere un'entità in una regione."@it, "How it is possible to be an entity in a region."@en, "Quomodo in regione ens esse possit."@la .

dub:modoPossibilitaEssere a dub:Concept ;
    rdfs:label "modo di possibilità dell'essere"@it, "mode of possibility of being"@en, "modus quo esse possibile est"@la ;
    rdfs:comment "Dimensione che il manifesto chiede di esplicitare nella tematizzazione dell'essere."@it, "A dimension to be made explicit when being is taken as the theme."@en, "Ratio explicanda cum esse ipsum pro argumento sumitur."@la .

dub:ambitoOggettuale a dub:Concept ;
    rdfs:label "ambito oggettuale"@it, "domain of objects"@en, "ambitus obiectorum"@la ;
    rdfs:comment "Dominio aperto fenomenologicamente a partire dalle determinazioni regionali."@it, "A domain opened phenomenologically on the basis of regional determinations."@en, "Ambitus phaenomenologice apertus ex determinationibus regionalibus."@la .

dub:aperturaFenomenologica a dub:Concept ;
    rdfs:label "apertura fenomenologica"@it, "phenomenological opening"@en, "apertio phaenomenologica"@la ;
    rdfs:comment "Apertura dell'ambito che rende circoscrivibile una quantificazione."@it, "The opening of a domain that lets quantification be delimited."@en, "Apertio ambitus qua quantificatio circumscribi potest."@la .

dub:metafisicaOccidentale a dub:Concept ;
    rdfs:label "metafisica occidentale"@it, "Western metaphysics"@en, "metaphysica occidentalis"@la ;
    rdfs:comment "Criteri e metodi attribuiti alle ontologie dell'ente."@it, "Criteria and methods ascribed to ontologies of entities."@en, "Normae et methodi ontologiis entium attributae."@la .

dub:ontologiaEnte a dub:Concept ;
    rdfs:label "ontologia dell'ente"@it, "ontology of entities"@en, "ontologia entium"@la ;
    rdfs:comment "Indagine dell'ente in quanto ente e dell'essere in quanto essere di un ente."@it, "Inquiry into entities as entities and being as the being of an entity."@en, "Inquisitio de ente quatenus ens est deque esse ut esse entis."@la .

dub:ente a dub:Concept ;
    rdfs:label "ente o entità"@it, "entity or being"@en, "ens"@la ;
    rdfs:comment "Ciò che viene indagato secondo diversi sensi e diversi ambiti."@it, "What is investigated under different senses and within different domains."@en, "Id quod variis sensibus in variis ambitibus investigatur."@la .

dub:enteComeCosa a dub:Concept ;
    rdfs:label "ente in quanto ente, come cosa"@it, "entity as entity, considered as a thing"@en, "ens quatenus ens ut res"@la ;
    rdfs:comment "Ente trattato in senso ontologico dalle ontologie metafisiche."@it, "An entity treated as a thing in the ontological approach of metaphysics."@en, "Ens ut res ratione ontologica metaphysicae tractatum."@la .

dub:essere a dub:Concept ;
    rdfs:label "essere"@it, "being"@en, "esse"@la ;
    rdfs:comment "Tema del manifesto, distinto dalle specificazioni relative e fondamentali."@it, "The manifesto's theme, distinguished from its relational and fundamental formulations."@en, "Argumentum prooemii, cuius ratio relativa a ratione fundamentali distinguitur."@la .

dub:essereEntita a dub:Concept ;
    rdfs:label "essere un'entità"@it, "being an entity"@en, "esse ens"@la ;
    rdfs:comment "Che cosa significa contare come entità rispetto alla struttura formale."@it, "What it means to count as an entity with regard to formal structure."@en, "Quid significet pro ente haberi, habita ratione structurae formalis."@la .

dub:essereDiEnte a dub:Concept ;
    rdfs:label "essere di un ente"@it, "being of an entity"@en, "esse entis"@la ;
    rdfs:comment "Senso ontico dell'essere in relazione a qualcosa."@it, "The ontic sense of being in relation to something."@en, "Sensus onticus essendi ad aliquid relati."@la .

dub:essereInQuantoTale a dub:Concept ;
    rdfs:label "essere in quanto tale"@it, "being as such"@en, "esse ipsum"@la ;
    rdfs:comment "Tema problematico dell'ontologia fondamentale, indipendente dalla scelta di una cosa da indagare."@it, "The problematic theme of fundamental ontology, independent of selecting a thing to investigate."@en, "Argumentum difficile ontologiae fundamentalis, quod a re investiganda praeelecta non pendet."@la .

dub:essenzaEssere a dub:Concept ;
    rdfs:label "essenza dell'essere"@it, "essence of being"@en, "essentia essendi"@la ;
    rdfs:comment "Dimensione dell'essere tematizzata dalla ricerca posizionale."@it, "A dimension of being thematised by inquiry that poses the question."@en, "Ratio essendi quam inquisitio quaestionem ponens tractat."@la .

dub:concettualizzazioneEssere a dub:Concept ;
    rdfs:label "concettualizzazione dell'essere"@it, "conceptualisation of being"@en, "ordinatio conceptuum de esse"@la ;
    rdfs:comment "Articolazione concettuale da specificare formalmente nella trattazione ontologica dell'essere."@it, "A conceptual articulation to be formally specified in the ontological treatment of being."@en, "Articulatio conceptuum formaliter specificanda in tractatione ontologica essendi."@la .

dub:enteOntico a dub:Concept ;
    rdfs:label "ente onticamente inteso"@it, "entity understood ontically"@en, "ens ontice intellectum"@la ;
    rdfs:comment "Figura usata dal manifesto come referente-limite nella trattazione dell'essere."@it, "The figure the manifesto uses as a limiting reference in the inquiry into being."@en, "Figura qua prooemium utitur ut ad limen inquisitionis de esse referatur."@la .

dub:nulla a dub:Concept ;
    rdfs:label "nulla"@it, "nothing"@en, "nihil"@la ;
    rdfs:comment "Nome della figura-limite del passo; qui indica un senso da indagare."@it, "The name of the limiting figure in the passage, recorded as a sense to investigate."@en, "Nomen figurae limitaneae in hoc loco, ut sensus investigandus inscriptum."@la .

dub:assenzaCosa a dub:Concept ;
    rdfs:label "assenza di una cosa come oggetto"@it, "absence of a thing as object"@en, "absentia rei ut obiecti"@la ;
    rdfs:comment "Condizione di lettura della tematizzazione dell'essere in quanto tale."@it, "A condition on taking being as such as the theme."@en, "Condicio qua esse ipsum pro argumento sumitur."@la .

dub:ontologiaFondamentale a dub:Concept ;
    rdfs:label "ontologia fondamentale"@it, "fundamental ontology"@en, "ontologia fundamentalis"@la ;
    rdfs:comment "Ricerca di fondazione del senso delle ontologie dell'ente, lasciata inespressa nella sua totalità."@it, "Inquiry into the ground of the sense of ontologies of entities. The whole remains unexpressed."@en, "Inquisitio fundamenti sensus ontologiarum entium. Totalitas non exprimitur."@la .

dub:senso a dub:Concept ;
    rdfs:label "senso"@it, "sense"@en, "sensus"@la ;
    rdfs:comment "Ciò che si articola o dà intelligibilità in un contesto di ricerca."@it, "What can be articulated or lends intelligibility in a context of inquiry."@en, "Id quod articulatur aut in ambitu inquisitionis intellegibilitatem praebet."@la .

dub:sensoEssere a dub:Concept ;
    rdfs:label "senso dell'essere"@it, "sense of being"@en, "sensus essendi"@la ;
    rdfs:comment "Orizzonte interrogato che dà il filo conduttore alla ricerca."@it, "The horizon under inquiry which provides its guiding thread."@en, "Horizon investigatus qui inquisitioni filum quod ducit praebet."@la .

dub:totalitaInespressa a dub:Concept ;
    rdfs:label "totalità inespressa"@it, "unexpressed totality"@en, "totalitas non expressa"@la ;
    rdfs:comment "Carattere dell'ontologia fondamentale motivato dal suo oggetto problematico."@it, "A feature of fundamental ontology motivated by its problematic theme."@en, "Ratio ontologiae fundamentalis difficultate argumenti inducta."@la .

dub:ricercaFondamentale a dub:Concept ;
    rdfs:label "ricerca ontologica fondamentale"@it, "fundamental ontological inquiry"@en, "inquisitio ontologica fundamentalis"@la ;
    rdfs:comment "Sviluppo posizionale del problema dell'essenza dell'essere."@it, "Inquiry that develops by posing the question of the essence of being."@en, "Inquisitio quae procedit quaestionem de essentia essendi ponendo."@la .

dub:ricercaOntologica a dub:Concept ;
    rdfs:label "ricerca ontologica"@it, "ontological inquiry"@en, "inquisitio ontologica"@la ;
    rdfs:comment "Insieme aperto di livelli e piani d'indagine attraversati dall'iperscrittura."@it, "An open collection of levels and planes traversed by hyperwriting."@en, "Collectio aperta graduum et planorum quae hyperscriptura percurrit."@la .

dub:livelloRicerca a dub:Concept ;
    rdfs:label "livello della ricerca"@it, "level of inquiry"@en, "gradus inquisitionis"@la ;
    rdfs:comment "Articolazione stratificata della ricerca ontologica."@it, "A layer in the articulation of ontological inquiry."@en, "Gradus in articulatione inquisitionis ontologicae."@la .

dub:pianoRicerca a dub:Concept ;
    rdfs:label "piano della ricerca"@it, "plane of inquiry"@en, "planum inquisitionis"@la ;
    rdfs:comment "Articolazione della ricerca che l'iperscrittura mette in rapporto con altre."@it, "An articulation of inquiry that hyperwriting connects with others."@en, "Planum inquisitionis quod hyperscriptura cum aliis conectit."@la .

dub:iperscritturaFondamentale a dub:Concept ;
    rdfs:label "iperscrittura della ricerca fondamentale"@it, "hyperwriting of fundamental inquiry"@en, "hyperscriptura inquisitionis fundamentalis"@la ;
    rdfs:comment "Pratica che raccorda livelli e piani lungo il problema del senso dell'essere."@it, "The practice of connecting levels and planes along the question of the sense of being."@en, "Exercitatio gradus et plana secundum quaestionem de sensu essendi conectendi."@la .

dub:progettoCripta a dub:Concept ;
    rdfs:label "progetto della Cripta"@it, "the Cripta project"@en, "propositum Cryptae"@la ;
    rdfs:comment "Progettazione dell'ipertesto e interrogazione del fondamento del proprio progettare."@it, "Planning the hypertext and questioning the ground of that very planning."@en, "Proiectio hypertextus et quaestio de fundamento ipsius proiciendi."@la .

dub:progettualita a dub:Concept ;
    rdfs:label "progettualità"@it, "projective character"@en, "ratio proiciendi"@la ;
    rdfs:comment "Dimensione dell'esistenza da tematizzare nel progetto."@it, "A dimension of existence to be thematised in the project."@en, "Ratio exsistentiae in proposito tractanda."@la .

dub:gettatezza a dub:Concept ;
    rdfs:label "gettatezza"@it, "thrownness"@en, "iectitas"@la ;
    rdfs:comment "Struttura determinabile che il progetto mette in rapporto con quattro figure."@it, "A determinable structure that the project connects to four figures."@en, "Structura determinabilis quam propositum cum quattuor figuris conectit."@la .

dub:oggettoGettatezza a dub:Concept ;
    rdfs:label "oggetto come determinazione della gettatezza"@it, "object as a determination of thrownness"@en, "obiectum ut determinatio iectitatis"@la ;
    rdfs:comment "Voce della pagina Progetto, distinta dall'oggetto in generale del manifesto."@it, "A term in the Project page, distinct from the manifesto's object in general."@en, "Vox paginae de Proposito, distincta ab obiecto in genere prooemii."@la .

dub:soggettoGettatezza a dub:Concept ;
    rdfs:label "soggetto come determinazione della gettatezza"@it, "subject as a determination of thrownness"@en, "subiectum ut determinatio iectitatis"@la ;
    rdfs:comment "Voce della pagina Progetto."@it, "A term on the Project page."@en, "Vox paginae de Proposito."@la .

dub:progettoGettatezza a dub:Concept ;
    rdfs:label "progetto come determinazione della gettatezza"@it, "projection as a determination of thrownness"@en, "proiectum ut determinatio iectitatis"@la ;
    rdfs:comment "Voce della pagina Progetto, distinta dal progetto particolare della Cripta."@it, "A term on the Project page, distinct from the particular Cripta project."@en, "Vox paginae de Proposito, distincta a singulari proposito Cryptae."@la .

dub:rigettoGettatezza a dub:Concept ;
    rdfs:label "rigetto come determinazione della gettatezza"@it, "rejection as a determination of thrownness"@en, "reiectum ut determinatio iectitatis"@la ;
    rdfs:comment "Voce della pagina Progetto."@it, "A term on the Project page."@en, "Vox paginae de Proposito."@la .

dub:fondamentoOntico a dub:Concept ;
    rdfs:label "fondamento ontico"@it, "ontic ground"@en, "fundamentum onticum"@la ;
    rdfs:comment "Condizione o occasione concreta della ricerca, distinta dalla fondazione di senso."@it, "A concrete condition or occasion for inquiry, distinct from grounding its sense."@en, "Condicio concreta vel occasio inquisitionis, a fundatione sensus distincta."@la .

dub:fondamentoOntologico a dub:Concept ;
    rdfs:label "fondamento ontologico"@it, "ontological ground"@en, "fundamentum ontologicum"@la ;
    rdfs:comment "Fondazione di senso o fondamento quanto alla propria essenza."@it, "The grounding of sense or the ground considered in its essence."@en, "Fundatio sensus aut fundamentum secundum essentiam suam."@la .

dub:mappaEnte a dub:Concept ;
    rdfs:label "mappa dell'Ente"@it, "map of entities"@en, "tabula entium"@la ;
    rdfs:comment "Orizzonte di un'ontologia analitica totale delineato dalla pagina Progetto."@it, "The horizon of a total analytic ontology outlined on the Project page."@en, "Horizon ontologiae analyticae totalis in pagina de Proposito delineatus."@la .

dub:articolo a dub:Concept ;
    rdfs:label "articolo come artefatto"@it, "article as an artefact"@en, "articulus ut artefactum"@la ;
    rdfs:comment "Articolazione consultabile di un'apertura di senso."@it, "A readable articulation of an opening of sense."@en, "Articulatio legibilis aperturae sensus."@la .

# EN: Positions contain symbolic readings. The associated arcs retain the scope of each position.
# LA: Sententiae lectiones symbolicas continent. Arcus adnexi ambitum cuiusque sententiae servant.

