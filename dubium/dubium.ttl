<https://criptasemantica.it/progetto/> a dub:Source ;
    rdfs:label "Progetto"@it, "Project"@en, "Propositum"@la .

dub:XProgetto a dub:Passage ;
    rdfs:label "Progettualità, gettatezza e fondazione"@it, "Projection, thrownness and grounding"@en, "Ratio proiciendi, iectitas et fundatio"@la ;
    dub:partOfSource <https://criptasemantica.it/progetto/> ;
    dub:locator "Pagina Progetto, capoversi sulla progettualità, sulle quattro determinazioni della gettatezza e sul sostegno ontico."@it, "Project page, paragraphs on projection, the four determinations of thrownness and ontic support."@en, "Pagina de Proposito, loci de ratione proiciendi, quattuor determinationibus iectitatis et sustentatione ontica."@la .

