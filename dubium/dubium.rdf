<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:dub="https://aenigma.criptasemantica.it/dubium#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:vann="http://purl.org/vocab/vann/"
>
  <dub:RelationAssertion rdf:about="https://aenigma.criptasemantica.it/dubium#F06-r01">
    <dub:belongsTo>
      <dub:Position rdf:about="https://aenigma.criptasemantica.it/dubium#F06">
        <rdfs:label xml:lang="it">La tradizione fino alla svolta</rdfs:label>
        <rdfs:label xml:lang="en">Tradition up to the turning point</rdfs:label>
        <rdfs:label xml:lang="la">Traditio usque ad discrimen</rdfs:label>
        <dub:derivedFrom rdf:resource="https://aenigma.criptasemantica.it/dubium#P2"/>
        <dub:status rdf:resource="https://aenigma.criptasemantica.it/dubium#Parafrasi"/>
        <dub:force rdf:resource="https://aenigma.criptasemantica.it/dubium#Storica"/>
        <dub:readingMode rdf:resource="https://aenigma.criptasemantica.it/dubium#Genealogica"/>
        <dub:formula>Tramanda(tradizioneTestuale,filosofia) ∧ Accresce(tradizioneTestuale,filosofia) ∧ Intervallo(tradizioneTestuale,esordioGreco,svolta1936) ∧ DataNelManifesto(svolta1936,1936,2689_AUC)</dub:formula>
      </dub:Position>
    </dub:belongsTo>
    <dub:subjectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#tradizioneTestuale">
        <rdfs:label xml:lang="it">tradizione testuale</rdfs:label>
        <rdfs:label xml:lang="en">textual tradition</rdfs:label>
        <rdfs:label xml:lang="la">traditio textualis</rdfs:label>
        <rdfs:comment xml:lang="it">Sequenza di scritti che tramandano e accrescono la filosofia.</rdfs:comment>
        <rdfs:comment xml:lang="en">A sequence of writings that transmits and extends philosophy.</rdfs:comment>
        <rdfs:comment xml:lang="la">Series scriptorum quae philosophiam tradit et auget.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">tradizione testuale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">textual tradition</skos:prefLabel>
        <skos:prefLabel xml:lang="la">traditio textualis</skos:prefLabel>
      </dub:Concept>
    </dub:subjectConcept>
    <dub:relationKind>
      <dub:RelationKind rdf:about="https://aenigma.criptasemantica.it/dubium#rel-tramanda">
        <rdfs:label xml:lang="it">tramanda</rdfs:label>
        <rdfs:label xml:lang="en">hands down</rdfs:label>
        <rdfs:label xml:lang="la">tradit</rdfs:label>
      </dub:RelationKind>
    </dub:relationKind>
    <dub:objectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#filosofia">
        <rdfs:label xml:lang="it">filosofia</rdfs:label>
        <rdfs:label xml:lang="en">philosophy</rdfs:label>
        <rdfs:label xml:lang="la">philosophia</rdfs:label>
        <rdfs:comment xml:lang="it">Corpo tradizionale del pensiero occidentale e disciplina originariamente orale.</rdfs:comment>
        <rdfs:comment xml:lang="en">The traditional body of Western thought and a discipline originally practised orally.</rdfs:comment>
        <rdfs:comment xml:lang="la">Corpus traditum cogitationis occidentalis atque disciplina primum ore exercita.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">filosofia</skos:prefLabel>
        <skos:prefLabel xml:lang="en">philosophy</skos:prefLabel>
        <skos:prefLabel xml:lang="la">philosophia</skos:prefLabel>
      </dub:Concept>
    </dub:objectConcept>
  </dub:RelationAssertion>
  <dub:RelationAssertion rdf:about="https://aenigma.criptasemantica.it/dubium#F35-r01">
    <dub:belongsTo>
      <dub:Position rdf:about="https://aenigma.criptasemantica.it/dubium#F35">
        <rdfs:label xml:lang="it">Cripta come ipertesto prodotto</rdfs:label>
        <rdfs:label xml:lang="en">Cripta as the resulting hypertext</rdfs:label>
        <rdfs:label xml:lang="la">Crypta ut hypertextus productus</rdfs:label>
        <dub:derivedFrom rdf:resource="https://aenigma.criptasemantica.it/dubium#P8"/>
        <dub:status rdf:resource="https://aenigma.criptasemantica.it/dubium#Parafrasi"/>
        <dub:force rdf:resource="https://aenigma.criptasemantica.it/dubium#Definizione"/>
        <dub:readingMode rdf:resource="https://aenigma.criptasemantica.it/dubium#Fondamentale"/>
        <dub:formula>Ipertesto(criptaIpertesto) ∧ Produce(iperscritturaFondamentale,criptaIpertesto)</dub:formula>
      </dub:Position>
    </dub:belongsTo>
    <dub:subjectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#criptaIpertesto">
        <rdfs:label xml:lang="it">Cripta Semantica come ipertesto</rdfs:label>
        <rdfs:label xml:lang="en">Cripta Semantica as hypertext</rdfs:label>
        <rdfs:label xml:lang="la">Crypta Semantica ut hypertextus</rdfs:label>
        <rdfs:comment xml:lang="it">Risultato aperto dell'iperscrittura della ricerca ontologica fondamentale.</rdfs:comment>
        <rdfs:comment xml:lang="en">The open result of hyperwriting in fundamental ontological inquiry.</rdfs:comment>
        <rdfs:comment xml:lang="la">Exitus apertus hyperscripturae inquisitionis ontologicae fundamentalis.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">Cripta Semantica come ipertesto</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Cripta Semantica as hypertext</skos:prefLabel>
        <skos:prefLabel xml:lang="la">Crypta Semantica ut hypertextus</skos:prefLabel>
      </dub:Concept>
    </dub:subjectConcept>
    <dub:relationKind>
      <dub:RelationKind rdf:about="https://aenigma.criptasemantica.it/dubium#rel-modoDi">
        <rdfs:label xml:lang="it">è un modo di</rdfs:label>
        <rdfs:label xml:lang="en">is a mode of</rdfs:label>
        <rdfs:label xml:lang="la">modus est</rdfs:label>
      </dub:RelationKind>
    </dub:relationKind>
    <dub:objectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#ipertesto">
        <rdfs:label xml:lang="it">ipertesto</rdfs:label>
        <rdfs:label xml:lang="en">hypertext</rdfs:label>
        <rdfs:label xml:lang="la">hypertextus</rdfs:label>
        <rdfs:comment xml:lang="it">Esito dell'iperscrittura e forma espositiva della quantificazione della scrittura.</rdfs:comment>
        <rdfs:comment xml:lang="en">The result of hyperwriting and the form in which writing's quantification becomes manifest.</rdfs:comment>
        <rdfs:comment xml:lang="la">Exitus hyperscripturae atque forma qua quantificatio scripturae apparet.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">ipertesto</skos:prefLabel>
        <skos:prefLabel xml:lang="en">hypertext</skos:prefLabel>
        <skos:prefLabel xml:lang="la">hypertextus</skos:prefLabel>
      </dub:Concept>
    </dub:objectConcept>
  </dub:RelationAssertion>
  <dub:RelationAssertion rdf:about="https://aenigma.criptasemantica.it/dubium#F34-r08">
    <dub:belongsTo>
      <dub:Position rdf:about="https://aenigma.criptasemantica.it/dubium#F34">
        <rdfs:label xml:lang="it">Iperscrittura e filo conduttore</rdfs:label>
        <rdfs:label xml:lang="en">Hyperwriting and its guiding thread</rdfs:label>
        <rdfs:label xml:lang="la">Hyperscriptura et filum dux</rdfs:label>
        <dub:derivedFrom rdf:resource="https://aenigma.criptasemantica.it/dubium#P8"/>
        <dub:status rdf:resource="https://aenigma.criptasemantica.it/dubium#Parafrasi"/>
        <dub:force rdf:resource="https://aenigma.criptasemantica.it/dubium#Normativa"/>
        <dub:readingMode rdf:resource="https://aenigma.criptasemantica.it/dubium#Fondamentale"/>
        <dub:formula>Oₘ Porre(problemaSensoEssere) ∧ Realizza(iperscritturaFondamentale,Porre(problemaSensoEssere)) ∧ ∀l,p [Pertinenti(l,p,ricercaOntologica) → PuòRaccordare(iperscritturaFondamentale,l,p;problemaSensoEssere)]</dub:formula>
      </dub:Position>
    </dub:belongsTo>
    <dub:subjectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#sensoEssere">
        <rdfs:label xml:lang="it">senso dell'essere</rdfs:label>
        <rdfs:label xml:lang="en">sense of being</rdfs:label>
        <rdfs:label xml:lang="la">sensus essendi</rdfs:label>
        <rdfs:comment xml:lang="it">Orizzonte interrogato che dà il filo conduttore alla ricerca.</rdfs:comment>
        <rdfs:comment xml:lang="en">The horizon under inquiry which provides its guiding thread.</rdfs:comment>
        <rdfs:comment xml:lang="la">Horizon investigatus qui inquisitioni filum quod ducit praebet.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">senso dell'essere</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sense of being</skos:prefLabel>
        <skos:prefLabel xml:lang="la">sensus essendi</skos:prefLabel>
      </dub:Concept>
    </dub:subjectConcept>
    <dub:relationKind>
      <dub:RelationKind rdf:about="https://aenigma.criptasemantica.it/dubium#rel-sensoDi">
        <rdfs:label xml:lang="it">è un senso di</rdfs:label>
        <rdfs:label xml:lang="en">is a sense of</rdfs:label>
        <rdfs:label xml:lang="la">sensus est</rdfs:label>
      </dub:RelationKind>
    </dub:relationKind>
    <dub:objectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#senso">
        <rdfs:label xml:lang="it">senso</rdfs:label>
        <rdfs:label xml:lang="en">sense</rdfs:label>
        <rdfs:label xml:lang="la">sensus</rdfs:label>
        <rdfs:comment xml:lang="it">Ciò che si articola o dà intelligibilità in un contesto di ricerca.</rdfs:comment>
        <rdfs:comment xml:lang="en">What can be articulated or lends intelligibility in a context of inquiry.</rdfs:comment>
        <rdfs:comment xml:lang="la">Id quod articulatur aut in ambitu inquisitionis intellegibilitatem praebet.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">senso</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sense</skos:prefLabel>
        <skos:prefLabel xml:lang="la">sensus</skos:prefLabel>
      </dub:Concept>
    </dub:objectConcept>
  </dub:RelationAssertion>
  <dub:RelationAssertion rdf:about="https://aenigma.criptasemantica.it/dubium#F05-r03">
    <dub:belongsTo>
      <dub:Position rdf:about="https://aenigma.criptasemantica.it/dubium#F05">
        <rdfs:label xml:lang="it">Fine ed effetto del dialogo</rdfs:label>
        <rdfs:label xml:lang="en">Aim and effect of dialogue</rdfs:label>
        <rdfs:label xml:lang="la">Finis et effectus dialogi</rdfs:label>
        <dub:derivedFrom rdf:resource="https://aenigma.criptasemantica.it/dubium#P1"/>
        <dub:status rdf:resource="https://aenigma.criptasemantica.it/dubium#Parafrasi"/>
        <dub:force rdf:resource="https://aenigma.criptasemantica.it/dubium#Genealogia"/>
        <dub:readingMode rdf:resource="https://aenigma.criptasemantica.it/dubium#Genealogica"/>
        <dub:formula>Fine(praticaDialogica, Reminiscenza(essere)) ∧ ∀a [Partecipa(a,praticaDialogica) → Effetto(praticaDialogica, ScienzaTrasformazione(Psiche(a)))]</dub:formula>
      </dub:Position>
    </dub:belongsTo>
    <dub:subjectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#praticaDialogica">
        <rdfs:label xml:lang="it">pratica dialogica</rdfs:label>
        <rdfs:label xml:lang="en">dialogical practice</rdfs:label>
        <rdfs:label xml:lang="la">exercitatio dialogica</rdfs:label>
        <rdfs:comment xml:lang="it">Esercizio condiviso volto alla reminiscenza dell'essere.</rdfs:comment>
        <rdfs:comment xml:lang="en">A shared exercise aimed at recollecting being.</rdfs:comment>
        <rdfs:comment xml:lang="la">Exercitatio communis ad reminiscendum esse directa.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">pratica dialogica</skos:prefLabel>
        <skos:prefLabel xml:lang="en">dialogical practice</skos:prefLabel>
        <skos:prefLabel xml:lang="la">exercitatio dialogica</skos:prefLabel>
      </dub:Concept>
    </dub:subjectConcept>
    <dub:relationKind>
      <dub:RelationKind rdf:about="https://aenigma.criptasemantica.it/dubium#rel-haEffetto">
        <rdfs:label xml:lang="it">ha per effetto</rdfs:label>
        <rdfs:label xml:lang="en">has as an effect</rdfs:label>
        <rdfs:label xml:lang="la">effectum habet</rdfs:label>
      </dub:RelationKind>
    </dub:relationKind>
    <dub:objectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#scienzaTrasformazione">
        <rdfs:label xml:lang="it">scienza come trasformazione</rdfs:label>
        <rdfs:label xml:lang="en">science as transformation</rdfs:label>
        <rdfs:label xml:lang="la">scientia ut transformatio</rdfs:label>
        <rdfs:comment xml:lang="it">Nome della trasformazione psichica prodotta dalla pratica nel passo.</rdfs:comment>
        <rdfs:comment xml:lang="en">The passage's name for the change in the psyche produced by the practice.</rdfs:comment>
        <rdfs:comment xml:lang="la">Nomen quo locus mutationem animi ab exercitatione effectam appellat.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">scienza come trasformazione</skos:prefLabel>
        <skos:prefLabel xml:lang="en">science as transformation</skos:prefLabel>
        <skos:prefLabel xml:lang="la">scientia ut transformatio</skos:prefLabel>
      </dub:Concept>
    </dub:objectConcept>
  </dub:RelationAssertion>
  <dub:RelationAssertion rdf:about="https://aenigma.criptasemantica.it/dubium#F26-r03">
    <dub:belongsTo>
      <dub:Position rdf:about="https://aenigma.criptasemantica.it/dubium#F26">
        <rdfs:label xml:lang="it">L'ente trattato ontologicamente nella metafisica</rdfs:label>
        <rdfs:label xml:lang="en">Metaphysics treats the entity ontologically</rdfs:label>
        <rdfs:label xml:lang="la">Metaphysica ens ontologice tractat</rdfs:label>
        <dub:derivedFrom rdf:resource="https://aenigma.criptasemantica.it/dubium#P7"/>
        <dub:status rdf:resource="https://aenigma.criptasemantica.it/dubium#Parafrasi"/>
        <dub:force rdf:resource="https://aenigma.criptasemantica.it/dubium#Definizione"/>
        <dub:readingMode rdf:resource="https://aenigma.criptasemantica.it/dubium#Metafisica"/>
        <dub:formula>∀o [(OFen(o) ∨ OAn(o) ∨ OInf(o)) → (Segue(o,metafisicaOccidentale) ∧ Tema(o,ente,OntologicoComeCosa))]</dub:formula>
      </dub:Position>
    </dub:belongsTo>
    <dub:subjectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#ontologiaInformatica">
        <rdfs:label xml:lang="it">ontologia informatica</rdfs:label>
        <rdfs:label xml:lang="en">computational ontology</rdfs:label>
        <rdfs:label xml:lang="la">ontologia informatica</rdfs:label>
        <rdfs:comment xml:lang="it">Specificazione formale ed esplicita di una concettualizzazione condivisa.</rdfs:comment>
        <rdfs:comment xml:lang="en">A formal and explicit specification of a shared conceptualisation.</rdfs:comment>
        <rdfs:comment xml:lang="la">Specificatio formalis et explicita ordinationis conceptuum communis.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">ontologia informatica</skos:prefLabel>
        <skos:prefLabel xml:lang="en">computational ontology</skos:prefLabel>
        <skos:prefLabel xml:lang="la">ontologia informatica</skos:prefLabel>
      </dub:Concept>
    </dub:subjectConcept>
    <dub:relationKind rdf:resource="https://aenigma.criptasemantica.it/dubium#rel-modoDi"/>
    <dub:objectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#ontologiaEnte">
        <rdfs:label xml:lang="it">ontologia dell'ente</rdfs:label>
        <rdfs:label xml:lang="en">ontology of entities</rdfs:label>
        <rdfs:label xml:lang="la">ontologia entium</rdfs:label>
        <rdfs:comment xml:lang="it">Indagine dell'ente in quanto ente e dell'essere in quanto essere di un ente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Inquiry into entities as entities and being as the being of an entity.</rdfs:comment>
        <rdfs:comment xml:lang="la">Inquisitio de ente quatenus ens est deque esse ut esse entis.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">ontologia dell'ente</skos:prefLabel>
        <skos:prefLabel xml:lang="en">ontology of entities</skos:prefLabel>
        <skos:prefLabel xml:lang="la">ontologia entium</skos:prefLabel>
      </dub:Concept>
    </dub:objectConcept>
  </dub:RelationAssertion>
  <dub:RelationAssertion rdf:about="https://aenigma.criptasemantica.it/dubium#F12-r05">
    <dub:belongsTo>
      <dub:Position rdf:about="https://aenigma.criptasemantica.it/dubium#F12">
        <rdfs:label xml:lang="it">Orientamento del Web</rdfs:label>
        <rdfs:label xml:lang="en">The orientation of the Web</rdfs:label>
        <rdfs:label xml:lang="la">Directio Retis</rdfs:label>
        <dub:derivedFrom rdf:resource="https://aenigma.criptasemantica.it/dubium#P3"/>
        <dub:status rdf:resource="https://aenigma.criptasemantica.it/dubium#Parafrasi"/>
        <dub:force rdf:resource="https://aenigma.criptasemantica.it/dubium#Funzionale"/>
        <dub:readingMode rdf:resource="https://aenigma.criptasemantica.it/dubium#Mediale"/>
        <dub:formula>SviluppoDi(sviluppoWeb,web) ∧ Fine(sviluppoWeb,Accumulare(capitaleSemantico)) ∧ Fine(sviluppoWeb,Distribuire(capitaleSemantico))</dub:formula>
      </dub:Position>
    </dub:belongsTo>
    <dub:subjectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#distribuzioneSemantica">
        <rdfs:label xml:lang="it">distribuzione di capitale semantico</rdfs:label>
        <rdfs:label xml:lang="en">distribution of semantic capital</rdfs:label>
        <rdfs:label xml:lang="la">distributio capitalis semantici</rdfs:label>
        <rdfs:comment xml:lang="it">Secondo orientamento attribuito allo sviluppo del Web.</rdfs:comment>
        <rdfs:comment xml:lang="en">The second orientation ascribed to the development of the Web.</rdfs:comment>
        <rdfs:comment xml:lang="la">Altera directio progressui Retis attributa.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">distribuzione di capitale semantico</skos:prefLabel>
        <skos:prefLabel xml:lang="en">distribution of semantic capital</skos:prefLabel>
        <skos:prefLabel xml:lang="la">distributio capitalis semantici</skos:prefLabel>
      </dub:Concept>
    </dub:subjectConcept>
    <dub:relationKind>
      <dub:RelationKind rdf:about="https://aenigma.criptasemantica.it/dubium#rel-riguarda">
        <rdfs:label xml:lang="it">riguarda</rdfs:label>
        <rdfs:label xml:lang="en">concerns</rdfs:label>
        <rdfs:label xml:lang="la">spectat ad</rdfs:label>
      </dub:RelationKind>
    </dub:relationKind>
    <dub:objectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#capitaleSemantico">
        <rdfs:label xml:lang="it">capitale semantico</rdfs:label>
        <rdfs:label xml:lang="en">semantic capital</rdfs:label>
        <rdfs:label xml:lang="la">capitale semanticum</rdfs:label>
        <rdfs:comment xml:lang="it">Risorsa costituita dall'organizzazione dei contenuti in significati accessibili a macchine.</rdfs:comment>
        <rdfs:comment xml:lang="en">A resource formed by organising content into meanings that machines can process.</rdfs:comment>
        <rdfs:comment xml:lang="la">Opes ex materia in significationes a machinis tractabiles ordinata constitutae.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">capitale semantico</skos:prefLabel>
        <skos:prefLabel xml:lang="en">semantic capital</skos:prefLabel>
        <skos:prefLabel xml:lang="la">capitale semanticum</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
      </dub:Concept>
    </dub:objectConcept>
  </dub:RelationAssertion>
  <owl:Ontology rdf:about="https://aenigma.criptasemantica.it/dubium#">
    <owl:versionIRI rdf:resource="https://aenigma.criptasemantica.it/dubium#v0.2.0"/>
    <owl:versionInfo>0.2.0</owl:versionInfo>
    <owl:priorVersion rdf:resource="https://aenigma.criptasemantica.it/dubium#v0.1.0-draft"/>
    <dcterms:isPartOf rdf:resource="https://aenigma.criptasemantica.it/aenigma#"/>
    <vann:preferredNamespacePrefix>dub</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://aenigma.criptasemantica.it/dubium#</vann:preferredNamespaceUri>
    <rdfs:label xml:lang="it">Dubium. Il manifesto della Cripta Semantica</rdfs:label>
    <rdfs:label xml:lang="en">Dubium. The Cripta Semantica manifesto</rdfs:label>
    <rdfs:label xml:lang="la">Dubium. Prooemium Cryptae Semanticae</rdfs:label>
    <dcterms:title xml:lang="it">Dubium. Il manifesto della Cripta Semantica</dcterms:title>
    <dcterms:title xml:lang="en">Dubium. The Cripta Semantica manifesto</dcterms:title>
    <dcterms:title xml:lang="la">Dubium. Prooemium Cryptae Semanticae</dcterms:title>
    <rdfs:comment xml:lang="it">Formalizzazione del manifesto pubblico. Ogni posizione rimanda al passo che la sostiene.</rdfs:comment>
    <rdfs:comment xml:lang="en">Formalisation of the public manifesto. Every position points to the passage that supports it.</rdfs:comment>
    <rdfs:comment xml:lang="la">Formalizatio prooemii publici. Quaeque sententia ad locum quo fulcitur remittit.</rdfs:comment>
    <dcterms:description xml:lang="it">Primo modulo di Aenigma. Concetti, posizioni, domande e passi del manifesto della Cripta Semantica, con provenienza esplicita, formule leggibili e allineamenti a SKOS, PROV-O e schema.org.</dcterms:description>
    <dcterms:description xml:lang="en">First module of Aenigma. Concepts, positions, questions and passages of the Cripta Semantica manifesto, with explicit provenance, readable formulas and alignments to SKOS, PROV-O and schema.org.</dcterms:description>
    <dcterms:description xml:lang="la">Prima pars Aenigmatis. Notiones, sententiae, quaestiones et loci prooemii Cryptae Semanticae, cum origine expressa, formulis legibilibus et consensione cum SKOS, PROV-O et schema.org.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:creator rdf:resource="https://criptasemantica.it/chi-siamo/finai/"/>
    <dcterms:creator rdf:resource="https://criptasemantica.it/chi-siamo/alessandro-sevardi/"/>
    <dcterms:publisher>
      <dub:Source rdf:about="https://criptasemantica.it/">
        <rdfs:label xml:lang="it">Manifesto della Cripta Semantica</rdfs:label>
        <rdfs:label xml:lang="en">Cripta Semantica manifesto</rdfs:label>
        <rdfs:label xml:lang="la">Prooemium Cryptae Semanticae</rdfs:label>
      </dub:Source>
    </dcterms:publisher>
    <dcterms:source rdf:resource="https://criptasemantica.it/"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-10</dcterms:issued>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-11</dcterms:modified>
    <dcterms:language>it</dcterms:language>
    <dcterms:language>en</dcterms:language>
    <dcterms:language>la</dcterms:language>
    <rdfs:seeAlso rdf:resource="https://github.com/FINAI-Is-Not-An-Influencer/Aenigma"/>
    <rdfs:seeAlso rdf:resource="https://github.com/FINAI-Is-Not-An-Influencer/Aenigma/wiki"/>
  </owl:Ontology>
  <dub:RelationAssertion rdf:about="https://aenigma.criptasemantica.it/dubium#F31-r01">
    <dub:belongsTo>
      <dub:Position rdf:about="https://aenigma.criptasemantica.it/dubium#F31">
        <rdfs:label xml:lang="it">Fondazione del senso delle ontologie dell'ente</rdfs:label>
        <rdfs:label xml:lang="en">Grounding the sense of ontologies of entities</rdfs:label>
        <rdfs:label xml:lang="la">Fundatio sensus ontologiarum entium</rdfs:label>
        <dub:derivedFrom rdf:resource="https://aenigma.criptasemantica.it/dubium#P8"/>
        <dub:status rdf:resource="https://aenigma.criptasemantica.it/dubium#Parafrasi"/>
        <dub:force rdf:resource="https://aenigma.criptasemantica.it/dubium#Fondazione"/>
        <dub:readingMode rdf:resource="https://aenigma.criptasemantica.it/dubium#Fondamentale"/>
        <dub:formula>∀o:OntologiaDellEnte [RiceveSensoDa(o,ontologiaFondamentale)]</dub:formula>
      </dub:Position>
    </dub:belongsTo>
    <dub:subjectConcept rdf:resource="https://aenigma.criptasemantica.it/dubium#ontologiaEnte"/>
    <dub:relationKind>
      <dub:RelationKind rdf:about="https://aenigma.criptasemantica.it/dubium#rel-riceveSensoDa">
        <rdfs:label xml:lang="it">riceve senso da</rdfs:label>
        <rdfs:label xml:lang="en">receives sense from</rdfs:label>
        <rdfs:label xml:lang="la">sensum accipit ab</rdfs:label>
      </dub:RelationKind>
    </dub:relationKind>
    <dub:objectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#ontologiaFondamentale">
        <rdfs:label xml:lang="it">ontologia fondamentale</rdfs:label>
        <rdfs:label xml:lang="en">fundamental ontology</rdfs:label>
        <rdfs:label xml:lang="la">ontologia fundamentalis</rdfs:label>
        <rdfs:comment xml:lang="it">Ricerca di fondazione del senso delle ontologie dell'ente, lasciata inespressa nella sua totalità.</rdfs:comment>
        <rdfs:comment xml:lang="en">Inquiry into the ground of the sense of ontologies of entities. The whole remains unexpressed.</rdfs:comment>
        <rdfs:comment xml:lang="la">Inquisitio fundamenti sensus ontologiarum entium. Totalitas non exprimitur.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">ontologia fondamentale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">fundamental ontology</skos:prefLabel>
        <skos:prefLabel xml:lang="la">ontologia fundamentalis</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
      </dub:Concept>
    </dub:objectConcept>
  </dub:RelationAssertion>
  <dub:RelationAssertion rdf:about="https://aenigma.criptasemantica.it/dubium#F27-r03">
    <dub:belongsTo>
      <dub:Position rdf:about="https://aenigma.criptasemantica.it/dubium#F27">
        <rdfs:label xml:lang="it">L'essere trattato onticamente nella metafisica</rdfs:label>
        <rdfs:label xml:lang="en">Metaphysics treats being ontically</rdfs:label>
        <rdfs:label xml:lang="la">Metaphysica esse ontice tractat</rdfs:label>
        <dub:derivedFrom rdf:resource="https://aenigma.criptasemantica.it/dubium#P7"/>
        <dub:status rdf:resource="https://aenigma.criptasemantica.it/dubium#Parafrasi"/>
        <dub:force rdf:resource="https://aenigma.criptasemantica.it/dubium#Definizione"/>
        <dub:readingMode rdf:resource="https://aenigma.criptasemantica.it/dubium#Ontica"/>
        <dub:formula>∀o:OntologiaDellEnte ∀b [TematizzaEssere(o,b) → ∃x∈D(o) [b=EssereDi(x) ∧ Tratta(o,b,OnticoRelativo)]]</dub:formula>
      </dub:Position>
    </dub:belongsTo>
    <dub:subjectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#essereDiEnte">
        <rdfs:label xml:lang="it">essere di un ente</rdfs:label>
        <rdfs:label xml:lang="en">being of an entity</rdfs:label>
        <rdfs:label xml:lang="la">esse entis</rdfs:label>
        <rdfs:comment xml:lang="it">Senso ontico dell'essere in relazione a qualcosa.</rdfs:comment>
        <rdfs:comment xml:lang="en">The ontic sense of being in relation to something.</rdfs:comment>
        <rdfs:comment xml:lang="la">Sensus onticus essendi ad aliquid relati.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">essere di un ente</skos:prefLabel>
        <skos:prefLabel xml:lang="en">being of an entity</skos:prefLabel>
        <skos:prefLabel xml:lang="la">esse entis</skos:prefLabel>
      </dub:Concept>
    </dub:subjectConcept>
    <dub:relationKind rdf:resource="https://aenigma.criptasemantica.it/dubium#rel-sensoDi"/>
    <dub:objectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#essere">
        <rdfs:label xml:lang="it">essere</rdfs:label>
        <rdfs:label xml:lang="en">being</rdfs:label>
        <rdfs:label xml:lang="la">esse</rdfs:label>
        <rdfs:comment xml:lang="it">Tema del manifesto, distinto dalle specificazioni relative e fondamentali.</rdfs:comment>
        <rdfs:comment xml:lang="en">The manifesto's theme, distinguished from its relational and fundamental formulations.</rdfs:comment>
        <rdfs:comment xml:lang="la">Argumentum prooemii, cuius ratio relativa a ratione fundamentali distinguitur.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">essere</skos:prefLabel>
        <skos:prefLabel xml:lang="en">being</skos:prefLabel>
        <skos:prefLabel xml:lang="la">esse</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
      </dub:Concept>
    </dub:objectConcept>
  </dub:RelationAssertion>
  <dub:RelationAssertion rdf:about="https://aenigma.criptasemantica.it/dubium#F14-r02">
    <dub:belongsTo>
      <dub:Position rdf:about="https://aenigma.criptasemantica.it/dubium#F14">
        <rdfs:label xml:lang="it">Specificazione formale, esplicita e condivisa</rdfs:label>
        <rdfs:label xml:lang="en">Formal, explicit and shared specification</rdfs:label>
        <rdfs:label xml:lang="la">Specificatio formalis, explicita et communis</rdfs:label>
        <dub:derivedFrom rdf:resource="https://aenigma.criptasemantica.it/dubium#P4"/>
        <dub:status rdf:resource="https://aenigma.criptasemantica.it/dubium#Parafrasi"/>
        <dub:force rdf:resource="https://aenigma.criptasemantica.it/dubium#Definizione"/>
        <dub:readingMode rdf:resource="https://aenigma.criptasemantica.it/dubium#Informatica"/>
        <dub:formula>OInf(o) ↔ ∃s,c [Specifica(o,s,c) ∧ Formale(s) ∧ Esplicita(s) ∧ Concettualizzazione(c) ∧ Condivisa(c)]</dub:formula>
      </dub:Position>
    </dub:belongsTo>
    <dub:subjectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#specificazione">
        <rdfs:label xml:lang="it">specificazione</rdfs:label>
        <rdfs:label xml:lang="en">specification</rdfs:label>
        <rdfs:label xml:lang="la">specificatio</rdfs:label>
        <rdfs:comment xml:lang="it">Espressione formale ed esplicita della concettualizzazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">Formal and explicit expression of the conceptualisation.</rdfs:comment>
        <rdfs:comment xml:lang="la">Expressio formalis et explicita ordinationis conceptuum.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">specificazione</skos:prefLabel>
        <skos:prefLabel xml:lang="en">specification</skos:prefLabel>
        <skos:prefLabel xml:lang="la">specificatio</skos:prefLabel>
      </dub:Concept>
    </dub:subjectConcept>
    <dub:relationKind>
      <dub:RelationKind rdf:about="https://aenigma.criptasemantica.it/dubium#rel-haCarattere">
        <rdfs:label xml:lang="it">ha carattere</rdfs:label>
        <rdfs:label xml:lang="en">has the character</rdfs:label>
        <rdfs:label xml:lang="la">rationem habet</rdfs:label>
      </dub:RelationKind>
    </dub:relationKind>
    <dub:objectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#formalita">
        <rdfs:label xml:lang="it">formalità</rdfs:label>
        <rdfs:label xml:lang="en">formality</rdfs:label>
        <rdfs:label xml:lang="la">ratio formalis</rdfs:label>
        <rdfs:comment xml:lang="it">Carattere della specificazione relativo alla forma dichiarata.</rdfs:comment>
        <rdfs:comment xml:lang="en">The character of the specification with respect to its stated form.</rdfs:comment>
        <rdfs:comment xml:lang="la">Ratio specificationis quoad formam declaratam.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">formalità</skos:prefLabel>
        <skos:prefLabel xml:lang="en">formality</skos:prefLabel>
        <skos:prefLabel xml:lang="la">ratio formalis</skos:prefLabel>
      </dub:Concept>
    </dub:objectConcept>
  </dub:RelationAssertion>
  <dub:RelationAssertion rdf:about="https://aenigma.criptasemantica.it/dubium#F29-r05">
    <dub:belongsTo>
      <dub:Position rdf:about="https://aenigma.criptasemantica.it/dubium#F29">
        <rdfs:label xml:lang="it">Quattro compiti della tematizzazione</rdfs:label>
        <rdfs:label xml:lang="en">Four tasks for the inquiry into being</rdfs:label>
        <rdfs:label xml:lang="la">Quattuor munera inquisitionis de esse</rdfs:label>
        <dub:derivedFrom rdf:resource="https://aenigma.criptasemantica.it/dubium#P7"/>
        <dub:status rdf:resource="https://aenigma.criptasemantica.it/dubium#Parafrasi"/>
        <dub:force rdf:resource="https://aenigma.criptasemantica.it/dubium#Normativa"/>
        <dub:readingMode rdf:resource="https://aenigma.criptasemantica.it/dubium#Fondamentale"/>
        <dub:formula>Oₘ [SpecificaFormalmente(concettualizzazioneEssere) ∧ Indica(esserciDellEssere) ∧ Esprime(essenzaEssere) ∧ Esplicita(ModoPossibilità(essereInQuantoTale))]</dub:formula>
      </dub:Position>
    </dub:belongsTo>
    <dub:subjectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#modoPossibilitaEssere">
        <rdfs:label xml:lang="it">modo di possibilità dell'essere</rdfs:label>
        <rdfs:label xml:lang="en">mode of possibility of being</rdfs:label>
        <rdfs:label xml:lang="la">modus quo esse possibile est</rdfs:label>
        <rdfs:comment xml:lang="it">Dimensione che il manifesto chiede di esplicitare nella tematizzazione dell'essere.</rdfs:comment>
        <rdfs:comment xml:lang="en">A dimension to be made explicit when being is taken as the theme.</rdfs:comment>
        <rdfs:comment xml:lang="la">Ratio explicanda cum esse ipsum pro argumento sumitur.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">modo di possibilità dell'essere</skos:prefLabel>
        <skos:prefLabel xml:lang="en">mode of possibility of being</skos:prefLabel>
        <skos:prefLabel xml:lang="la">modus quo esse possibile est</skos:prefLabel>
      </dub:Concept>
    </dub:subjectConcept>
    <dub:relationKind rdf:resource="https://aenigma.criptasemantica.it/dubium#rel-riguarda"/>
    <dub:objectConcept>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#essereInQuantoTale">
        <rdfs:label xml:lang="it">essere in quanto tale</rdfs:label>
        <rdfs:label xml:lang="en">being as such</rdfs:label>
        <rdfs:label xml:lang="la">esse ipsum</rdfs:label>
        <rdfs:comment xml:lang="it">Tema problematico dell'ontologia fondamentale, indipendente dalla scelta di una cosa da indagare.</rdfs:comment>
        <rdfs:comment xml:lang="en">The problematic theme of fundamental ontology, independent of selecting a thing to investigate.</rdfs:comment>
        <rdfs:comment xml:lang="la">Argumentum difficile ontologiae fundamentalis, quod a re investiganda praeelecta non pendet.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">essere in quanto tale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">being as such</skos:prefLabel>
        <skos:prefLabel xml:lang="la">esse ipsum</skos:prefLabel>
      </dub:Concept>
    </dub:objectConcept>
  </dub:RelationAssertion>
