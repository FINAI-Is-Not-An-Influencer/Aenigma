  <dub:Question rdf:about="https://aenigma.criptasemantica.it/dubium#Q04">
    <rdfs:label xml:lang="it">Come si può tematizzare l'essere senza assumere come oggetto una cosa?</rdfs:label>
    <rdfs:label xml:lang="en">How can we inquire into being without taking a thing as our object?</rdfs:label>
    <rdfs:label xml:lang="la">Quomodo esse investigari potest sine re pro obiecto sumpta?</rdfs:label>
    <dub:derivedFrom>
      <dub:Passage rdf:about="https://aenigma.criptasemantica.it/dubium#P7">
        <rdfs:label xml:lang="it">Ente, essere e nulla</rdfs:label>
        <rdfs:label xml:lang="en">Entity, being and nothing</rdfs:label>
        <rdfs:label xml:lang="la">Ens, esse et nihil</rdfs:label>
        <dub:partOfSource rdf:resource="https://criptasemantica.it/"/>
        <dub:locator xml:lang="it">Iperscrittura della ricerca ontologica, settimo capoverso.</dub:locator>
        <dub:locator xml:lang="en">Hyperwriting of ontological inquiry, seventh paragraph.</dub:locator>
        <dub:locator xml:lang="la">Hyperscriptura inquisitionis ontologicae, locus septimus.</dub:locator>
      </dub:Passage>
    </dub:derivedFrom>
    <dub:readingMode>
      <dub:ReadingMode rdf:about="https://aenigma.criptasemantica.it/dubium#Fondamentale">
        <rdfs:label xml:lang="it">ontologica riguardo all'essere in quanto tale</rdfs:label>
        <rdfs:label xml:lang="en">ontological with regard to being as such</rdfs:label>
        <rdfs:label xml:lang="la">ontologica quoad esse ipsum</rdfs:label>
      </dub:ReadingMode>
    </dub:readingMode>
    <dub:concerns rdf:resource="https://aenigma.criptasemantica.it/dubium#essereInQuantoTale"/>
    <dub:concerns>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#assenzaCosa">
        <rdfs:label xml:lang="it">assenza di una cosa come oggetto</rdfs:label>
        <rdfs:label xml:lang="en">absence of a thing as object</rdfs:label>
        <rdfs:label xml:lang="la">absentia rei ut obiecti</rdfs:label>
        <rdfs:comment xml:lang="it">Condizione di lettura della tematizzazione dell'essere in quanto tale.</rdfs:comment>
        <rdfs:comment xml:lang="en">A condition on taking being as such as the theme.</rdfs:comment>
        <rdfs:comment xml:lang="la">Condicio qua esse ipsum pro argumento sumitur.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">assenza di una cosa come oggetto</skos:prefLabel>
        <skos:prefLabel xml:lang="en">absence of a thing as object</skos:prefLabel>
        <skos:prefLabel xml:lang="la">absentia rei ut obiecti</skos:prefLabel>
      </dub:Concept>
    </dub:concerns>
    <dub:concerns rdf:resource="https://aenigma.criptasemantica.it/dubium#nulla"/>
  </dub:Question>
