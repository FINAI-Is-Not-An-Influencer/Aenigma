  <dub:Question rdf:about="https://aenigma.criptasemantica.it/dubium#Q01">
    <rdfs:label xml:lang="it">Che cosa intendiamo quando diciamo «essente»?</rdfs:label>
    <rdfs:label xml:lang="en">What do we mean when we say “being”?</rdfs:label>
    <rdfs:label xml:lang="la">Quid intellegimus cum dicimus «ens»?</rdfs:label>
    <dub:derivedFrom>
      <dub:Passage rdf:about="https://aenigma.criptasemantica.it/dubium#P0">
        <rdfs:label xml:lang="it">Titolo, sottotitolo ed epigrafe</rdfs:label>
        <rdfs:label xml:lang="en">Title, subtitle and epigraph</rdfs:label>
        <rdfs:label xml:lang="la">Titulus, subtitulus et epigraphe</rdfs:label>
        <dub:partOfSource rdf:resource="https://criptasemantica.it/"/>
        <dub:locator xml:lang="it">Titolo della homepage ed epigrafe da Platone, Sofista 244a, traduzione attribuita a Pietro Chiodi.</dub:locator>
        <dub:locator xml:lang="en">Homepage title and epigraph from Plato, Sophist 244a. The Italian rendering is attributed to Pietro Chiodi.</dub:locator>
        <dub:locator xml:lang="la">Titulus paginae primae et epigraphe e Platone, Sophista 244a. Versio Italica Petro Chiodi tribuitur.</dub:locator>
      </dub:Passage>
    </dub:derivedFrom>
    <dub:readingMode>
      <dub:ReadingMode rdf:about="https://aenigma.criptasemantica.it/dubium#Epigrafe">
        <rdfs:label xml:lang="it">uso di una parola e perplessità</rdfs:label>
        <rdfs:label xml:lang="en">use of a word and perplexity</rdfs:label>
        <rdfs:label xml:lang="la">usus vocis et perplexitas</rdfs:label>
      </dub:ReadingMode>
    </dub:readingMode>
    <dub:concerns>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#essenteEspressione">
        <rdfs:label xml:lang="it">«essente» come espressione</rdfs:label>
        <rdfs:label xml:lang="en">“being” as an expression</rdfs:label>
        <rdfs:label xml:lang="la">vox «ens»</rdfs:label>
        <rdfs:comment xml:lang="it">Parola il cui uso familiare diviene problematico nell'epigrafe.</rdfs:comment>
        <rdfs:comment xml:lang="en">A familiar word whose meaning becomes a problem in the epigraph.</rdfs:comment>
        <rdfs:comment xml:lang="la">Vox familiaris cuius significatio in epigraphe in quaestionem vocatur.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">«essente» come espressione</skos:prefLabel>
        <skos:prefLabel xml:lang="en">“being” as an expression</skos:prefLabel>
        <skos:prefLabel xml:lang="la">vox «ens»</skos:prefLabel>
      </dub:Concept>
    </dub:concerns>
    <dub:concerns>
      <dub:Concept rdf:about="https://aenigma.criptasemantica.it/dubium#perplessita">
        <rdfs:label xml:lang="it">perplessità</rdfs:label>
        <rdfs:label xml:lang="en">perplexity</rdfs:label>
        <rdfs:label xml:lang="la">perplexitas</rdfs:label>
        <rdfs:comment xml:lang="it">Esito interrogativo della perdita della comprensione presunta.</rdfs:comment>
        <rdfs:comment xml:lang="en">The questioning that results when presumed understanding gives way.</rdfs:comment>
        <rdfs:comment xml:lang="la">Dubitatio quae intellectu praesumpto sublato oritur.</rdfs:comment>
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/dubium#concetti"/>
        <skos:prefLabel xml:lang="it">perplessità</skos:prefLabel>
        <skos:prefLabel xml:lang="en">perplexity</skos:prefLabel>
        <skos:prefLabel xml:lang="la">perplexitas</skos:prefLabel>
      </dub:Concept>
    </dub:concerns>
  </dub:Question>
