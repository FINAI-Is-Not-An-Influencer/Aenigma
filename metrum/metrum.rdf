    <skos:prefLabel xml:lang="en">Reasoned replication outcome</skos:prefLabel>
    <skos:prefLabel xml:lang="la">Exitus replicationis argumentis munitus</skos:prefLabel>
    <rdfs:label xml:lang="it">Esito argomentato di replica</rdfs:label>
    <rdfs:label xml:lang="en">Reasoned replication outcome</rdfs:label>
    <rdfs:label xml:lang="la">Exitus replicationis argumentis munitus</rdfs:label>
    <mtr:family>
      <mtr:Family rdf:about="https://aenigma.criptasemantica.it/metrum#fam-metodo">
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/metrum#famiglie"/>
