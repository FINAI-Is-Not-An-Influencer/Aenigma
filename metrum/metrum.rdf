  <owl:Class rdf:about="https://aenigma.criptasemantica.it/metrum#ValueType">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="it">tipo di valore</rdfs:label>
    <rdfs:label xml:lang="en">value type</rdfs:label>
    <rdfs:label xml:lang="la">genus valoris</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://aenigma.criptasemantica.it/metrum#Principle">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="it">principio di valutazione responsabile</rdfs:label>
    <rdfs:label xml:lang="en">principle of responsible assessment</rdfs:label>
    <rdfs:label xml:lang="la">principium aestimationis responsabilis</rdfs:label>
    <rdfs:comment xml:lang="it">Enunciato citabile di una dichiarazione pubblica (DORA, Leiden, CoARA, FAIR, FORCE11, CRediT) che orienta o limita l'uso di un protocollo.</rdfs:comment>
    <rdfs:comment xml:lang="en">Citable statement of a public declaration (DORA, Leiden, CoARA, FAIR, FORCE11, CRediT) that guides or limits the use of a protocol.</rdfs:comment>
    <rdfs:comment xml:lang="la">Enuntiatum citabile declarationis publicae (DORA, Leiden, CoARA, FAIR, FORCE11, CRediT) quod usum protocolli dirigit vel finit.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://aenigma.criptasemantica.it/metrum#Coverage">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="it">copertura del corpus</rdfs:label>
    <rdfs:label xml:lang="en">corpus coverage</rdfs:label>
    <rdfs:label xml:lang="la">ambitus corporis</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://aenigma.criptasemantica.it/metrum#ResultState">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="it">stato del risultato</rdfs:label>
    <rdfs:label xml:lang="en">result state</rdfs:label>
    <rdfs:label xml:lang="la">status exitus</rdfs:label>
    <rdfs:comment xml:lang="it">Osservato, assente, soppresso o non applicabile. Un dato assente non vale zero.</rdfs:comment>
    <rdfs:comment xml:lang="en">Observed, missing, suppressed or not applicable. A missing value is not zero.</rdfs:comment>
    <rdfs:comment xml:lang="la">Observatum, absens, suppressum vel non applicabile. Datum absens non est nihil.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://aenigma.criptasemantica.it/metrum#Corpus">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="it">corpus dichiarato</rdfs:label>
    <rdfs:label xml:lang="en">declared corpus</rdfs:label>
    <rdfs:label xml:lang="la">corpus declaratum</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://aenigma.criptasemantica.it/metrum#Discipline">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="it">disciplina FORD</rdfs:label>
    <rdfs:label xml:lang="en">FORD field</rdfs:label>
    <rdfs:label xml:lang="la">disciplina FORD</rdfs:label>
    <rdfs:comment xml:lang="it">Campo di ricerca e sviluppo secondo il Manuale di Frascati 2015 (classificazione FORD). I codici organizzano il lavoro editoriale; non misurano il merito.</rdfs:comment>
    <rdfs:comment xml:lang="en">Field of research and development according to the Frascati Manual 2015 (FORD classification). Codes organise editorial work; they do not rate merit.</rdfs:comment>
    <rdfs:comment xml:lang="la">Campus investigationis secundum Manuale Frascati 2015 (classificatio FORD). Codices opus editorium ordinant; meritum non aestimant.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://aenigma.criptasemantica.it/metrum#Comparison">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="it">confronto fra osservazioni</rdfs:label>
    <rdfs:label xml:lang="en">comparison between observations</rdfs:label>
    <rdfs:label xml:lang="la">comparatio observationum</rdfs:label>
    <rdfs:comment xml:lang="it">Due osservazioni dello stesso soggetto sono confrontabili solo con lo stesso protocollo, la stessa unità, le stesse discipline, lo stesso periodo, lo stesso corpus e copertura dichiarata. La variazione è descrittiva.</rdfs:comment>
    <rdfs:comment xml:lang="en">Two observations of the same subject are comparable only with the same protocol, unit, fields, period, corpus and declared coverage. The variation is descriptive.</rdfs:comment>
    <rdfs:comment xml:lang="la">Duae observationes eiusdem subiecti comparari possunt solum eodem protocollo, eadem unitate, iisdem disciplinis, eodem tempore, eodem corpore et ambitu declarato. Variatio descriptiva est.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://aenigma.criptasemantica.it/metrum#Family">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="it">famiglia di protocolli</rdfs:label>
    <rdfs:label xml:lang="en">protocol family</rdfs:label>
    <rdfs:label xml:lang="la">familia protocollorum</rdfs:label>
  </owl:Class>
</rdf:RDF>
