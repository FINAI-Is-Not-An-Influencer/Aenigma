    <skos:prefLabel xml:lang="en">Data citations</skos:prefLabel>
    <skos:prefLabel xml:lang="la">Citationes datorum</skos:prefLabel>
    <rdfs:label xml:lang="it">Citazioni di dati</rdfs:label>
    <rdfs:label xml:lang="en">Data citations</rdfs:label>
    <rdfs:label xml:lang="la">Citationes datorum</rdfs:label>
    <mtr:family>
      <mtr:Family rdf:about="https://aenigma.criptasemantica.it/metrum#fam-dati">
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/metrum#famiglie"/>
        <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/metrum#famiglie"/>
