        <skos:notation>FAIR A</skos:notation>
        <rdfs:label xml:lang="it">Accessibile: protocolli aperti e metadati che restano anche senza i dati</rdfs:label>
        <rdfs:label xml:lang="en">Accessible: open protocols and metadata that outlive the data</rdfs:label>
        <rdfs:label xml:lang="la">Accessibile: protocolla aperta et notae quae data superstant</rdfs:label>
