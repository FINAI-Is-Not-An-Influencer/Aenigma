        <skos:notation>FAIR I</skos:notation>
        <rdfs:label xml:lang="it">Interoperabile: vocabolari formali e condivisi</rdfs:label>
        <rdfs:label xml:lang="en">Interoperable: formal, shared vocabularies</rdfs:label>
        <rdfs:label xml:lang="la">Interoperabile: lexica formalia et communia</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-fair-r">
        <dcterms:source rdf:resource="https://doi.org/10.1038/sdata.2016.18"/>
        <skos:notation>FAIR R</skos:notation>
        <rdfs:label xml:lang="it">Riusabile: licenza chiara, provenienza dettagliata, standard di comunità</rdfs:label>
        <rdfs:label xml:lang="en">Reusable: clear licence, detailed provenance, community standards</rdfs:label>
        <rdfs:label xml:lang="la">Iterum usurpabile: licentia perspicua, origo accurata, normae communitatis</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
