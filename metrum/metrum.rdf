        <rdfs:label xml:lang="en">Qualitative evidence</rdfs:label>
        <rdfs:label xml:lang="la">Testimonium qualitativum</rdfs:label>
      </mtr:ValueType>
    </mtr:valueType>
    <mtr:scope>
      <mtr:Scope rdf:about="https://aenigma.criptasemantica.it/metrum#scope-output">
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/metrum#valori"/>
        <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/metrum#valori"/>
        <skos:notation>output</skos:notation>
        <skos:prefLabel xml:lang="it">Prodotto della ricerca</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Research output</skos:prefLabel>
        <skos:prefLabel xml:lang="la">Fructus investigationis</skos:prefLabel>
        <rdfs:label xml:lang="it">Prodotto della ricerca</rdfs:label>
        <rdfs:label xml:lang="en">Research output</rdfs:label>
        <rdfs:label xml:lang="la">Fructus investigationis</rdfs:label>
      </mtr:Scope>
    </mtr:scope>
    <mtr:unit xml:lang="it">testo</mtr:unit>
    <mtr:unit xml:lang="en">text</mtr:unit>
    <mtr:unit xml:lang="la">textus</mtr:unit>
    <mtr:method xml:lang="it">Spiega accordi e differenze con il protocollo originale e le limitazioni.</mtr:method>
    <mtr:method xml:lang="en">Describe the argued outcome of a replication.</mtr:method>
    <mtr:method xml:lang="la">Exitum replicationis argumentis munitum describe.</mtr:method>
    <mtr:requiresReferenceSet rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mtr:requiresReferenceSet>
    <dcterms:source rdf:resource="https://coara.eu/agreement/the-agreement-full-text/"/>
    <mtr:guidedBy rdf:resource="https://aenigma.criptasemantica.it/metrum#principle-coara-1"/>
