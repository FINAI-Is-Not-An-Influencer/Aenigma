        <skos:prefLabel xml:lang="it">Metodo</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Method</skos:prefLabel>
        <skos:prefLabel xml:lang="la">Methodus</skos:prefLabel>
        <rdfs:label xml:lang="it">Metodo</rdfs:label>
        <rdfs:label xml:lang="en">Method</rdfs:label>
        <rdfs:label xml:lang="la">Methodus</rdfs:label>
        <skos:definition xml:lang="it">Repliche, preregistrazioni e descrizione dei contributi.</skos:definition>
        <skos:definition xml:lang="en">Replications, preregistrations and contribution descriptions.</skos:definition>
        <skos:definition xml:lang="la">Replicationes, praescriptiones et descriptio conlationum.</skos:definition>
      </mtr:Family>
    </mtr:family>
    <mtr:valueType>
