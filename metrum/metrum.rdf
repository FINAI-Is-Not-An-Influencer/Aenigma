    <dcterms:publisher rdf:resource="https://criptasemantica.it/"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-11</dcterms:issued>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-11</dcterms:modified>
    <dcterms:language>it</dcterms:language>
    <dcterms:language>en</dcterms:language>
    <dcterms:language>la</dcterms:language>
