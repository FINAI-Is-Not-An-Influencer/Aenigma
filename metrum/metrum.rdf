        <rdfs:label xml:lang="it">Dati</rdfs:label>
        <rdfs:label xml:lang="en">Data</rdfs:label>
        <rdfs:label xml:lang="la">Data</rdfs:label>
        <skos:definition xml:lang="it">Citazioni, riusi e contesto dei dati di ricerca.</skos:definition>
        <skos:definition xml:lang="en">Citations, reuses and context of research data.</skos:definition>
        <skos:definition xml:lang="la">Citationes, usus iterati et contextus datorum investigationis.</skos:definition>
      </mtr:Family>
    </mtr:family>
    <mtr:valueType rdf:resource="https://aenigma.criptasemantica.it/metrum#type-count"/>
    <mtr:scope>
      <mtr:Scope rdf:about="https://aenigma.criptasemantica.it/metrum#scope-data">
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/metrum#valori"/>
        <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/metrum#valori"/>
        <skos:notation>data</skos:notation>
        <skos:prefLabel xml:lang="it">Dati di ricerca</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Research data</skos:prefLabel>
        <skos:prefLabel xml:lang="la">Data investigationis</skos:prefLabel>
        <rdfs:label xml:lang="it">Dati di ricerca</rdfs:label>
        <rdfs:label xml:lang="en">Research data</rdfs:label>
        <rdfs:label xml:lang="la">Data investigationis</rdfs:label>
      </mtr:Scope>
    </mtr:scope>
    <mtr:unit xml:lang="it">citazioni</mtr:unit>
    <mtr:unit xml:lang="en">citations</mtr:unit>
    <mtr:unit xml:lang="la">citationes</mtr:unit>
    <mtr:method xml:lang="it">Conta citazioni a una versione di dataset e dichiara deduplicazione e copertura.</mtr:method>
    <mtr:method xml:lang="en">Count citations of the dataset that resolve to its identifier.</mtr:method>
    <mtr:method xml:lang="la">Citationes datorum quae ad indicem eorum resolvuntur numera.</mtr:method>
    <mtr:requiresReferenceSet rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mtr:requiresReferenceSet>
    <dcterms:source rdf:resource="https://force11.org/info/joint-declaration-of-data-citation-principles-final/"/>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-force11-1">
        <dcterms:source rdf:resource="https://force11.org/info/joint-declaration-of-data-citation-principles-final/"/>
        <skos:notation>FORCE11 1</skos:notation>
        <rdfs:label xml:lang="it">Importanza: i dati sono prodotti di ricerca legittimi e citabili</rdfs:label>
        <rdfs:label xml:lang="en">Importance: data are legitimate, citable products of research</rdfs:label>
        <rdfs:label xml:lang="la">Momentum: data sunt fructus investigationis legitimi et citabiles</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-force11-2">
        <dcterms:source rdf:resource="https://force11.org/info/joint-declaration-of-data-citation-principles-final/"/>
        <skos:notation>FORCE11 2</skos:notation>
        <rdfs:label xml:lang="it">Credito e attribuzione a chi ha contribuito ai dati</rdfs:label>
        <rdfs:label xml:lang="en">Credit and attribution to all contributors to the data</rdfs:label>
        <rdfs:label xml:lang="la">Laus et attributio omnibus qui data contulerunt</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-force11-3">
        <dcterms:source rdf:resource="https://force11.org/info/joint-declaration-of-data-citation-principles-final/"/>
        <skos:notation>FORCE11 3</skos:notation>
        <rdfs:label xml:lang="it">Evidenza: citare i dati su cui si fonda un'affermazione</rdfs:label>
        <rdfs:label xml:lang="en">Evidence: cite the data on which a claim relies</rdfs:label>
        <rdfs:label xml:lang="la">Testimonium: data cita quibus affirmatio nititur</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-force11-4">
        <dcterms:source rdf:resource="https://force11.org/info/joint-declaration-of-data-citation-principles-final/"/>
        <skos:notation>FORCE11 4</skos:notation>
        <rdfs:label xml:lang="it">Identificazione univoca e persistente</rdfs:label>
        <rdfs:label xml:lang="en">Unique and persistent identification</rdfs:label>
        <rdfs:label xml:lang="la">Designatio singularis et persistens</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-force11-5">
        <dcterms:source rdf:resource="https://force11.org/info/joint-declaration-of-data-citation-principles-final/"/>
        <skos:notation>FORCE11 5</skos:notation>
        <rdfs:label xml:lang="it">Accesso ai dati e ai metadati citati</rdfs:label>
        <rdfs:label xml:lang="en">Access to the cited data and metadata</rdfs:label>
        <rdfs:label xml:lang="la">Aditus ad data et notas citata</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-force11-6">
        <dcterms:source rdf:resource="https://force11.org/info/joint-declaration-of-data-citation-principles-final/"/>
        <skos:notation>FORCE11 6</skos:notation>
        <rdfs:label xml:lang="it">Persistenza degli identificatori e dei metadati oltre la vita dei dati</rdfs:label>
        <rdfs:label xml:lang="en">Persistence of identifiers and metadata beyond the data's lifespan</rdfs:label>
        <rdfs:label xml:lang="la">Persistentia indicum et notarum ultra vitam datorum</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-force11-7">
        <dcterms:source rdf:resource="https://force11.org/info/joint-declaration-of-data-citation-principles-final/"/>
        <skos:notation>FORCE11 7</skos:notation>
        <rdfs:label xml:lang="it">Specificità e verificabilità della porzione citata</rdfs:label>
        <rdfs:label xml:lang="en">Specificity and verifiability of the cited portion</rdfs:label>
        <rdfs:label xml:lang="la">Proprietas et probabilitas partis citatae</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-force11-8">
        <dcterms:source rdf:resource="https://force11.org/info/joint-declaration-of-data-citation-principles-final/"/>
        <skos:notation>FORCE11 8</skos:notation>
        <rdfs:label xml:lang="it">Interoperabilità e flessibilità fra comunità</rdfs:label>
        <rdfs:label xml:lang="en">Interoperability and flexibility across communities</rdfs:label>
        <rdfs:label xml:lang="la">Interoperabilitas et flexibilitas inter communitates</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
  </mtr:Protocol>
