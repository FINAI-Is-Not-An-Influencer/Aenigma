      </skos:ConceptScheme>
    </skos:inScheme>
    <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/metrum#protocolli"/>
    <skos:notation>citazioni-politiche</skos:notation>
    <skos:prefLabel xml:lang="it">Citazioni in documenti di policy</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Policy-document citations</skos:prefLabel>
    <skos:prefLabel xml:lang="la">Citationes in actis publicis</skos:prefLabel>
    <rdfs:label xml:lang="it">Citazioni in documenti di policy</rdfs:label>
    <rdfs:label xml:lang="en">Policy-document citations</rdfs:label>
    <rdfs:label xml:lang="la">Citationes in actis publicis</rdfs:label>
    <mtr:family>
      <mtr:Family rdf:about="https://aenigma.criptasemantica.it/metrum#fam-trasferimento">
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/metrum#famiglie"/>
        <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/metrum#famiglie"/>
        <skos:notation>trasferimento</skos:notation>
        <skos:prefLabel xml:lang="it">Trasferimento</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Transfer</skos:prefLabel>
        <skos:prefLabel xml:lang="la">Translatio</skos:prefLabel>
        <rdfs:label xml:lang="it">Trasferimento</rdfs:label>
        <rdfs:label xml:lang="en">Transfer</rdfs:label>
        <rdfs:label xml:lang="la">Translatio</rdfs:label>
        <skos:definition xml:lang="it">Riscontri dell'uso della ricerca fuori dall'accademia: policy, brevetti, adozioni.</skos:definition>
        <skos:definition xml:lang="en">Evidence of research use outside academia: policy, patents, adoptions.</skos:definition>
        <skos:definition xml:lang="la">Testimonia usus investigationis extra academiam: acta publica, diplomata, usus.</skos:definition>
      </mtr:Family>
    </mtr:family>
    <mtr:valueType>
      <mtr:ValueType rdf:about="https://aenigma.criptasemantica.it/metrum#type-count">
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/metrum#valori"/>
        <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/metrum#valori"/>
        <skos:notation>count</skos:notation>
        <mtr:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <skos:prefLabel xml:lang="it">Conteggio intero</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Integer count</skos:prefLabel>
        <skos:prefLabel xml:lang="la">Numerus integer</skos:prefLabel>
        <rdfs:label xml:lang="it">Conteggio intero</rdfs:label>
        <rdfs:label xml:lang="en">Integer count</rdfs:label>
        <rdfs:label xml:lang="la">Numerus integer</rdfs:label>
      </mtr:ValueType>
    </mtr:valueType>
    <mtr:scope>
      <mtr:Scope rdf:about="https://aenigma.criptasemantica.it/metrum#scope-work">
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/metrum#valori"/>
        <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/metrum#valori"/>
        <skos:notation>work</skos:notation>
        <skos:prefLabel xml:lang="it">Opera o edizione</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Work or edition</skos:prefLabel>
        <skos:prefLabel xml:lang="la">Opus vel editio</skos:prefLabel>
        <rdfs:label xml:lang="it">Opera o edizione</rdfs:label>
        <rdfs:label xml:lang="en">Work or edition</rdfs:label>
        <rdfs:label xml:lang="la">Opus vel editio</rdfs:label>
      </mtr:Scope>
    </mtr:scope>
    <mtr:unit xml:lang="it">documenti</mtr:unit>
    <mtr:unit xml:lang="en">documents</mtr:unit>
    <mtr:unit xml:lang="la">documenta</mtr:unit>
    <mtr:method xml:lang="it">Conta documenti di policy con un riferimento verificabile e dichiara la copertura.</mtr:method>
    <mtr:method xml:lang="en">Count citations in policy documents identified by the source.</mtr:method>
    <mtr:method xml:lang="la">Citationes in actis publicis a fonte designatis numera.</mtr:method>
    <mtr:requiresReferenceSet rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mtr:requiresReferenceSet>
    <dcterms:source rdf:resource="https://coara.eu/agreement/the-agreement-full-text/"/>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-coara-1">
        <dcterms:source rdf:resource="https://coara.eu/agreement/the-agreement-full-text/"/>
        <skos:notation>CoARA, impegno 1</skos:notation>
        <rdfs:label xml:lang="it">Riconoscere la diversità dei contributi e delle carriere nella ricerca</rdfs:label>
        <rdfs:label xml:lang="en">Recognise the diversity of contributions to, and careers in, research</rdfs:label>
        <rdfs:label xml:lang="la">Varietatem conlationum et cursuum in investigatione agnosce</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-coara-2">
        <dcterms:source rdf:resource="https://coara.eu/agreement/the-agreement-full-text/"/>
        <skos:notation>CoARA, impegno 2</skos:notation>
        <rdfs:label xml:lang="it">Fondare la valutazione sul giudizio qualitativo e sulla revisione fra pari, con indicatori usati responsabilmente</rdfs:label>
        <rdfs:label xml:lang="en">Base assessment primarily on qualitative evaluation with peer review, supported by responsible use of indicators</rdfs:label>
        <rdfs:label xml:lang="la">Aestimationem in iudicio qualitativo et recensione parium funda, indicibus responsabiliter adhibitis</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-coara-3">
        <dcterms:source rdf:resource="https://coara.eu/agreement/the-agreement-full-text/"/>
        <skos:notation>CoARA, impegno 3</skos:notation>
        <rdfs:label xml:lang="it">Abbandonare gli usi impropri delle metriche di rivista e di pubblicazione, come fattore d'impatto e indice h</rdfs:label>
        <rdfs:label xml:lang="en">Abandon inappropriate uses of journal- and publication-based metrics, such as the Journal Impact Factor and the h-index</rdfs:label>
        <rdfs:label xml:lang="la">Usus improprios indicum periodicorum et editionum, velut JIF et index h, relinque</rdfs:label>
        <mtr:cautions rdf:resource="https://aenigma.criptasemantica.it/metrum#p-jif"/>
        <mtr:cautions rdf:resource="https://aenigma.criptasemantica.it/metrum#p-h-index"/>
        <mtr:cautions rdf:resource="https://aenigma.criptasemantica.it/metrum#p-g-index"/>
        <mtr:cautions rdf:resource="https://aenigma.criptasemantica.it/metrum#p-i10-index"/>
        <mtr:cautions rdf:resource="https://aenigma.criptasemantica.it/metrum#p-m-index"/>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-coara-4">
        <dcterms:source rdf:resource="https://coara.eu/agreement/the-agreement-full-text/"/>
        <skos:notation>CoARA, impegno 4</skos:notation>
        <rdfs:label xml:lang="it">Evitare l'uso delle classifiche delle organizzazioni di ricerca nella valutazione</rdfs:label>
        <rdfs:label xml:lang="en">Avoid the use of rankings of research organisations in research assessment</rdfs:label>
        <rdfs:label xml:lang="la">Ordines institutionum investigationis in aestimatione ne adhibeas</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
  </mtr:Protocol>
  <mtr:Protocol rdf:about="https://aenigma.criptasemantica.it/metrum#p-fwci">
    <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/metrum#protocolli"/>
    <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/metrum#protocolli"/>
    <skos:notation>fwci</skos:notation>
    <skos:prefLabel xml:lang="it">Impatto citazionale normalizzato per campo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Field-weighted citation impact</skos:prefLabel>
    <skos:prefLabel xml:lang="la">Vis citationum ad disciplinam relata</skos:prefLabel>
    <rdfs:label xml:lang="it">Impatto citazionale normalizzato per campo</rdfs:label>
    <rdfs:label xml:lang="en">Field-weighted citation impact</rdfs:label>
    <rdfs:label xml:lang="la">Vis citationum ad disciplinam relata</rdfs:label>
    <mtr:family>
      <mtr:Family rdf:about="https://aenigma.criptasemantica.it/metrum#fam-ricezione">
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/metrum#famiglie"/>
        <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/metrum#famiglie"/>
        <skos:notation>ricezione</skos:notation>
        <skos:prefLabel xml:lang="it">Ricezione</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Reception</skos:prefLabel>
        <skos:prefLabel xml:lang="la">Receptio</skos:prefLabel>
        <rdfs:label xml:lang="it">Ricezione</rdfs:label>
        <rdfs:label xml:lang="en">Reception</rdfs:label>
        <rdfs:label xml:lang="la">Receptio</rdfs:label>
        <skos:definition xml:lang="it">Citazioni e riusi che una fonte attribuisce a un'opera o a un soggetto.</skos:definition>
        <skos:definition xml:lang="en">Citations and reuses that a source attributes to a work or an agent.</skos:definition>
        <skos:definition xml:lang="la">Citationes et usus iterati quos fons operi vel subiecto tribuit.</skos:definition>
      </mtr:Family>
    </mtr:family>
    <mtr:valueType>
      <mtr:ValueType rdf:about="https://aenigma.criptasemantica.it/metrum#type-decimal">
        <skos:inScheme rdf:resource="https://aenigma.criptasemantica.it/metrum#valori"/>
        <skos:topConceptOf rdf:resource="https://aenigma.criptasemantica.it/metrum#valori"/>
        <skos:notation>decimal</skos:notation>
        <mtr:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:prefLabel xml:lang="it">Decimale non negativo</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Non-negative decimal</skos:prefLabel>
        <skos:prefLabel xml:lang="la">Decimalis non negativus</skos:prefLabel>
        <rdfs:label xml:lang="it">Decimale non negativo</rdfs:label>
        <rdfs:label xml:lang="en">Non-negative decimal</rdfs:label>
        <rdfs:label xml:lang="la">Decimalis non negativus</rdfs:label>
      </mtr:ValueType>
    </mtr:valueType>
    <mtr:scope rdf:resource="https://aenigma.criptasemantica.it/metrum#scope-work"/>
    <mtr:unit xml:lang="it">rapporto</mtr:unit>
    <mtr:unit xml:lang="en">ratio</mtr:unit>
    <mtr:unit xml:lang="la">ratio</mtr:unit>
    <mtr:method xml:lang="it">Usa il valore del fornitore con gruppo di riferimento e versione del calcolo.</mtr:method>
    <mtr:method xml:lang="en">Use the provider's value with its reference group and computation version.</mtr:method>
    <mtr:method xml:lang="la">Valore praebitoris cum coetu comparando et versione computationis utere.</mtr:method>
    <mtr:requiresReferenceSet rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mtr:requiresReferenceSet>
    <dcterms:source rdf:resource="https://www.nature.com/articles/520429a"/>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-leiden-1">
        <dcterms:source rdf:resource="https://www.nature.com/articles/520429a"/>
        <skos:notation>Manifesto di Leiden 1</skos:notation>
        <rdfs:label xml:lang="it">La valutazione quantitativa sostiene il giudizio qualitativo degli esperti</rdfs:label>
        <rdfs:label xml:lang="en">Quantitative evaluation should support qualitative, expert assessment</rdfs:label>
        <rdfs:label xml:lang="la">Aestimatio quantitativa iudicium qualitativum peritorum sustineat</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-leiden-2">
        <dcterms:source rdf:resource="https://www.nature.com/articles/520429a"/>
        <skos:notation>Manifesto di Leiden 2</skos:notation>
        <rdfs:label xml:lang="it">Misurare rispetto alle missioni di ricerca dell'istituzione, del gruppo o della persona</rdfs:label>
        <rdfs:label xml:lang="en">Measure performance against the research missions of the institution, group or researcher</rdfs:label>
        <rdfs:label xml:lang="la">Opus ad missiones investigationis institutionis, coetus vel personae metire</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-leiden-3">
        <dcterms:source rdf:resource="https://www.nature.com/articles/520429a"/>
        <skos:notation>Manifesto di Leiden 3</skos:notation>
        <rdfs:label xml:lang="it">Proteggere l'eccellenza nella ricerca di rilevanza locale</rdfs:label>
        <rdfs:label xml:lang="en">Protect excellence in locally relevant research</rdfs:label>
        <rdfs:label xml:lang="la">Excellentiam investigationis localiter pertinentis tuere</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-leiden-4">
        <dcterms:source rdf:resource="https://www.nature.com/articles/520429a"/>
        <skos:notation>Manifesto di Leiden 4</skos:notation>
        <rdfs:label xml:lang="it">Tenere aperti, trasparenti e semplici raccolta dei dati e analisi</rdfs:label>
        <rdfs:label xml:lang="en">Keep data collection and analytical processes open, transparent and simple</rdfs:label>
        <rdfs:label xml:lang="la">Collectionem datorum et analysin apertas, perspicuas et simplices serva</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-leiden-5">
        <dcterms:source rdf:resource="https://www.nature.com/articles/520429a"/>
        <skos:notation>Manifesto di Leiden 5</skos:notation>
        <rdfs:label xml:lang="it">Permettere a chi è valutato di verificare dati e analisi</rdfs:label>
        <rdfs:label xml:lang="en">Allow those evaluated to verify data and analysis</rdfs:label>
        <rdfs:label xml:lang="la">Aestimatis data et analysin probare sine</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-leiden-6">
        <dcterms:source rdf:resource="https://www.nature.com/articles/520429a"/>
        <skos:notation>Manifesto di Leiden 6</skos:notation>
        <rdfs:label xml:lang="it">Tenere conto delle differenze fra campi nelle pratiche di pubblicazione e citazione</rdfs:label>
        <rdfs:label xml:lang="en">Account for variation by field in publication and citation practices</rdfs:label>
        <rdfs:label xml:lang="la">Varietatem disciplinarum in usu edendi et citandi respice</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-leiden-7">
        <dcterms:source rdf:resource="https://www.nature.com/articles/520429a"/>
        <skos:notation>Manifesto di Leiden 7</skos:notation>
        <rdfs:label xml:lang="it">Valutare le singole persone con un giudizio qualitativo del loro portafoglio</rdfs:label>
        <rdfs:label xml:lang="en">Base assessment of individual researchers on a qualitative judgement of their portfolio</rdfs:label>
        <rdfs:label xml:lang="la">Singulos investigatores iudicio qualitativo operum suorum aestima</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-leiden-8">
        <dcterms:source rdf:resource="https://www.nature.com/articles/520429a"/>
        <skos:notation>Manifesto di Leiden 8</skos:notation>
        <rdfs:label xml:lang="it">Evitare la concretezza fuori luogo e la falsa precisione</rdfs:label>
        <rdfs:label xml:lang="en">Avoid misplaced concreteness and false precision</rdfs:label>
        <rdfs:label xml:lang="la">Concretionem alienam et falsam subtilitatem vita</rdfs:label>
        <mtr:cautions rdf:resource="https://aenigma.criptasemantica.it/metrum#p-altmetric"/>
        <mtr:cautions rdf:resource="https://aenigma.criptasemantica.it/metrum#p-percentile"/>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-leiden-9">
        <dcterms:source rdf:resource="https://www.nature.com/articles/520429a"/>
        <skos:notation>Manifesto di Leiden 9</skos:notation>
        <rdfs:label xml:lang="it">Riconoscere gli effetti sistemici della valutazione e degli indicatori</rdfs:label>
        <rdfs:label xml:lang="en">Recognise the systemic effects of assessment and indicators</rdfs:label>
        <rdfs:label xml:lang="la">Effectus systematicos aestimationis et indicum agnosce</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
    <mtr:guidedBy>
      <mtr:Principle rdf:about="https://aenigma.criptasemantica.it/metrum#principle-leiden-10">
        <dcterms:source rdf:resource="https://www.nature.com/articles/520429a"/>
        <skos:notation>Manifesto di Leiden 10</skos:notation>
        <rdfs:label xml:lang="it">Esaminare regolarmente gli indicatori e aggiornarli</rdfs:label>
        <rdfs:label xml:lang="en">Scrutinise indicators regularly and update them</rdfs:label>
        <rdfs:label xml:lang="la">Indices identidem examina et renova</rdfs:label>
      </mtr:Principle>
    </mtr:guidedBy>
  </mtr:Protocol>
  <mtr:Protocol rdf:about="https://aenigma.criptasemantica.it/metrum#p-esito-replica">
