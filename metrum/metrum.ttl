# EN: Built-in protocols. The key is stable; a change of method takes a new version in the service, not a new IRI here.
# LA: Protocolla inclusa. Clavis stabilis est; methodo mutata ministerium versionem novam, non IRI novum hic, adhibet.
mtr:p-citazioni a mtr:Protocol ; skos:inScheme mtr:protocolli ; skos:topConceptOf mtr:protocolli ; skos:notation "citazioni" ;
    skos:prefLabel "Citazioni ricevute"@it, "Incoming citations"@en, "Citationes receptae"@la ;
    rdfs:label "Citazioni ricevute"@it, "Incoming citations"@en, "Citationes receptae"@la ;
    mtr:family mtr:fam-ricezione ; mtr:valueType mtr:type-count ;
    mtr:scope mtr:scope-work ;
    mtr:unit "citazioni"@it, "citations"@en, "citationes"@la ;
    mtr:method "Registra le citazioni che la fonte attribuisce all’opera nel corpus dichiarato."@it, "Count the citations that the source attributes to the work in the declared corpus."@en, "Citationes numera quas fons operi in corpore declarato tribuit."@la ;
    mtr:requiresReferenceSet false ;
    dcterms:source <https://sfdora.org/read/> ;
    mtr:guidedBy mtr:principle-dora .
