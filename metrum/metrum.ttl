@prefix mtr: <https://aenigma.criptasemantica.it/metrum#> .
@prefix dub: <https://aenigma.criptasemantica.it/dubium#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <https://aenigma.criptasemantica.it/metrum#> .

# EN: Metrum is the module of qualified measurement. It does not rank anyone: it records how a value was
#     obtained (protocol, corpus, period, coverage, source) so that readers can judge whether two values are comparable.
# LA: Metrum est pars mensurae qualificatae. Neminem ordinat: scribit quomodo valor obtentus sit (protocollum, corpus,
#     tempus, ambitus, fons), ut lectores iudicent num duo valores comparari possint.
# EN: This file is generated by tools/metrum_from_dictionary.py from metrum/fonti/. Edit the generator or the snapshot.
# LA: Haec tabula a tools/metrum_from_dictionary.py e metrum/fonti/ gignitur. Generatorem aut tabulam fontium muta.

<https://aenigma.criptasemantica.it/metrum#> a owl:Ontology ;
    owl:versionIRI <https://aenigma.criptasemantica.it/metrum#v0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dcterms:isPartOf <https://aenigma.criptasemantica.it/aenigma#> ;
    vann:preferredNamespacePrefix "mtr" ;
    vann:preferredNamespaceUri "https://aenigma.criptasemantica.it/metrum#" ;
    rdfs:label "Metrum. La misura qualificata della ricerca"@it, "Metrum. Qualified measurement of research"@en, "Metrum. Mensura investigationis qualificata"@la ;
    dcterms:title "Metrum. La misura qualificata della ricerca"@it, "Metrum. Qualified measurement of research"@en, "Metrum. Mensura investigationis qualificata"@la ;
    rdfs:comment "Terzo modulo di Aenigma. Osservazioni scientometriche con protocollo, corpus, periodo, copertura e fonte; discipline FORD; principi di valutazione responsabile; raccordo con la quantificazione della scrittura descritta nel manifesto."@it,
                 "Third module of Aenigma. Scientometric observations with protocol, corpus, period, coverage and source; FORD fields; principles of responsible assessment; a bridge to the quantification of writing described in the manifesto."@en,
                 "Tertia pars Aenigmatis. Observationes scientometricae cum protocollo, corpore, tempore, ambitu et fonte; disciplinae FORD; principia aestimationis responsabilis; nexus cum quantificatione scripturae in prooemio descripta."@la ;
    dcterms:description "Metrum rende dereferenziabile il vocabolario delle misure usato dal servizio semantico della Cripta: ogni protocollo, disciplina e principio ha un IRI pubblico, tre etichette e una fonte. Una misura è un ente del grafo, non un giudizio."@it,
                        "Metrum makes the measurement vocabulary of the Cripta semantic service dereferenceable: every protocol, field and principle has a public IRI, three labels and a source. A measure is an entity of the graph, not a verdict."@en,
                        "Metrum lexicon mensurarum a ministerio semantico Cryptae adhibitum reperibile reddit: quodque protocollum, disciplina et principium IRI publicum, tres titulos et fontem habet. Mensura est ens graphi, non iudicium."@la ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator <https://criptasemantica.it/chi-siamo/finai/>, <https://criptasemantica.it/chi-siamo/alessandro-sevardi/> ;
    dcterms:publisher <https://criptasemantica.it/> ;
    dcterms:issued "2026-11-11"^^xsd:date ;
    dcterms:modified "2026-11-11"^^xsd:date ;
    dcterms:language "it", "en", "la" ;
    dcterms:references dub:F08, dub:F19, dub:quantificazioneScrittura, dub:quantificazioneOntologica, dub:capitaleSemantico ;
    dcterms:source <https://doi.org/10.1787/9789264239012-en>, <https://sfdora.org/read/>, <https://www.nature.com/articles/520429a>, <https://coara.eu/agreement/the-agreement-full-text/> ;
    rdfs:seeAlso <https://github.com/FINAI-Is-Not-An-Influencer/Aenigma>, <https://criptasemantica.it/chi-siamo/> .

# EN: Classes. An observation is an entity with provenance; a protocol is a plan that can be applied again.
# LA: Classes. Observatio est ens cum origine; protocollum est consilium quod iterum adhiberi potest.
mtr:Observation a owl:Class ; rdfs:subClassOf prov:Entity, schema:Observation ;
    rdfs:label "osservazione qualificata"@it, "qualified observation"@en, "observatio qualificata"@la ;
    rdfs:comment "Una sola applicazione di un protocollo a un soggetto, in un corpus e in un periodo dichiarati, con copertura, stato del risultato e fonte."@it,
                 "One application of a protocol to a subject, within a declared corpus and period, with coverage, result state and source."@en,
                 "Una adhibitio protocolli ad subiectum, in corpore et tempore declaratis, cum ambitu, statu exitus et fonte."@la .
mtr:Protocol a owl:Class ; rdfs:subClassOf skos:Concept, prov:Plan ;
    rdfs:label "protocollo di misura"@it, "measurement protocol"@en, "protocollum mensurae"@la ;
    rdfs:comment "Contratto di misura: che cosa si conta o si descrive, con quale unità, su quali soggetti, secondo quale metodo e quale fonte."@it,
                 "Measurement contract: what is counted or described, in which unit, for which subjects, by which method and source."@en,
                 "Pactum mensurae: quid numeretur vel describatur, qua unitate, de quibus subiectis, qua methodo et quo fonte."@la .
mtr:Family a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "famiglia di protocolli"@it, "protocol family"@en, "familia protocollorum"@la .
mtr:Scope a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "ambito del soggetto"@it, "subject scope"@en, "ambitus subiecti"@la ;
    rdfs:comment "Il tipo di soggetto a cui un protocollo si applica. Una misura di rivista non si trasferisce a un autore."@it,
                 "The kind of subject a protocol applies to. A venue metric does not transfer to an author."@en,
                 "Genus subiecti ad quod protocollum pertinet. Mensura periodici ad auctorem non transfertur."@la .
mtr:ValueType a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "tipo di valore"@it, "value type"@en, "genus valoris"@la .
mtr:Coverage a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "copertura del corpus"@it, "corpus coverage"@en, "ambitus corporis"@la .
mtr:ResultState a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "stato del risultato"@it, "result state"@en, "status exitus"@la ;
    rdfs:comment "Osservato, assente, soppresso o non applicabile. Un dato assente non vale zero."@it,
                 "Observed, missing, suppressed or not applicable. A missing value is not zero."@en,
                 "Observatum, absens, suppressum vel non applicabile. Datum absens non est nihil."@la .
mtr:Discipline a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "disciplina FORD"@it, "FORD field"@en, "disciplina FORD"@la ;
    rdfs:comment "Campo di ricerca e sviluppo secondo il Manuale di Frascati 2015 (classificazione FORD). I codici organizzano il lavoro editoriale; non misurano il merito."@it,
                 "Field of research and development according to the Frascati Manual 2015 (FORD classification). Codes organise editorial work; they do not rate merit."@en,
                 "Campus investigationis secundum Manuale Frascati 2015 (classificatio FORD). Codices opus editorium ordinant; meritum non aestimant."@la .
mtr:Principle a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "principio di valutazione responsabile"@it, "principle of responsible assessment"@en, "principium aestimationis responsabilis"@la ;
    rdfs:comment "Enunciato citabile di una dichiarazione pubblica (DORA, Leiden, CoARA, FAIR, FORCE11, CRediT) che orienta o limita l'uso di un protocollo."@it,
                 "Citable statement of a public declaration (DORA, Leiden, CoARA, FAIR, FORCE11, CRediT) that guides or limits the use of a protocol."@en,
                 "Enuntiatum citabile declarationis publicae (DORA, Leiden, CoARA, FAIR, FORCE11, CRediT) quod usum protocolli dirigit vel finit."@la .
mtr:Corpus a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "corpus dichiarato"@it, "declared corpus"@en, "corpus declaratum"@la .
mtr:Comparison a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "confronto fra osservazioni"@it, "comparison between observations"@en, "comparatio observationum"@la ;
    rdfs:comment "Due osservazioni dello stesso soggetto sono confrontabili solo con lo stesso protocollo, la stessa unità, le stesse discipline, lo stesso periodo, lo stesso corpus e copertura dichiarata. La variazione è descrittiva."@it,
                 "Two observations of the same subject are comparable only with the same protocol, unit, fields, period, corpus and declared coverage. The variation is descriptive."@en,
                 "Duae observationes eiusdem subiecti comparari possunt solum eodem protocollo, eadem unitate, iisdem disciplinis, eodem tempore, eodem corpore et ambitu declarato. Variatio descriptiva est."@la .

[] a owl:AllDisjointClasses ;
    owl:members ( mtr:Observation mtr:Protocol mtr:Family mtr:Scope mtr:ValueType mtr:Coverage mtr:ResultState mtr:Discipline mtr:Principle mtr:Corpus mtr:Comparison ) .

# EN: Properties of an observation. Provenance properties specialise PROV-O; the subject link specialises schema.org.
# LA: Proprietates observationis. Proprietates originis PROV-O, nexus subiecti schema.org specificant.
mtr:protocol a owl:ObjectProperty ; rdfs:domain mtr:Observation ; rdfs:range mtr:Protocol ;
    rdfs:label "segue il protocollo"@it, "follows protocol"@en, "protocollum sequitur"@la .
mtr:about a owl:ObjectProperty ; rdfs:subPropertyOf schema:observationAbout ; rdfs:domain mtr:Observation ;
    rdfs:label "riguarda il soggetto"@it, "about subject"@en, "de subiecto"@la .
mtr:corpus a owl:ObjectProperty ; rdfs:domain mtr:Observation ; rdfs:range mtr:Corpus ;
    rdfs:label "nel corpus"@it, "within corpus"@en, "in corpore"@la .
mtr:corpusLabel a owl:DatatypeProperty ; rdfs:domain mtr:Observation ; rdfs:range xsd:string ;
    rdfs:label "descrizione del corpus"@it, "corpus description"@en, "descriptio corporis"@la .
mtr:periodStart a owl:DatatypeProperty ; rdfs:domain mtr:Observation ; rdfs:range xsd:date ;
    rdfs:label "inizio del periodo"@it, "period start"@en, "initium temporis"@la .
mtr:periodEnd a owl:DatatypeProperty ; rdfs:domain mtr:Observation ; rdfs:range xsd:date ;
    rdfs:label "fine del periodo"@it, "period end"@en, "finis temporis"@la .
mtr:acquiredOn a owl:DatatypeProperty ; rdfs:domain mtr:Observation ; rdfs:range xsd:date ;
    rdfs:label "data di acquisizione"@it, "acquisition date"@en, "dies acquisitionis"@la .
mtr:coverage a owl:ObjectProperty ; rdfs:domain mtr:Observation ; rdfs:range mtr:Coverage ;
    rdfs:label "copertura"@it, "coverage"@en, "ambitus"@la .
mtr:state a owl:ObjectProperty ; rdfs:domain mtr:Observation ; rdfs:range mtr:ResultState ;
    rdfs:label "stato del risultato"@it, "result state"@en, "status exitus"@la .
mtr:discipline a owl:ObjectProperty ; rdfs:domain mtr:Observation ; rdfs:range mtr:Discipline ;
    rdfs:label "disciplina"@it, "field"@en, "disciplina"@la .
mtr:source a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom ; rdfs:domain mtr:Observation ;
    rdfs:label "fonte del corpus"@it, "corpus source"@en, "fons corporis"@la .
mtr:evidence a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom ; rdfs:domain mtr:Observation ;
    rdfs:label "prova dell'osservazione"@it, "observation evidence"@en, "testimonium observationis"@la .
mtr:value a owl:DatatypeProperty ; rdfs:domain mtr:Observation ;
    rdfs:label "valore"@it, "value"@en, "valor"@la .
mtr:numerator a owl:DatatypeProperty ; rdfs:domain mtr:Observation ; rdfs:range xsd:integer ;
    rdfs:label "numeratore"@it, "numerator"@en, "numerator"@la .
mtr:denominator a owl:DatatypeProperty ; rdfs:domain mtr:Observation ; rdfs:range xsd:integer ;
    rdfs:label "denominatore"@it, "denominator"@en, "denominator"@la .
mtr:editorialReading a owl:DatatypeProperty ; rdfs:domain mtr:Observation ; rdfs:range xsd:string ;
    rdfs:label "lettura redazionale"@it, "editorial reading"@en, "lectio editoria"@la ;
    rdfs:comment "La lettura è distinta dal dato: dice che cosa la redazione ne ricava, non che cosa la fonte ha misurato."@it,
                 "The reading is distinct from the datum: it says what the editors draw from it, not what the source measured."@en,
                 "Lectio a dato distinguitur: dicit quid editores inde colligant, non quid fons mensus sit."@la .
mtr:appliedMethod a owl:DatatypeProperty ; rdfs:domain mtr:Observation ; rdfs:range xsd:string ;
    rdfs:label "metodo applicato"@it, "applied method"@en, "methodus adhibita"@la .

# EN: Properties of a protocol.
# LA: Proprietates protocolli.
mtr:family a owl:ObjectProperty ; rdfs:domain mtr:Protocol ; rdfs:range mtr:Family ;
    rdfs:label "famiglia"@it, "family"@en, "familia"@la .
mtr:scope a owl:ObjectProperty ; rdfs:domain mtr:Protocol ; rdfs:range mtr:Scope ;
    rdfs:label "si applica a"@it, "applies to"@en, "pertinet ad"@la .
mtr:valueType a owl:ObjectProperty ; rdfs:domain mtr:Protocol ; rdfs:range mtr:ValueType ;
    rdfs:label "tipo di valore"@it, "value type"@en, "genus valoris"@la .
mtr:unit a owl:DatatypeProperty ; rdfs:domain mtr:Protocol ; rdfs:range rdf:langString ;
    rdfs:label "unità"@it, "unit"@en, "unitas"@la .
mtr:method a owl:DatatypeProperty ; rdfs:domain mtr:Protocol ; rdfs:range rdf:langString ;
    rdfs:label "metodo"@it, "method"@en, "methodus"@la .
mtr:requiresReferenceSet a owl:DatatypeProperty ; rdfs:domain mtr:Protocol ; rdfs:range xsd:boolean ;
    rdfs:label "richiede un insieme di riferimento"@it, "requires a reference set"@en, "coetum comparandum requirit"@la .
mtr:guidedBy a owl:ObjectProperty ; rdfs:domain mtr:Protocol ; rdfs:range mtr:Principle ;
    rdfs:label "orientato dal principio"@it, "guided by principle"@en, "principio directum"@la .
mtr:cautions a owl:ObjectProperty ; rdfs:domain mtr:Principle ; rdfs:range mtr:Protocol ;
    rdfs:label "mette in guardia sull'uso di"@it, "cautions against the use of"@en, "cavet de usu"@la ;
    rdfs:comment "Il principio non vieta il protocollo: ne limita l'uso improprio, per esempio su singole persone."@it,
                 "The principle does not forbid the protocol: it limits improper use, for example on individuals."@en,
                 "Principium protocollum non vetat: usum improprium finit, velut de singulis personis."@la .
mtr:datatype a owl:ObjectProperty ; rdfs:domain mtr:ValueType ;
    rdfs:label "tipo di dato XML Schema"@it, "XML Schema datatype"@en, "genus dati XML Schema"@la .
mtr:first a owl:ObjectProperty ; rdfs:domain mtr:Comparison ; rdfs:range mtr:Observation ;
    rdfs:label "prima osservazione"@it, "first observation"@en, "observatio prior"@la .
mtr:second a owl:ObjectProperty ; rdfs:domain mtr:Comparison ; rdfs:range mtr:Observation ;
    rdfs:label "seconda osservazione"@it, "second observation"@en, "observatio posterior"@la .

# EN: Concept schemes for the controlled values.
# LA: Schemata notionum pro valoribus definitis.
mtr:protocolli a skos:ConceptScheme ; rdfs:label "Protocolli di misura"@it, "Measurement protocols"@en, "Protocolla mensurae"@la ;
    skos:prefLabel "Protocolli di misura"@it, "Measurement protocols"@en, "Protocolla mensurae"@la ;
    dcterms:source <https://coara.eu/agreement/the-agreement-full-text/> .
mtr:famiglie a skos:ConceptScheme ; rdfs:label "Famiglie di protocolli"@it, "Protocol families"@en, "Familiae protocollorum"@la ;
    skos:prefLabel "Famiglie di protocolli"@it, "Protocol families"@en, "Familiae protocollorum"@la .
mtr:ford a skos:ConceptScheme ; rdfs:label "Campi di ricerca e sviluppo (FORD)"@it, "Fields of research and development (FORD)"@en, "Campi investigationis (FORD)"@la ;
    skos:prefLabel "Campi di ricerca e sviluppo (FORD)"@it, "Fields of research and development (FORD)"@en, "Campi investigationis (FORD)"@la ;
    dcterms:source <https://doi.org/10.1787/9789264239012-en> .
mtr:valori a skos:ConceptScheme ; rdfs:label "Ambiti, tipi, coperture e stati"@it, "Scopes, types, coverages and states"@en, "Ambitus, genera, ambitus corporis et status"@la ;
    skos:prefLabel "Ambiti, tipi, coperture e stati"@it, "Scopes, types, coverages and states"@en, "Ambitus, genera, ambitus corporis et status"@la .

# EN: Families.
# LA: Familiae.
mtr:fam-ricezione a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "ricezione" ;
    skos:prefLabel "Ricezione"@it, "Reception"@en, "Receptio"@la ;
    rdfs:label "Ricezione"@it, "Reception"@en, "Receptio"@la ;
    skos:definition "Citazioni e riusi che una fonte attribuisce a un'opera o a un soggetto."@it, "Citations and reuses that a source attributes to a work or an agent."@en, "Citationes et usus iterati quos fons operi vel subiecto tribuit."@la .
mtr:fam-sedi a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "sedi" ;
    skos:prefLabel "Sedi di pubblicazione"@it, "Publication venues"@en, "Sedes editionis"@la ;
    rdfs:label "Sedi di pubblicazione"@it, "Publication venues"@en, "Sedes editionis"@la ;
    skos:definition "Indicatori calcolati sulle riviste e sulle collane, non sui singoli lavori."@it, "Indicators computed on journals and series, not on single works."@en, "Indices de periodicis et seriebus computati, non de singulis operibus."@la .
mtr:fam-apertura a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "apertura" ;
    skos:prefLabel "Apertura e accesso"@it, "Openness and access"@en, "Apertura et aditus"@la ;
    rdfs:label "Apertura e accesso"@it, "Openness and access"@en, "Apertura et aditus"@la ;
    skos:definition "Quote e controlli su accesso aperto, metadati, identificatori e materiali."@it, "Shares and checks on open access, metadata, identifiers and materials."@en, "Partes et probationes de aditu aperto, notis datorum, indicibus et instrumentis."@la .
mtr:fam-trasferimento a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "trasferimento" ;
    skos:prefLabel "Trasferimento"@it, "Transfer"@en, "Translatio"@la ;
    rdfs:label "Trasferimento"@it, "Transfer"@en, "Translatio"@la ;
    skos:definition "Riscontri dell'uso della ricerca fuori dall'accademia: policy, brevetti, adozioni."@it, "Evidence of research use outside academia: policy, patents, adoptions."@en, "Testimonia usus investigationis extra academiam: acta publica, diplomata, usus."@la .
mtr:fam-dati a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "dati" ;
    skos:prefLabel "Dati"@it, "Data"@en, "Data"@la ;
    rdfs:label "Dati"@it, "Data"@en, "Data"@la ;
    skos:definition "Citazioni, riusi e contesto dei dati di ricerca."@it, "Citations, reuses and context of research data."@en, "Citationes, usus iterati et contextus datorum investigationis."@la .
mtr:fam-software a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "software" ;
    skos:prefLabel "Software"@it, "Software"@en, "Programmata"@la ;
    rdfs:label "Software"@it, "Software"@en, "Programmata"@la ;
    skos:definition "Citazioni, riusi e riproducibilità del software di ricerca."@it, "Citations, reuses and reproducibility of research software."@en, "Citationes, usus iterati et reproductio programmatum investigationis."@la .
mtr:fam-metodo a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "metodo" ;
    skos:prefLabel "Metodo"@it, "Method"@en, "Methodus"@la ;
    rdfs:label "Metodo"@it, "Method"@en, "Methodus"@la ;
    skos:definition "Repliche, preregistrazioni e descrizione dei contributi."@it, "Replications, preregistrations and contribution descriptions."@en, "Replicationes, praescriptiones et descriptio conlationum."@la .
mtr:fam-umanistica a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "umanistica" ;
    skos:prefLabel "Saperi umanistici"@it, "Humanities"@en, "Studia humanitatis"@la ;
    rdfs:label "Saperi umanistici"@it, "Humanities"@en, "Studia humanitatis"@la ;
    skos:definition "Monografie, edizioni critiche, traduzioni e ricezione argomentativa."@it, "Monographs, critical editions, translations and argumentative reception."@en, "Monographiae, editiones criticae, versiones et receptio argumentorum."@la .
mtr:fam-sociale a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "sociale" ;
    skos:prefLabel "Ricerca sociale"@it, "Social research"@en, "Investigatio socialis"@la ;
    rdfs:label "Ricerca sociale"@it, "Social research"@en, "Investigatio socialis"@la ;
    skos:definition "Adozioni didattiche e riscontri territoriali."@it, "Teaching adoptions and territorial evidence."@en, "Usus didactici et testimonia in communitate."@la .
mtr:fam-clinica a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "clinica" ;
    skos:prefLabel "Ricerca clinica"@it, "Clinical research"@en, "Investigatio clinica"@la ;
    rdfs:label "Ricerca clinica"@it, "Clinical research"@en, "Investigatio clinica"@la ;
    skos:definition "Recepimento in linee guida e trasferimento clinico."@it, "Uptake in guidelines and clinical transfer."@en, "Receptio in praeceptis clinicis et translatio clinica."@la .
mtr:fam-tecnica a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "tecnica" ;
    skos:prefLabel "Tecnica"@it, "Engineering"@en, "Ars technica"@la ;
    rdfs:label "Tecnica"@it, "Engineering"@en, "Ars technica"@la ;
    skos:definition "Verifiche in ambiente operativo e licenze d'uso."@it, "Operational verification and licences of use."@en, "Probationes in ambitu operandi et licentiae usus."@la .
mtr:fam-agraria a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "agraria" ;
    skos:prefLabel "Agraria"@it, "Agricultural research"@en, "Res agraria"@la ;
    rdfs:label "Agraria"@it, "Agricultural research"@en, "Res agraria"@la ;
    skos:definition "Validazioni in campo e trasferimenti veterinari."@it, "Field validations and veterinary transfer."@en, "Probationes in agro et translationes veterinariae."@la .
mtr:fam-arti a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "arti" ;
    skos:prefLabel "Arti"@it, "Arts"@en, "Artes"@la ;
    rdfs:label "Arti"@it, "Arts"@en, "Artes"@la ;
    skos:definition "Esposizioni, esecuzioni e valutazioni curatoriali documentate."@it, "Documented exhibitions, performances and curatorial assessments."@en, "Exhibitiones, actiones et iudicia curatorialia documentata."@la .
mtr:fam-intervento a mtr:Family ; skos:inScheme mtr:famiglie ; skos:topConceptOf mtr:famiglie ; skos:notation "intervento" ;
    skos:prefLabel "Interventi"@it, "Interventions"@en, "Interventus"@la ;
    rdfs:label "Interventi"@it, "Interventions"@en, "Interventus"@la ;
    skos:definition "Esiti documentati di un intervento editoriale o bibliografico."@it, "Documented outcomes of an editorial or bibliographic intervention."@en, "Exitus documentati interventus editorii vel bibliographici."@la .

# EN: Scopes, value types, coverages and result states.
# LA: Ambitus, genera valorum, ambitus corporis et status exitus.
mtr:scope-output a mtr:Scope ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "output" ; skos:prefLabel "Prodotto della ricerca"@it, "Research output"@en, "Fructus investigationis"@la ; rdfs:label "Prodotto della ricerca"@it, "Research output"@en, "Fructus investigationis"@la .
mtr:scope-work a mtr:Scope ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "work" ; skos:prefLabel "Opera o edizione"@it, "Work or edition"@en, "Opus vel editio"@la ; rdfs:label "Opera o edizione"@it, "Work or edition"@en, "Opus vel editio"@la .
mtr:scope-venue a mtr:Scope ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "venue" ; skos:prefLabel "Sede di pubblicazione"@it, "Publication venue"@en, "Sedes editionis"@la ; rdfs:label "Sede di pubblicazione"@it, "Publication venue"@en, "Sedes editionis"@la .
mtr:scope-agent a mtr:Scope ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "agent" ; skos:prefLabel "Persona o organizzazione"@it, "Person or organisation"@en, "Persona vel institutio"@la ; rdfs:label "Persona o organizzazione"@it, "Person or organisation"@en, "Persona vel institutio"@la .
mtr:scope-researcher a mtr:Scope ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "researcher" ; skos:prefLabel "Ricercatrice o ricercatore"@it, "Researcher"@en, "Investigator"@la ; rdfs:label "Ricercatrice o ricercatore"@it, "Researcher"@en, "Investigator"@la .
mtr:scope-data a mtr:Scope ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "data" ; skos:prefLabel "Dati di ricerca"@it, "Research data"@en, "Data investigationis"@la ; rdfs:label "Dati di ricerca"@it, "Research data"@en, "Data investigationis"@la .
mtr:scope-software a mtr:Scope ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "software" ; skos:prefLabel "Software di ricerca"@it, "Research software"@en, "Programmata investigationis"@la ; rdfs:label "Software di ricerca"@it, "Research software"@en, "Programmata investigationis"@la .
mtr:scope-artifact a mtr:Scope ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "artifact" ; skos:prefLabel "Artefatto o esecuzione"@it, "Artefact or performance"@en, "Artefactum vel actio"@la ; rdfs:label "Artefatto o esecuzione"@it, "Artefact or performance"@en, "Artefactum vel actio"@la .
mtr:scope-intervention a mtr:Scope ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "intervention" ; skos:prefLabel "Intervento documentabile"@it, "Documentable intervention"@en, "Interventus documentabilis"@la ; rdfs:label "Intervento documentabile"@it, "Documentable intervention"@en, "Interventus documentabilis"@la .
mtr:type-count a mtr:ValueType ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "count" ; mtr:datatype xsd:integer ; skos:prefLabel "Conteggio intero"@it, "Integer count"@en, "Numerus integer"@la ; rdfs:label "Conteggio intero"@it, "Integer count"@en, "Numerus integer"@la .
mtr:type-decimal a mtr:ValueType ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "decimal" ; mtr:datatype xsd:decimal ; skos:prefLabel "Decimale non negativo"@it, "Non-negative decimal"@en, "Decimalis non negativus"@la ; rdfs:label "Decimale non negativo"@it, "Non-negative decimal"@en, "Decimalis non negativus"@la .
mtr:type-signed a mtr:ValueType ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "signed" ; mtr:datatype xsd:decimal ; skos:prefLabel "Decimale con segno"@it, "Signed decimal"@en, "Decimalis cum signo"@la ; rdfs:label "Decimale con segno"@it, "Signed decimal"@en, "Decimalis cum signo"@la .
mtr:type-percentage a mtr:ValueType ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "percentage" ; mtr:datatype xsd:decimal ; skos:prefLabel "Percentuale riportata dalla fonte"@it, "Percentage reported by the source"@en, "Pars centesima a fonte relata"@la ; rdfs:label "Percentuale riportata dalla fonte"@it, "Percentage reported by the source"@en, "Pars centesima a fonte relata"@la .
mtr:type-share a mtr:ValueType ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "share" ; mtr:datatype xsd:decimal ; skos:prefLabel "Quota calcolata da numeratore e denominatore"@it, "Share computed from numerator and denominator"@en, "Pars e numeratore et denominatore computata"@la ; rdfs:label "Quota calcolata da numeratore e denominatore"@it, "Share computed from numerator and denominator"@en, "Pars e numeratore et denominatore computata"@la .
mtr:type-text a mtr:ValueType ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "text" ; mtr:datatype xsd:string ; skos:prefLabel "Riscontro qualitativo"@it, "Qualitative evidence"@en, "Testimonium qualitativum"@la ; rdfs:label "Riscontro qualitativo"@it, "Qualitative evidence"@en, "Testimonium qualitativum"@la .
mtr:coverage-complete a mtr:Coverage ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "complete" ; skos:prefLabel "Copertura completa"@it, "Complete coverage"@en, "Ambitus integer"@la ; rdfs:label "Copertura completa"@it, "Complete coverage"@en, "Ambitus integer"@la ; skos:definition "Il corpus dichiarato è stato esaminato per intero."@it, "The declared corpus was examined in full."@en, "Corpus declaratum integrum examinatum est."@la .
mtr:coverage-partial a mtr:Coverage ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "partial" ; skos:prefLabel "Copertura parziale"@it, "Partial coverage"@en, "Ambitus partialis"@la ; rdfs:label "Copertura parziale"@it, "Partial coverage"@en, "Ambitus partialis"@la ; skos:definition "Una parte dichiarata del corpus è stata esaminata; la nota spiega quale."@it, "A declared part of the corpus was examined; the note explains which."@en, "Pars declarata corporis examinata est; adnotatio quae pars sit explicat."@la .
mtr:coverage-unknown a mtr:Coverage ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "unknown" ; skos:prefLabel "Copertura ignota"@it, "Unknown coverage"@en, "Ambitus ignotus"@la ; rdfs:label "Copertura ignota"@it, "Unknown coverage"@en, "Ambitus ignotus"@la ; skos:definition "La fonte non dichiara la copertura; il confronto non è ammesso."@it, "The source does not declare coverage; comparison is not allowed."@en, "Fons ambitum non declarat; comparatio non admittitur."@la .
mtr:state-observed a mtr:ResultState ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "observed" ; skos:prefLabel "Osservato"@it, "Observed"@en, "Observatum"@la ; rdfs:label "Osservato"@it, "Observed"@en, "Observatum"@la ; skos:definition "Il valore è stato rilevato e riportato."@it, "The value was observed and reported."@en, "Valor observatus et relatus est."@la .
mtr:state-missing a mtr:ResultState ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "missing" ; skos:prefLabel "Dato assente"@it, "Missing"@en, "Datum absens"@la ; rdfs:label "Dato assente"@it, "Missing"@en, "Datum absens"@la ; skos:definition "La fonte non fornisce il dato; l'assenza non vale zero."@it, "The source provides no value; absence is not zero."@en, "Fons datum non praebet; absentia non est nihil."@la .
mtr:state-suppressed a mtr:ResultState ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "suppressed" ; skos:prefLabel "Dato soppresso"@it, "Suppressed"@en, "Datum suppressum"@la ; rdfs:label "Dato soppresso"@it, "Suppressed"@en, "Datum suppressum"@la ; skos:definition "Il dato esiste ma non viene esposto, per diritti o riservatezza."@it, "The value exists but is not exposed, for rights or confidentiality."@en, "Datum exstat sed non exhibetur, propter iura vel secretum."@la .
mtr:state-not-applicable a mtr:ResultState ; skos:inScheme mtr:valori ; skos:topConceptOf mtr:valori ; skos:notation "not-applicable" ; skos:prefLabel "Non applicabile"@it, "Not applicable"@en, "Non applicabile"@la ; rdfs:label "Non applicabile"@it, "Not applicable"@en, "Non applicabile"@la ; skos:definition "Il protocollo non si applica al soggetto."@it, "The protocol does not apply to the subject."@en, "Protocollum ad subiectum non pertinet."@la .

# EN: Principles. Each is a paraphrase with its source; the source holds the authoritative wording.
# LA: Principia. Quodque paraphrasis est cum fonte; fons verba auctoritate praedita servat.
mtr:principle-dora a mtr:Principle ; dcterms:source <https://sfdora.org/read/> ; skos:notation "DORA" ;
    rdfs:label "Non usare metriche di rivista per valutare singoli articoli o persone"@it, "Do not use journal-based metrics to assess single articles or individuals"@en, "Ne indicibus periodicorum ad singulos articulos vel personas aestimandas utaris"@la .
mtr:principle-leiden-1 a mtr:Principle ; dcterms:source <https://www.nature.com/articles/520429a> ; skos:notation "Manifesto di Leiden 1" ;
    rdfs:label "La valutazione quantitativa sostiene il giudizio qualitativo degli esperti"@it, "Quantitative evaluation should support qualitative, expert assessment"@en, "Aestimatio quantitativa iudicium qualitativum peritorum sustineat"@la .
mtr:principle-leiden-2 a mtr:Principle ; dcterms:source <https://www.nature.com/articles/520429a> ; skos:notation "Manifesto di Leiden 2" ;
    rdfs:label "Misurare rispetto alle missioni di ricerca dell'istituzione, del gruppo o della persona"@it, "Measure performance against the research missions of the institution, group or researcher"@en, "Opus ad missiones investigationis institutionis, coetus vel personae metire"@la .
mtr:principle-leiden-3 a mtr:Principle ; dcterms:source <https://www.nature.com/articles/520429a> ; skos:notation "Manifesto di Leiden 3" ;
    rdfs:label "Proteggere l'eccellenza nella ricerca di rilevanza locale"@it, "Protect excellence in locally relevant research"@en, "Excellentiam investigationis localiter pertinentis tuere"@la .
mtr:principle-leiden-4 a mtr:Principle ; dcterms:source <https://www.nature.com/articles/520429a> ; skos:notation "Manifesto di Leiden 4" ;
    rdfs:label "Tenere aperti, trasparenti e semplici raccolta dei dati e analisi"@it, "Keep data collection and analytical processes open, transparent and simple"@en, "Collectionem datorum et analysin apertas, perspicuas et simplices serva"@la .
mtr:principle-leiden-5 a mtr:Principle ; dcterms:source <https://www.nature.com/articles/520429a> ; skos:notation "Manifesto di Leiden 5" ;
    rdfs:label "Permettere a chi è valutato di verificare dati e analisi"@it, "Allow those evaluated to verify data and analysis"@en, "Aestimatis data et analysin probare sine"@la .
mtr:principle-leiden-6 a mtr:Principle ; dcterms:source <https://www.nature.com/articles/520429a> ; skos:notation "Manifesto di Leiden 6" ;
    rdfs:label "Tenere conto delle differenze fra campi nelle pratiche di pubblicazione e citazione"@it, "Account for variation by field in publication and citation practices"@en, "Varietatem disciplinarum in usu edendi et citandi respice"@la .
mtr:principle-leiden-7 a mtr:Principle ; dcterms:source <https://www.nature.com/articles/520429a> ; skos:notation "Manifesto di Leiden 7" ;
    rdfs:label "Valutare le singole persone con un giudizio qualitativo del loro portafoglio"@it, "Base assessment of individual researchers on a qualitative judgement of their portfolio"@en, "Singulos investigatores iudicio qualitativo operum suorum aestima"@la .
mtr:principle-leiden-8 a mtr:Principle ; dcterms:source <https://www.nature.com/articles/520429a> ; skos:notation "Manifesto di Leiden 8" ;
    rdfs:label "Evitare la concretezza fuori luogo e la falsa precisione"@it, "Avoid misplaced concreteness and false precision"@en, "Concretionem alienam et falsam subtilitatem vita"@la .
mtr:principle-leiden-9 a mtr:Principle ; dcterms:source <https://www.nature.com/articles/520429a> ; skos:notation "Manifesto di Leiden 9" ;
    rdfs:label "Riconoscere gli effetti sistemici della valutazione e degli indicatori"@it, "Recognise the systemic effects of assessment and indicators"@en, "Effectus systematicos aestimationis et indicum agnosce"@la .
mtr:principle-leiden-10 a mtr:Principle ; dcterms:source <https://www.nature.com/articles/520429a> ; skos:notation "Manifesto di Leiden 10" ;
    rdfs:label "Esaminare regolarmente gli indicatori e aggiornarli"@it, "Scrutinise indicators regularly and update them"@en, "Indices identidem examina et renova"@la .
mtr:principle-coara-1 a mtr:Principle ; dcterms:source <https://coara.eu/agreement/the-agreement-full-text/> ; skos:notation "CoARA, impegno 1" ;
    rdfs:label "Riconoscere la diversità dei contributi e delle carriere nella ricerca"@it, "Recognise the diversity of contributions to, and careers in, research"@en, "Varietatem conlationum et cursuum in investigatione agnosce"@la .
mtr:principle-coara-2 a mtr:Principle ; dcterms:source <https://coara.eu/agreement/the-agreement-full-text/> ; skos:notation "CoARA, impegno 2" ;
    rdfs:label "Fondare la valutazione sul giudizio qualitativo e sulla revisione fra pari, con indicatori usati responsabilmente"@it, "Base assessment primarily on qualitative evaluation with peer review, supported by responsible use of indicators"@en, "Aestimationem in iudicio qualitativo et recensione parium funda, indicibus responsabiliter adhibitis"@la .
mtr:principle-coara-3 a mtr:Principle ; dcterms:source <https://coara.eu/agreement/the-agreement-full-text/> ; skos:notation "CoARA, impegno 3" ;
    rdfs:label "Abbandonare gli usi impropri delle metriche di rivista e di pubblicazione, come fattore d'impatto e indice h"@it, "Abandon inappropriate uses of journal- and publication-based metrics, such as the Journal Impact Factor and the h-index"@en, "Usus improprios indicum periodicorum et editionum, velut JIF et index h, relinque"@la .
mtr:principle-coara-4 a mtr:Principle ; dcterms:source <https://coara.eu/agreement/the-agreement-full-text/> ; skos:notation "CoARA, impegno 4" ;
    rdfs:label "Evitare l'uso delle classifiche delle organizzazioni di ricerca nella valutazione"@it, "Avoid the use of rankings of research organisations in research assessment"@en, "Ordines institutionum investigationis in aestimatione ne adhibeas"@la .
mtr:principle-fair-f a mtr:Principle ; dcterms:source <https://doi.org/10.1038/sdata.2016.18> ; skos:notation "FAIR F" ;
    rdfs:label "Reperibile: identificatori persistenti e metadati ricchi"@it, "Findable: persistent identifiers and rich metadata"@en, "Reperibile: indices persistentes et notae copiosae"@la .
mtr:principle-fair-a a mtr:Principle ; dcterms:source <https://doi.org/10.1038/sdata.2016.18> ; skos:notation "FAIR A" ;
    rdfs:label "Accessibile: protocolli aperti e metadati che restano anche senza i dati"@it, "Accessible: open protocols and metadata that outlive the data"@en, "Accessibile: protocolla aperta et notae quae data superstant"@la .
mtr:principle-fair-i a mtr:Principle ; dcterms:source <https://doi.org/10.1038/sdata.2016.18> ; skos:notation "FAIR I" ;
    rdfs:label "Interoperabile: vocabolari formali e condivisi"@it, "Interoperable: formal, shared vocabularies"@en, "Interoperabile: lexica formalia et communia"@la .
mtr:principle-fair-r a mtr:Principle ; dcterms:source <https://doi.org/10.1038/sdata.2016.18> ; skos:notation "FAIR R" ;
    rdfs:label "Riusabile: licenza chiara, provenienza dettagliata, standard di comunità"@it, "Reusable: clear licence, detailed provenance, community standards"@en, "Iterum usurpabile: licentia perspicua, origo accurata, normae communitatis"@la .
mtr:principle-force11-1 a mtr:Principle ; dcterms:source <https://force11.org/info/joint-declaration-of-data-citation-principles-final/> ; skos:notation "FORCE11 1" ;
    rdfs:label "Importanza: i dati sono prodotti di ricerca legittimi e citabili"@it, "Importance: data are legitimate, citable products of research"@en, "Momentum: data sunt fructus investigationis legitimi et citabiles"@la .
mtr:principle-force11-2 a mtr:Principle ; dcterms:source <https://force11.org/info/joint-declaration-of-data-citation-principles-final/> ; skos:notation "FORCE11 2" ;
    rdfs:label "Credito e attribuzione a chi ha contribuito ai dati"@it, "Credit and attribution to all contributors to the data"@en, "Laus et attributio omnibus qui data contulerunt"@la .
mtr:principle-force11-3 a mtr:Principle ; dcterms:source <https://force11.org/info/joint-declaration-of-data-citation-principles-final/> ; skos:notation "FORCE11 3" ;
    rdfs:label "Evidenza: citare i dati su cui si fonda un'affermazione"@it, "Evidence: cite the data on which a claim relies"@en, "Testimonium: data cita quibus affirmatio nititur"@la .
mtr:principle-force11-4 a mtr:Principle ; dcterms:source <https://force11.org/info/joint-declaration-of-data-citation-principles-final/> ; skos:notation "FORCE11 4" ;
    rdfs:label "Identificazione univoca e persistente"@it, "Unique and persistent identification"@en, "Designatio singularis et persistens"@la .
mtr:principle-force11-5 a mtr:Principle ; dcterms:source <https://force11.org/info/joint-declaration-of-data-citation-principles-final/> ; skos:notation "FORCE11 5" ;
    rdfs:label "Accesso ai dati e ai metadati citati"@it, "Access to the cited data and metadata"@en, "Aditus ad data et notas citata"@la .
mtr:principle-force11-6 a mtr:Principle ; dcterms:source <https://force11.org/info/joint-declaration-of-data-citation-principles-final/> ; skos:notation "FORCE11 6" ;
    rdfs:label "Persistenza degli identificatori e dei metadati oltre la vita dei dati"@it, "Persistence of identifiers and metadata beyond the data's lifespan"@en, "Persistentia indicum et notarum ultra vitam datorum"@la .
mtr:principle-force11-7 a mtr:Principle ; dcterms:source <https://force11.org/info/joint-declaration-of-data-citation-principles-final/> ; skos:notation "FORCE11 7" ;
    rdfs:label "Specificità e verificabilità della porzione citata"@it, "Specificity and verifiability of the cited portion"@en, "Proprietas et probabilitas partis citatae"@la .
mtr:principle-force11-8 a mtr:Principle ; dcterms:source <https://force11.org/info/joint-declaration-of-data-citation-principles-final/> ; skos:notation "FORCE11 8" ;
    rdfs:label "Interoperabilità e flessibilità fra comunità"@it, "Interoperability and flexibility across communities"@en, "Interoperabilitas et flexibilitas inter communitates"@la .
mtr:principle-software-1 a mtr:Principle ; dcterms:source <https://doi.org/10.7717/peerj-cs.86> ; skos:notation "Citazione del software 1" ;
    rdfs:label "Importanza: il software è un prodotto di ricerca citabile"@it, "Importance: software is a citable research product"@en, "Momentum: programma est fructus investigationis citabilis"@la .
mtr:principle-software-2 a mtr:Principle ; dcterms:source <https://doi.org/10.7717/peerj-cs.86> ; skos:notation "Citazione del software 2" ;
    rdfs:label "Credito e attribuzione a chi lo ha sviluppato"@it, "Credit and attribution to its developers"@en, "Laus et attributio iis qui programma fecerunt"@la .
mtr:principle-software-3 a mtr:Principle ; dcterms:source <https://doi.org/10.7717/peerj-cs.86> ; skos:notation "Citazione del software 3" ;
    rdfs:label "Identificazione univoca e leggibile dalle macchine"@it, "Unique, machine-actionable identification"@en, "Designatio singularis et machinis legibilis"@la .
mtr:principle-software-4 a mtr:Principle ; dcterms:source <https://doi.org/10.7717/peerj-cs.86> ; skos:notation "Citazione del software 4" ;
    rdfs:label "Persistenza di identificatori e metadati"@it, "Persistence of identifiers and metadata"@en, "Persistentia indicum et notarum"@la .
mtr:principle-software-5 a mtr:Principle ; dcterms:source <https://doi.org/10.7717/peerj-cs.86> ; skos:notation "Citazione del software 5" ;
    rdfs:label "Accessibilità del software e dei metadati"@it, "Accessibility of software and metadata"@en, "Aditus ad programma et notas"@la .
mtr:principle-software-6 a mtr:Principle ; dcterms:source <https://doi.org/10.7717/peerj-cs.86> ; skos:notation "Citazione del software 6" ;
    rdfs:label "Specificità della versione citata"@it, "Specificity of the cited version"@en, "Proprietas versionis citatae"@la .
mtr:principle-credit a mtr:Principle ; dcterms:source <https://credit.niso.org/> ; skos:notation "CRediT" ;
    rdfs:label "Descrivere i contributi con quattordici ruoli, distinti dall'ordine degli autori"@it, "Describe contributions with fourteen roles, distinct from author order"@en, "Conlationes quattuordecim muneribus describe, ab ordine auctorum distinctis"@la .
mtr:principle-prereg a mtr:Principle ; dcterms:source <https://www.cos.io/initiatives/prereg> ; skos:notation "Preregistrazione" ;
    rdfs:label "Dichiarare ipotesi e metodo prima di raccogliere i dati"@it, "Declare hypotheses and method before collecting data"@en, "Hypotheses et methodum ante data collecta declara"@la .
mtr:principle-dora mtr:cautions mtr:p-jif, mtr:p-citescore, mtr:p-snip, mtr:p-sjr, mtr:p-jci, mtr:p-eigenfactor, mtr:p-article-influence .
mtr:principle-coara-3 mtr:cautions mtr:p-jif, mtr:p-h-index, mtr:p-g-index, mtr:p-i10-index, mtr:p-m-index .
mtr:principle-leiden-8 mtr:cautions mtr:p-altmetric, mtr:p-percentile .

# EN: FORD fields of the Frascati Manual 2015, with the labels used by the Cripta.
# LA: Disciplinae FORD Manualis Frascati 2015, cum titulis a Crypta adhibitis.
mtr:ford-1 a mtr:Discipline ; skos:inScheme mtr:ford ; skos:notation "1" ; skos:topConceptOf mtr:ford ;
