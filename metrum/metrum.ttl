    mtr:method "Deduplica le opere secondo gli identificatori e le regole dichiarate."@it, "Deduplicate the citing works according to the declared identifiers and rules."@en, "Opera citantia secundum indices et regulas declaratas deduplica."@la ;
    mtr:requiresReferenceSet false ;
    dcterms:source <https://sfdora.org/read/> ;
    mtr:guidedBy mtr:principle-dora .
