    mtr:requiresReferenceSet true ;
    dcterms:source <https://www.nature.com/articles/520429a> ;
    mtr:guidedBy mtr:principle-leiden-1, mtr:principle-leiden-2, mtr:principle-leiden-3, mtr:principle-leiden-4, mtr:principle-leiden-5, mtr:principle-leiden-6, mtr:principle-leiden-7, mtr:principle-leiden-8, mtr:principle-leiden-9, mtr:principle-leiden-10 .
