    {
      "@id": "mtr:Observation",
      "@type": "owl:Class",
      "rdfs:comment": [
        {
          "@language": "it",
          "@value": "Una sola applicazione di un protocollo a un soggetto, in un corpus e in un periodo dichiarati, con copertura, stato del risultato e fonte."
        },
        {
          "@language": "en",
          "@value": "One application of a protocol to a subject, within a declared corpus and period, with coverage, result state and source."
        },
        {
          "@language": "la",
          "@value": "Una adhibitio protocolli ad subiectum, in corpore et tempore declaratis, cum ambitu, statu exitus et fonte."
        }
      ],
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "osservazione qualificata"
        },
        {
          "@language": "en",
          "@value": "qualified observation"
        },
        {
          "@language": "la",
          "@value": "observatio qualificata"
        }
      ],
      "rdfs:subClassOf": [
