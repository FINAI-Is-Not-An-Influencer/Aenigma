    {
      "@id": "mtr:p-citazioni-senza-auto",
      "@type": "mtr:Protocol",
      "dcterms:source": {
        "@id": "https://www.nature.com/articles/520429a"
      },
      "mtr:family": {
        "@id": "mtr:fam-ricezione"
      },
      "mtr:guidedBy": [
        {
          "@id": "mtr:principle-leiden-1"
        },
        {
          "@id": "mtr:principle-leiden-2"
        },
        {
          "@id": "mtr:principle-leiden-3"
        },
        {
          "@id": "mtr:principle-leiden-4"
        },
        {
          "@id": "mtr:principle-leiden-5"
        },
        {
          "@id": "mtr:principle-leiden-6"
        },
        {
          "@id": "mtr:principle-leiden-7"
        },
        {
          "@id": "mtr:principle-leiden-8"
        },
        {
          "@id": "mtr:principle-leiden-9"
        },
        {
          "@id": "mtr:principle-leiden-10"
        }
      ],
      "mtr:method": [
        {
          "@language": "it",
          "@value": "Dichiara chi conta come autocitante e come hai disambiguato gli autori."
        },
        {
          "@language": "en",
          "@value": "Exclude self-citations according to the declared rule of authorship."
        },
        {
          "@language": "la",
          "@value": "Autocitationes secundum regulam auctoritatis declaratam exclude."
        }
      ],
      "mtr:requiresReferenceSet": false,
      "mtr:scope": {
        "@id": "mtr:scope-work"
      },
      "mtr:unit": [
        {
          "@language": "it",
          "@value": "citazioni"
        },
        {
          "@language": "en",
          "@value": "citations"
        },
        {
          "@language": "la",
          "@value": "citationes"
        }
      ],
      "mtr:valueType": {
        "@id": "mtr:type-count"
      },
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "Citazioni esclusa l’autocitazione"
        },
        {
          "@language": "en",
          "@value": "Citations excluding self-citations"
        },
        {
          "@language": "la",
          "@value": "Citationes sine autocitationibus"
        }
      ],
      "skos:inScheme": {
        "@id": "mtr:protocolli"
      },
      "skos:notation": "citazioni-senza-auto",
      "skos:prefLabel": [
        {
          "@language": "it",
          "@value": "Citazioni esclusa l’autocitazione"
        },
        {
          "@language": "en",
          "@value": "Citations excluding self-citations"
        },
        {
          "@language": "la",
          "@value": "Citationes sine autocitationibus"
        }
      ],
      "skos:topConceptOf": {
        "@id": "mtr:protocolli"
      }
    },
