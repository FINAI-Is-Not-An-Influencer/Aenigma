    {
      "@id": "mtr:Comparison",
      "@type": "owl:Class",
      "rdfs:comment": [
        {
          "@language": "it",
          "@value": "Due osservazioni dello stesso soggetto sono confrontabili solo con lo stesso protocollo, la stessa unità, le stesse discipline, lo stesso periodo, lo stesso corpus e copertura dichiarata. La variazione è descrittiva."
        },
        {
          "@language": "en",
          "@value": "Two observations of the same subject are comparable only with the same protocol, unit, fields, period, corpus and declared coverage. The variation is descriptive."
        },
        {
          "@language": "la",
          "@value": "Duae observationes eiusdem subiecti comparari possunt solum eodem protocollo, eadem unitate, iisdem disciplinis, eodem tempore, eodem corpore et ambitu declarato. Variatio descriptiva est."
        }
      ],
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "confronto fra osservazioni"
        },
        {
          "@language": "en",
          "@value": "comparison between observations"
        },
        {
          "@language": "la",
          "@value": "comparatio observationum"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
