    {
      "@id": "mtr:",
      "@type": "owl:Ontology",
      "dcterms:creator": [
        {
          "@id": "https://criptasemantica.it/chi-siamo/finai/"
        },
        {
          "@id": "https://criptasemantica.it/chi-siamo/alessandro-sevardi/"
        }
      ],
      "dcterms:description": [
        {
          "@language": "it",
          "@value": "Metrum rende dereferenziabile il vocabolario delle misure usato dal servizio semantico della Cripta: ogni protocollo, disciplina e principio ha un IRI pubblico, tre etichette e una fonte. Una misura è un ente del grafo, non un giudizio."
        },
        {
          "@language": "en",
          "@value": "Metrum makes the measurement vocabulary of the Cripta semantic service dereferenceable: every protocol, field and principle has a public IRI, three labels and a source. A measure is an entity of the graph, not a verdict."
        },
        {
          "@language": "la",
          "@value": "Metrum lexicon mensurarum a ministerio semantico Cryptae adhibitum reperibile reddit: quodque protocollum, disciplina et principium IRI publicum, tres titulos et fontem habet. Mensura est ens graphi, non iudicium."
        }
      ],
      "dcterms:isPartOf": {
        "@id": "https://aenigma.criptasemantica.it/aenigma#"
      },
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-11-11"
      },
      "dcterms:language": [
        "it",
        "en",
        "la"
      ],
      "dcterms:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-11-11"
      },
      "dcterms:publisher": {
        "@id": "https://criptasemantica.it/"
      },
      "dcterms:references": [
        {
          "@id": "dub:F08"
        },
        {
          "@id": "dub:F19"
        },
        {
          "@id": "dub:quantificazioneScrittura"
        },
        {
          "@id": "dub:quantificazioneOntologica"
        },
        {
          "@id": "dub:capitaleSemantico"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://doi.org/10.1787/9789264239012-en"
        },
        {
          "@id": "https://sfdora.org/read/"
        },
        {
          "@id": "https://www.nature.com/articles/520429a"
        },
        {
          "@id": "https://coara.eu/agreement/the-agreement-full-text/"
        }
      ],
      "dcterms:title": [
        {
          "@language": "it",
          "@value": "Metrum. La misura qualificata della ricerca"
        },
        {
          "@language": "en",
          "@value": "Metrum. Qualified measurement of research"
        },
        {
          "@language": "la",
          "@value": "Metrum. Mensura investigationis qualificata"
        }
      ],
      "owl:versionIRI": {
        "@id": "mtr:v0.1.0"
      },
      "owl:versionInfo": "0.1.0",
      "rdfs:comment": [
        {
          "@language": "it",
          "@value": "Terzo modulo di Aenigma. Osservazioni scientometriche con protocollo, corpus, periodo, copertura e fonte; discipline FORD; principi di valutazione responsabile; raccordo con la quantificazione della scrittura descritta nel manifesto."
        },
        {
          "@language": "en",
          "@value": "Third module of Aenigma. Scientometric observations with protocol, corpus, period, coverage and source; FORD fields; principles of responsible assessment; a bridge to the quantification of writing described in the manifesto."
        },
        {
          "@language": "la",
          "@value": "Tertia pars Aenigmatis. Observationes scientometricae cum protocollo, corpore, tempore, ambitu et fonte; disciplinae FORD; principia aestimationis responsabilis; nexus cum quantificatione scripturae in prooemio descripta."
        }
      ],
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "Metrum. La misura qualificata della ricerca"
        },
        {
          "@language": "en",
          "@value": "Metrum. Qualified measurement of research"
        },
        {
          "@language": "la",
          "@value": "Metrum. Mensura investigationis qualificata"
        }
      ],
      "rdfs:seeAlso": [
        {
          "@id": "https://github.com/FINAI-Is-Not-An-Influencer/Aenigma"
        },
        {
          "@id": "https://criptasemantica.it/chi-siamo/"
        }
      ],
      "vann:preferredNamespacePrefix": "mtr",
      "vann:preferredNamespaceUri": "https://aenigma.criptasemantica.it/metrum#"
    },
