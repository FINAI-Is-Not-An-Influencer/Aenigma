  "@graph": [
    {
      "@id": "mtr:principle-leiden-8",
      "@type": "mtr:Principle",
      "dcterms:source": {
        "@id": "https://www.nature.com/articles/520429a"
      },
      "mtr:cautions": [
        {
          "@id": "mtr:p-altmetric"
        },
        {
          "@id": "mtr:p-percentile"
        }
      ],
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "Evitare la concretezza fuori luogo e la falsa precisione"
        },
        {
          "@language": "en",
          "@value": "Avoid misplaced concreteness and false precision"
        },
        {
          "@language": "la",
          "@value": "Concretionem alienam et falsam subtilitatem vita"
        }
      ],
      "skos:notation": "Manifesto di Leiden 8"
    },
