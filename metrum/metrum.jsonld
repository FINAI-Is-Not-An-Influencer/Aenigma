    {
      "@id": "mtr:principle-force11-2",
      "@type": "mtr:Principle",
      "dcterms:source": {
        "@id": "https://force11.org/info/joint-declaration-of-data-citation-principles-final/"
      },
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "Credito e attribuzione a chi ha contribuito ai dati"
        },
        {
          "@language": "en",
          "@value": "Credit and attribution to all contributors to the data"
        },
        {
          "@language": "la",
          "@value": "Laus et attributio omnibus qui data contulerunt"
        }
      ],
      "skos:notation": "FORCE11 2"
    },
    {
      "@id": "mtr:editorialReading",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": [
        {
          "@language": "it",
          "@value": "La lettura è distinta dal dato: dice che cosa la redazione ne ricava, non che cosa la fonte ha misurato."
        },
        {
          "@language": "en",
          "@value": "The reading is distinct from the datum: it says what the editors draw from it, not what the source measured."
        },
        {
          "@language": "la",
          "@value": "Lectio a dato distinguitur: dicit quid editores inde colligant, non quid fons mensus sit."
        }
      ],
      "rdfs:domain": {
        "@id": "mtr:Observation"
      },
      "rdfs:label": [
        {
          "@language": "it",
          "@value": "lettura redazionale"
        },
        {
          "@language": "en",
          "@value": "editorial reading"
        },
        {
          "@language": "la",
          "@value": "lectio editoria"
        }
      ],
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
