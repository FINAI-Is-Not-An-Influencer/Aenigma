          "@value": "Ambitus ignotus"
        }
      ],
      "skos:definition": [
        {
          "@language": "it",
          "@value": "La fonte non dichiara la copertura; il confronto non è ammesso."
        },
        {
          "@language": "en",
          "@value": "The source does not declare coverage; comparison is not allowed."
        },
        {
          "@language": "la",
          "@value": "Fons ambitum non declarat; comparatio non admittitur."
        }
      ],
      "skos:inScheme": {
        "@id": "mtr:valori"
      },
      "skos:notation": "unknown",
      "skos:prefLabel": [
